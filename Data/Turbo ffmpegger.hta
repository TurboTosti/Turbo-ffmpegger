  var FRONT_MOUNTAIN_OUTER_MOTION=0.80;
  var FRONT_MOUNTAIN_MOTION_RAMP=2.6;
  var FRONT_MOUNTAIN_JITTER=2.1;
  var FRONT_MOUNTAIN_MID_BLEND=0.52;
  var FRONT_MOUNTAIN_MID_VARIATION=0.025;
  var FRONT_MOUNTAIN_MID_MOTION=0.18;
  var FRONT_MOUNTAIN_MID_HEIGHT=0.52;
  var FRONT_MOUNTAIN_FILL_LIGHT=0.025;
  var FRONT_MOUNTAIN_FILL_DARK=0.050;
  var FRONT_MOUNTAIN_OUTLINE_WIDTH=1.2;
  var FRONT_MOUNTAIN_HIGHLIGHT_THRESHOLD=0.68;
  var FRONT_MOUNTAIN_OUTLINE_LIGHT=0.37;
  var FRONT_MOUNTAIN_OUTLINE_DARK=0.56;
  var FRONT_MOUNTAIN_OUTLINE_DEPTH_BOOST=0.10;
  var FRONT_MOUNTAIN_RIDGE_LIGHT=0.22;
  var FRONT_MOUNTAIN_RIDGE_DARK=0.34;
  var FRONT_MOUNTAIN_RIDGE_DEPTH_BOOST=0.09;
  var FRONT_MOUNTAIN_FACET_LIGHT=0.19;
  var FRONT_MOUNTAIN_FACET_DARK=0.30;
  var FRONT_MOUNTAIN_FACET_DEPTH_BOOST=0.08;
  var FRONT_MOUNTAIN_DIAGONAL_ALPHA=0.72;
  var FRONT_MOUNTAIN_BASE_LIGHT=0.16;
  var FRONT_MOUNTAIN_BASE_DARK=0.25;
  var FRONT_MOUNTAIN_BASE_WIDTH=0.8;

  // ── Waves ──────────────────────────────────────────────────
  var WAVES_LAYER_COUNT=4;
  var WAVES_AMPLITUDE_START=26;
  var WAVES_AMPLITUDE_STEP=10;
  var WAVES_WAVELENGTH_START=260;
  var WAVES_WAVELENGTH_STEP=80;
  var WAVES_SPEED_MIN=0.00028;
  var WAVES_SPEED_RANGE=0.00085;
  var WAVES_REVERSE_CHANCE=0.35;
  var WAVES_Y_START=0.52;
  var WAVES_Y_STEP=0.13;
  var WAVES_X_STEP=18;
  var WAVES_ALPHA_LIGHT=0.13;
  var WAVES_ALPHA_DARK=0.10;

  // ── Magic particles ────────────────────────────────────────
  var MAGIC_PARTICLE_COUNT=50;
  var MAGIC_BIG_CHANCE=0.18;
  var MAGIC_RISE_SPEED_MIN=0.25;
  var MAGIC_RISE_SPEED_RANGE=0.55;
  var MAGIC_BIG_SPEED_BONUS=0.15;
  var MAGIC_SWAY_AMOUNT_MIN=8;
  var MAGIC_SWAY_AMOUNT_RANGE=12;
  var MAGIC_SWAY_SPEED_MIN=0.010;
  var MAGIC_SWAY_SPEED_RANGE=0.020;
  var MAGIC_TWINKLE_SPEED_MIN=0.030;
  var MAGIC_TWINKLE_SPEED_RANGE=0.050;
  var MAGIC_GLOW_BIG_MIN=26;
  var MAGIC_GLOW_BIG_RANGE=14;
  var MAGIC_GLOW_SMALL_MIN=12;
  var MAGIC_GLOW_SMALL_RANGE=10;
  var MAGIC_CORE_BIG=1.6;
  var MAGIC_CORE_SMALL=0.9;
  var MAGIC_CORE_RANGE=0.8;
  var MAGIC_SPRITE_SIZE=48;
  var MAGIC_GLOW_WHITE_ALPHA=0.95;
  var MAGIC_GLOW_MIDPOINT=0.28;
  var MAGIC_GLOW_COLOR_ALPHA=0.72;
  var MAGIC_RESET_MARGIN=20;
  var MAGIC_ALPHA_LIGHT=0.50;
  var MAGIC_ALPHA_DARK=0.85;
  var MAGIC_ALPHA_MIN=0.35;
  var MAGIC_ALPHA_RANGE=1.65;
  var MAGIC_TRAIL_LENGTH=40;             // visible history points per particle; 0 = no trail
  var MAGIC_TRAIL_RADIUS_MIN=0.35;
  var MAGIC_TRAIL_RADIUS_RANGE=1.70;
  var MAGIC_TRAIL_ALPHA=0.55;
  var MAGIC_SPRITE_SCALE_MIN=0.85;
  var MAGIC_SPRITE_SCALE_RANGE=0.30;
  var MAGIC_CORE_ALPHA=0.90;

  // ── Starfield / warp ──────────────────────────────────────
  var STARFIELD_Y_OFFSET=115;            // + = lower focal point
  var STARFIELD_STAR_COUNT=150;
  var STARFIELD_RADIUS_MIN=6;
  var STARFIELD_RADIUS_RANGE=20;
  var STARFIELD_SPEED_MIN=0.5;
  var STARFIELD_SPEED_RANGE=1.6;
  var STARFIELD_ACCENT_CHANCE=0.22;
  var STARFIELD_SIZE_MIN=0.6;
  var STARFIELD_SIZE_RANGE=1.5;
  var STARFIELD_ACCELERATION=0.010;
  var STARFIELD_ALPHA_BASE=0.15;
  var STARFIELD_ALPHA_LIGHT=0.70;
  var STARFIELD_ALPHA_DARK=0.90;
  var STARFIELD_LINE_MIN_WIDTH=0.5;
  var STARFIELD_LINE_WIDTH_SCALE=2.7;
  var STARFIELD_RESET_MARGIN=20;
  var STARFIELD_RESET_RADIUS_MIN=5;
  var STARFIELD_RESET_RADIUS_RANGE=18;

  // ── Aurora ─────────────────────────────────────────────────
  var AURORA_RIBBON_COUNT=4;
  var AURORA_Y_START=0.22;
  var AURORA_Y_STEP=0.17;
  var AURORA_AMPLITUDE_START=32;
  var AURORA_AMPLITUDE_STEP=8;
  var AURORA_WAVELENGTH_START=420;
  var AURORA_WAVELENGTH_STEP=90;
  var AURORA_SPEED_START=0.00035;
  var AURORA_SPEED_STEP=0.00007;
  var AURORA_THICKNESS_START=66;
  var AURORA_THICKNESS_STEP=14;
  var AURORA_X_STEP=22;
  var AURORA_BACK_PHASE=0.6;
  var AURORA_ALPHA_LIGHT=0.15;
  var AURORA_ALPHA_DARK=0.12;

  // Hand-authored low-poly mountain banks. 
  // Heights increase toward the outer edges, while the centre valley stays clear.
  var customMountainLeft={
    t:[0,0.07,0.15,0.24,0.34,0.44,0.55,0.66,0.77,0.87,0.94,1],
    h:[7,18,12,42,31,72,54,104,82,138,115,176],
    j:[0,1,-2,2,-1,3,-2,2,-3,2,-1,0]
  };
  var customMountainRight={
    t:[0,0.08,0.17,0.26,0.36,0.47,0.58,0.69,0.79,0.88,0.95,1],
    h:[6,14,25,20,53,39,80,64,116,92,150,188],
    j:[0,-1,2,-2,1,-3,2,-1,3,-2,1,0]
  };

  var pal=null, bgHex="#141414", bgRgb={r:20,g:20,b:20}, isLight=false;
  var st=null;                     // per-pattern particle state
  var domLayer=null, domDots=null; // fallback layer (no canvas)
  var colorVer=0;                  // bumps on theme change (invalidates sprites)

  function lum(c){ return (0.299*c.r + 0.587*c.g + 0.114*c.b)/255; }
  function palFrom(t){ var p=[t.ac, t.starOn||t.ac, t.ok||t.ac], o=[]; for(var i=0;i<p.length;i++) o.push(hexToRgb(p[i])); return o; }
  function rgba(c,a){ return "rgba("+c.r+","+c.g+","+c.b+","+a+")"; }
  function pick(i){ return pal[i % pal.length]; }
  function fillBg(){ ctx.globalAlpha=1; ctx.fillStyle=bgHex; ctx.fillRect(0,0,W,H); }

  function setColors(t){
    bgHex = t.bg || "#141414";
    bgRgb = hexToRgb(bgHex);
    isLight = lum(bgRgb) > 0.5;
    pal = palFrom(t);
    colorVer++;
    if (domDots) recolorDom();
  }

  // ── per-pattern init ──
  function initPattern(){
    st = {}; var i;
    if (pattern==="ambient") {
      st.o=[]; for(i=0;i<AMBIENT_ORB_COUNT;i++){ var sf=AMBIENT_SPEED_FACTOR_MIN+Math.random()*AMBIENT_SPEED_FACTOR_RANGE;   // per-orb speed factor
        st.o.push({x:Math.random()*W,y:Math.random()*H,r:AMBIENT_RADIUS_MIN+Math.random()*AMBIENT_RADIUS_RANGE,
          vx:(Math.random()-0.5)*AMBIENT_X_SPEED*sf,vy:(Math.random()-0.5)*AMBIENT_Y_SPEED*sf,
          ci:i,ph:Math.random()*6.283,sp:AMBIENT_PULSE_SPEED_MIN+Math.random()*AMBIENT_PULSE_SPEED_RANGE}); }
    } else if (pattern==="constellation") {
      var hz1=H*FUTURE_STAR_SPAWN_HORIZON_Y;
      // Time-based twinkle so stars pulse consistently regardless of frame rate.
      // A few larger stars get a tiny cross-flare at the top of their pulse.
      st.stars=[];
      for(i=0;i<FUTURE_STAR_COUNT;i++) st.stars.push({
        x:Math.random()*W,
        y:Math.random()*hz1*FUTURE_STAR_SKY_COVERAGE,
        ph:Math.random()*6.283,
        sp:FUTURE_STAR_SPEED_MIN+Math.random()*FUTURE_STAR_SPEED_RANGE,
        r:FUTURE_STAR_RADIUS_MIN+Math.random()*FUTURE_STAR_RADIUS_RANGE,
        flare:Math.random()<FUTURE_STAR_FLARE_CHANCE
      });
    } else if (pattern==="waves") {
      st.l=[]; for(i=0;i<WAVES_LAYER_COUNT;i++) st.l.push({amp:WAVES_AMPLITUDE_START+i*WAVES_AMPLITUDE_STEP,wl:WAVES_WAVELENGTH_START+i*WAVES_WAVELENGTH_STEP,sp:(WAVES_SPEED_MIN+Math.random()*WAVES_SPEED_RANGE)*(Math.random()<WAVES_REVERSE_CHANCE?-1:1),yb:H*(WAVES_Y_START+i*WAVES_Y_STEP),ci:i,ph:Math.random()*6.283});
    } else if (pattern==="magic") {
      st.p=[];
      for(i=0;i<MAGIC_PARTICLE_COUNT;i++){ var big=Math.random()<MAGIC_BIG_CHANCE;
        st.p.push({x:Math.random()*W,y:Math.random()*H,vy:MAGIC_RISE_SPEED_MIN+Math.random()*MAGIC_RISE_SPEED_RANGE+(big?MAGIC_BIG_SPEED_BONUS:0),
          amp:MAGIC_SWAY_AMOUNT_MIN+Math.random()*MAGIC_SWAY_AMOUNT_RANGE,sw:Math.random()*6.283,ss:MAGIC_SWAY_SPEED_MIN+Math.random()*MAGIC_SWAY_SPEED_RANGE,
          tw:Math.random()*6.283,tsp:MAGIC_TWINKLE_SPEED_MIN+Math.random()*MAGIC_TWINKLE_SPEED_RANGE,
          gs:(big?MAGIC_GLOW_BIG_MIN+Math.random()*MAGIC_GLOW_BIG_RANGE:MAGIC_GLOW_SMALL_MIN+Math.random()*MAGIC_GLOW_SMALL_RANGE),core:(big?MAGIC_CORE_BIG:MAGIC_CORE_SMALL)+Math.random()*MAGIC_CORE_RANGE,ci:i,trail:[]}); }
      st.spriteVer=-1;
    } else if (pattern==="starfield") {
      st.s=[]; for(i=0;i<STARFIELD_STAR_COUNT;i++) st.s.push({a:Math.random()*6.283,rad:Math.random()*STARFIELD_RADIUS_RANGE+STARFIELD_RADIUS_MIN,sp:STARFIELD_SPEED_MIN+Math.random()*STARFIELD_SPEED_RANGE,ci:(Math.random()<STARFIELD_ACCENT_CHANCE?0:1),sz:STARFIELD_SIZE_MIN+Math.random()*STARFIELD_SIZE_RANGE});
    } else if (pattern==="aurora") {
      st.r=[]; for(i=0;i<AURORA_RIBBON_COUNT;i++) st.r.push({yb:H*(AURORA_Y_START+i*AURORA_Y_STEP),amp:AURORA_AMPLITUDE_START+i*AURORA_AMPLITUDE_STEP,wl:AURORA_WAVELENGTH_START+i*AURORA_WAVELENGTH_STEP,sp:AURORA_SPEED_START+i*AURORA_SPEED_STEP,th:AURORA_THICKNESS_START+i*AURORA_THICKNESS_STEP,ci:i,ph:Math.random()*6.283});
    }
  }

  // ── per-pattern draw ──
  function drawAmbient(now){
    fillBg();
    for(var i=0;i<st.o.length;i++){ var o=st.o[i]; o.x+=o.vx;o.y+=o.vy;
      if(o.x<-o.r)o.x=W+o.r; else if(o.x>W+o.r)o.x=-o.r;
      if(o.y<-o.r)o.y=H+o.r; else if(o.y>H+o.r)o.y=-o.r;
      var pu=0.5+0.5*Math.sin(now*o.sp+o.ph), a=(isLight?AMBIENT_ALPHA_LIGHT:AMBIENT_ALPHA_DARK)+AMBIENT_ALPHA_PULSE*pu, rr=o.r*(AMBIENT_SIZE_MIN+AMBIENT_SIZE_PULSE*pu);
      var g=ctx.createRadialGradient(o.x,o.y,0,o.x,o.y,rr), c=pick(o.ci);
      g.addColorStop(0,rgba(c,a)); g.addColorStop(1,rgba(c,0));
      ctx.fillStyle=g; ctx.beginPath(); ctx.arc(o.x,o.y,rr,0,6.2832,false); ctx.fill(); }
  }
  function drawConstellation(now){
    fillBg();
    var hz=Math.round(H*FUTURE_HORIZON_Y), ac=pick(0), hl=pick(1), i, k;

    // Clearly visible, asynchronous twinkling. Brightness and apparent size pulse
    // independently; selected stars briefly form a tiny four-point sparkle.
    for(i=0;i<st.stars.length;i++){
      var s=st.stars[i];
      var tw=0.5+0.5*Math.sin(now*s.sp+s.ph);
      var tw2=0.5+0.5*Math.sin(now*s.sp*FUTURE_STAR_SECOND_SPEED+s.ph*FUTURE_STAR_SECOND_PHASE);
      var pulse=Math.pow(tw,FUTURE_STAR_PULSE_POWER)*FUTURE_STAR_PRIMARY_WEIGHT+tw2*FUTURE_STAR_SECONDARY_WEIGHT;
      var a=(FUTURE_STAR_ALPHA_MIN+FUTURE_STAR_ALPHA_RANGE*pulse)*(isLight?FUTURE_STAR_ALPHA_LIGHT:FUTURE_STAR_ALPHA_DARK);
      var rr=s.r*(FUTURE_STAR_SIZE_MIN+FUTURE_STAR_SIZE_PULSE*pulse);
      ctx.fillStyle=rgba(hl,a);
      ctx.beginPath(); ctx.arc(s.x,s.y,rr,0,6.2832,false); ctx.fill();

      if(s.flare && pulse>FUTURE_STAR_FLARE_THRESHOLD){
        var fa=(pulse-FUTURE_STAR_FLARE_THRESHOLD)/(1-FUTURE_STAR_FLARE_THRESHOLD)*(isLight?FUTURE_STAR_FLARE_ALPHA_LIGHT:FUTURE_STAR_FLARE_ALPHA_DARK);
        var fl=FUTURE_STAR_FLARE_BASE_SIZE+s.r*FUTURE_STAR_FLARE_SIZE_SCALE*pulse;
        ctx.strokeStyle=rgba(hl,fa);
        ctx.lineWidth=FUTURE_STAR_FLARE_LINE_WIDTH;
        ctx.beginPath();
        ctx.moveTo(s.x-fl,s.y); ctx.lineTo(s.x+fl,s.y);
        ctx.moveTo(s.x,s.y-fl); ctx.lineTo(s.x,s.y+fl);
        ctx.stroke();
        ctx.lineWidth=1;
      }
    }

    // Move the complete foreground scene down as ONE rigid unit. Stars deliberately
    // stay in sky-space so lowering the scene reveals more starry sky above it.
    ctx.save();
    ctx.translate(0,SCENE_Y_OFFSET);

    // Outrun sun, kept centred in the visible main panel.
    var sunR=SUN_RADIUS, sx=visualCenterX(), sy=hz+SUN_Y_FROM_HORIZON, yClip=hz+SUN_CLIP_FROM_HORIZON;
    ctx.save();
    ctx.beginPath(); ctx.rect(0,0,W,yClip); ctx.clip();

    // Soft sky-side bloom behind the sun. It is drawn before the disc and clipped at
    // the horizon, so the glow never washes over the floor grid.
    if(SUN_BLOOM_STRENGTH>0 && SUN_BLOOM_SIZE>1){
      var bloomR=sunR*SUN_BLOOM_SIZE;
      var bloomInner=sunR*Math.max(0,Math.min(1,SUN_BLOOM_INNER_RADIUS));
      var bloomMid=Math.max(0.01,Math.min(0.99,SUN_BLOOM_FALLOFF));
      var bloom=ctx.createRadialGradient(sx,sy,bloomInner,sx,sy,bloomR);
      bloom.addColorStop(0,rgba(hl,SUN_BLOOM_STRENGTH));
      bloom.addColorStop(bloomMid,rgba(ac,SUN_BLOOM_STRENGTH*0.34));
      bloom.addColorStop(1,rgba(ac,0));
      ctx.fillStyle=bloom;
      ctx.fillRect(sx-bloomR,sy-bloomR,bloomR*2,bloomR*2);
    }

    var sg=ctx.createLinearGradient(0,sy-sunR,0,sy+sunR);
    sg.addColorStop(0,rgba(hl,SUN_GRADIENT_TOP_ALPHA));
    sg.addColorStop(0.5,rgba(ac,SUN_GRADIENT_MID_ALPHA));
    sg.addColorStop(1,rgba(ac,SUN_GRADIENT_BOTTOM_ALPHA));
    ctx.fillStyle=sg; ctx.beginPath(); ctx.arc(sx,sy,sunR,0,6.2832,false); ctx.fill();
    ctx.fillStyle=bgHex;
    // Smooth synthwave sun-gap conveyor. Instead of teleporting one gap from the
    // top back to the bottom, an infinite evenly-spaced sequence scrolls upward.
    // A thick gap enters gradually from BELOW the clipped sun while a thin gap
    // exits above the striped section, so there is no visible wrap/shock.
    var gapCount=Math.max(2,Math.round(SUN_GAP_COUNT));
    var gapTop=sy+SUN_GAP_START_OFFSET;
    var gapVisibleBottom=yClip;
    var gapRange=gapVisibleBottom-gapTop;
    var gapSpacing=gapRange/gapCount;
    var gapShift=(now*SUN_GAP_SPEED*SUN_GAP_SCROLL_RATE)%gapSpacing;

    // Restrict the moving cut-outs to the sun silhouette AND its lower striped area.
    // The circle clip is important: without it, the dark gap rectangles can protrude
    // beyond the curved sides of the sun, especially near the lower edge.
    ctx.save();
    ctx.beginPath();
    ctx.arc(sx,sy,sunR,0,6.2832,false);
    ctx.clip();
    ctx.beginPath();
    ctx.rect(sx-sunR-2,gapTop,sunR*2+4,gapVisibleBottom-gapTop+1);
    ctx.clip();

    // Start one whole spacing below the visible bottom. That hidden incoming gap
    // moves into view smoothly, which also prevents a large solid slab appearing
    // beneath the lowest visible gap when SUN_GAP_COUNT is small (e.g. 6).
    var virtualBottom=gapVisibleBottom+gapSpacing;
    for(k=0;k<gapCount+3;k++){
      var by=virtualBottom-k*gapSpacing-gapShift;
      if(by<gapTop-gapSpacing || by>virtualBottom+1) continue;

      // Thickness is determined by vertical position: broad at the bottom, fine
      // near the top. Because position itself is continuous, thickness is too.
      var p=(by-gapTop)/gapRange;
      if(p<0) p=0; else if(p>1) p=1;
      var minBh=SUN_GAP_MIN_THICKNESS;
      var maxBh=Math.min(SUN_GAP_MAX_THICKNESS,gapSpacing*SUN_GAP_MAX_SPACING_RATIO);
      var bh=minBh+(maxBh-minBh)*Math.pow(p,SUN_GAP_THICKNESS_CURVE);
      ctx.fillRect(sx-sunR,by-bh*0.5,sunR*2,bh);
    }
    ctx.restore();
    ctx.restore();

    // Wide synthwave floor. GRID_PERSPECTIVE is the one value to tweak:
    // 1.75 = previous look; larger values fan the foreground lines outward more.
    // The horizon width is kept fixed, so perspective increases without collapsing
    // the grid back into a needle-point vanishing point.
    ctx.lineWidth=1;
    var cols=GRID_COLUMNS;
    for(k=0;k<=cols;k++){
      var fx=(k/cols-0.5), xB=sx+fx*W*GRID_PERSPECTIVE;
      var xH=sx+fx*W*GRID_HORIZON_SPREAD; // broad horizon spacing
      var edge=Math.abs(fx)*2, va=GRID_VERTICAL_ALPHA+GRID_VERTICAL_CENTER_BOOST*(1-edge);
      ctx.strokeStyle=rgba(ac,va);
      ctx.beginPath(); ctx.moveTo(xH,hz); ctx.lineTo(xB,H); ctx.stroke();
    }
    var rows=GRID_ROWS, scroll=(now*GRID_SCROLL_SPEED)%1;
    for(k=0;k<rows;k++){
      var t=((k/rows)+scroll)%1;
      var yy=hz+(H-hz)*Math.pow(t,GRID_DEPTH_POWER), a2=GRID_HORIZONTAL_ALPHA+GRID_HORIZONTAL_ALPHA_RANGE*t;
      ctx.strokeStyle=rgba(ac,a2);
      ctx.beginPath(); ctx.moveTo(0,yy); ctx.lineTo(W,yy); ctx.stroke();
    }

    // Horizon sits behind the scenery, so mountain silhouettes mask it naturally.
    ctx.strokeStyle=rgba(hl,GRID_HORIZON_ALPHA); ctx.lineWidth=GRID_HORIZON_LINE_WIDTH;
    ctx.beginPath(); ctx.moveTo(0,hz); ctx.lineTo(W,hz); ctx.stroke();
    ctx.lineWidth=1;

    // One continuous hand-built mountain bank per side. No duplicated meshes and
    // no interpenetrating copies: the centre valley remains completely clear.
    drawMountainBanks(now,hz,sx,ac,hl);

    // End rigid vertical scene translation.
    ctx.restore();
  }

  // Build one continuous faceted bank from a hand-authored silhouette. Because each
  // side is a single mesh strip, there are no overlapping mountain instances.
  function buildCustomBank(profile,side,hz,sx,drift,now){
    var gap=MOUNTAIN_CENTER_GAP;
    var inner=sx+side*gap;
    var outer=(side<0?VISUAL_LEFT:W);
    var span=Math.abs(outer-inner);
    var sil=[],mid=[],base=[],i;
    for(i=0;i<profile.t.length;i++){
      var t=profile.t[i];
      var x=inner+side*t*span + side*drift*(REAR_MOUNTAIN_DRIFT_NEAR+REAR_MOUNTAIN_DRIFT_FAR*t);
      var baseDrop=REAR_MOUNTAIN_BASE_START+REAR_MOUNTAIN_BASE_DROP*Math.pow(t,REAR_MOUNTAIN_BASE_POWER);
      var by=hz+baseDrop;

      // Keep the mountain planted at the base, but visibly animate the REAL
      // skyline vertices. Tall peaks get the most travel; low foothills barely
      // move. Two slow waves with different phases prevent synchronized bobbing.
      var phase=i*REAR_MOUNTAIN_PHASE_STEP + (side<0?REAR_MOUNTAIN_PHASE_LEFT:REAR_MOUNTAIN_PHASE_RIGHT);
      var peakFactor=profile.h[i]/REAR_MOUNTAIN_HEIGHT_NORMALIZER;
      if(peakFactor>1) peakFactor=1;
      var motion=Math.sin(now*MOUNTAIN_SPEED*REAR_MOUNTAIN_WAVE1_SPEED+phase)*(REAR_MOUNTAIN_WAVE1_BASE+REAR_MOUNTAIN_WAVE1_HEIGHT*peakFactor);
      motion+=Math.sin(now*MOUNTAIN_SPEED*REAR_MOUNTAIN_WAVE2_SPEED+phase*REAR_MOUNTAIN_WAVE2_PHASE)*(REAR_MOUNTAIN_WAVE2_BASE+REAR_MOUNTAIN_WAVE2_HEIGHT*peakFactor);
      // The tiny centre foothill stays almost pinned so the valley opening is stable.
      motion*=REAR_MOUNTAIN_CENTER_MOTION+REAR_MOUNTAIN_OUTER_MOTION*Math.min(1,t*REAR_MOUNTAIN_MOTION_RAMP);
      var sy=by-profile.h[i]-motion;
      var mx=x+side*profile.j[i]*REAR_MOUNTAIN_JITTER;
      var blend=REAR_MOUNTAIN_MID_BLEND + ((i%3)-1)*REAR_MOUNTAIN_MID_VARIATION;
      // Interior ridge follows the skyline motion, but less strongly, so facets flex.
      var my=sy+(by-sy)*blend-motion*REAR_MOUNTAIN_MID_MOTION;
      sil.push({x:x,y:sy,h:profile.h[i],t:t});
      mid.push({x:mx,y:my,h:profile.h[i]*0.5,t:t});
      base.push({x:x,y:by,h:0,t:t});
    }
    return {sil:sil,mid:mid,base:base};
  }

  function drawCustomBank(profile,side,hz,sx,ac,hl,drift,now){
    var b=buildCustomBank(profile,side,hz,sx,drift,now);
    var sil=b.sil, mid=b.mid, base=b.base, i, a, c;

    // Solid dark body masks the moving grid beneath the mountains, then a faint
    // themed wash prevents it from reading as a flat black cutout.
    ctx.beginPath();
    ctx.moveTo(sil[0].x,sil[0].y);
    for(i=1;i<sil.length;i++) ctx.lineTo(sil[i].x,sil[i].y);
    for(i=base.length-1;i>=0;i--) ctx.lineTo(base[i].x,base[i].y);
    ctx.closePath();
    ctx.fillStyle=bgHex; ctx.fill();
    ctx.fillStyle=rgba(ac,isLight?REAR_MOUNTAIN_FILL_LIGHT:REAR_MOUNTAIN_FILL_DARK); ctx.fill();

    // Outer silhouette: the complete crest uses the secondary/highlight theme color.
    for(i=0;i<sil.length-1;i++){
      a=sil[i]; c=sil[i+1];
      var peak=Math.max(a.h,c.h)/REAR_MOUNTAIN_HEIGHT_NORMALIZER;
      ctx.strokeStyle=rgba(hl,(isLight?REAR_MOUNTAIN_OUTLINE_LIGHT:REAR_MOUNTAIN_OUTLINE_DARK)+peak*REAR_MOUNTAIN_OUTLINE_HEIGHT_BOOST);
      ctx.lineWidth=peak>REAR_MOUNTAIN_BOLD_THRESHOLD?REAR_MOUNTAIN_BOLD_WIDTH:REAR_MOUNTAIN_NORMAL_WIDTH;
      ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(c.x,c.y); ctx.stroke();
    }

    // Faceted interior: one mid-ridge strip plus alternating diagonals. This gives
    // low-poly structure without the dense overlapping web of repeated OBJ meshes.
    ctx.lineWidth=1;
    for(i=0;i<mid.length-1;i++){
      var depth=(mid[i].t+mid[i+1].t)*0.5;
      ctx.strokeStyle=rgba(ac,(isLight?REAR_MOUNTAIN_RIDGE_LIGHT:REAR_MOUNTAIN_RIDGE_DARK)+depth*REAR_MOUNTAIN_RIDGE_DEPTH_BOOST);
      ctx.beginPath(); ctx.moveTo(mid[i].x,mid[i].y); ctx.lineTo(mid[i+1].x,mid[i+1].y); ctx.stroke();
    }
    for(i=0;i<sil.length;i++){
      var op=(isLight?REAR_MOUNTAIN_FACET_LIGHT:REAR_MOUNTAIN_FACET_DARK)+sil[i].t*REAR_MOUNTAIN_FACET_DEPTH_BOOST;
      ctx.strokeStyle=rgba(ac,op);
      ctx.beginPath(); ctx.moveTo(sil[i].x,sil[i].y); ctx.lineTo(mid[i].x,mid[i].y); ctx.lineTo(base[i].x,base[i].y); ctx.stroke();
      if(i<sil.length-1){
        ctx.strokeStyle=rgba(ac,op*REAR_MOUNTAIN_DIAGONAL_ALPHA);
        ctx.beginPath();
        if(i%2===0){ ctx.moveTo(mid[i].x,mid[i].y); ctx.lineTo(base[i+1].x,base[i+1].y); }
        else { ctx.moveTo(base[i].x,base[i].y); ctx.lineTo(mid[i+1].x,mid[i+1].y); }
        ctx.stroke();
      }
    }
    ctx.lineWidth=1;
  }

  // Foreground mountain range. This is a SECOND, clearly separate layer in front
  // of the tall horizon bank. Its base follows a floor-perspective ray away from
  // the horizon, while its jagged skyline grows toward the outside/foreground.
  // It is drawn AFTER the background bank so it cannot disappear behind it.
  function drawForegroundMountainLayer(side,now,hz,sx,ac,hl){
    var gap=MOUNTAIN_CENTER_GAP, inner=sx+side*(gap+FRONT_MOUNTAIN_INNER_OFFSET);
    var outer=(side<0?VISUAL_LEFT:W);
    var span=Math.abs(outer-inner)+FRONT_MOUNTAIN_EXTRA_WIDTH; // continue slightly beyond the visible edge

    // Uneven peak spacing and different heights on each side prevent mirroring.
    var tt=[0,0.055,0.12,0.19,0.27,0.35,0.44,0.53,0.62,0.71,0.79,0.87,0.94,1.0];
    var hh=(side<0)
      ? [0,7,16,8,27,13,39,20,53,28,70,39,94,122]
      : [0,9,5,19,11,31,16,45,24,60,33,82,47,116];
    var jx=(side<0)
      ? [0,-1,2,-2,1,-3,2,-1,3,-2,2,-3,1,0]
      : [0,2,-1,3,-2,1,-3,2,-2,3,-1,2,-2,0];

    var sil=[],mid=[],base=[],i;
    for(i=0;i<tt.length;i++){
      var t=tt[i];
      var x=inner+side*t*span;

      // Keep the mountain/grid contact on one TRUE straight perspective ray.
      // x advances linearly with t, so y must also advance linearly with t;
      // the old t^1.48 term was what created the visible curved/bow-shaped base.
      var baseDrop=FRONT_MOUNTAIN_BASE_START+FRONT_MOUNTAIN_BASE_DROP*t;
      var by=hz+baseDrop;
      var peak=hh[i];
      var pf=peak/FRONT_MOUNTAIN_HEIGHT_NORMALIZER;

      // Animate the actual foreground peak vertices. No x recycling or depth
      // re-sorting: each peak stays in place and only breathes vertically.
      var phase=i*FRONT_MOUNTAIN_PHASE_STEP+(side<0?FRONT_MOUNTAIN_PHASE_LEFT:FRONT_MOUNTAIN_PHASE_RIGHT);
      var motion=Math.sin(now*MOUNTAIN_SPEED*FRONT_MOUNTAIN_WAVE1_SPEED+phase)*(FRONT_MOUNTAIN_WAVE1_BASE+FRONT_MOUNTAIN_WAVE1_HEIGHT*pf);
      motion+=Math.sin(now*MOUNTAIN_SPEED*FRONT_MOUNTAIN_WAVE2_SPEED+phase*FRONT_MOUNTAIN_WAVE2_PHASE)*(FRONT_MOUNTAIN_WAVE2_BASE+FRONT_MOUNTAIN_WAVE2_HEIGHT*pf);
      motion*=FRONT_MOUNTAIN_CENTER_MOTION+FRONT_MOUNTAIN_OUTER_MOTION*Math.min(1,t*FRONT_MOUNTAIN_MOTION_RAMP);

      var sy=by-peak-motion;
      var mx=x+side*jx[i]*FRONT_MOUNTAIN_JITTER;
      // The interior ridge forms the second red-style jagged line, not a flat strip.
      var midBlend=FRONT_MOUNTAIN_MID_BLEND+((i%4)-1.5)*FRONT_MOUNTAIN_MID_VARIATION;
      var my=sy+(by-sy)*midBlend-motion*FRONT_MOUNTAIN_MID_MOTION;

      sil.push({x:x,y:sy,t:t,h:peak});
      mid.push({x:mx,y:my,t:t,h:peak*FRONT_MOUNTAIN_MID_HEIGHT});
      base.push({x:x,y:by,t:t,h:0});
    }

    // Solid body: this is deliberately opaque so the foreground range visually
    // sits in front of the rear bank and the moving grid, making the two layers clear.
    ctx.beginPath();
    ctx.moveTo(sil[0].x,sil[0].y);
    for(i=1;i<sil.length;i++) ctx.lineTo(sil[i].x,sil[i].y);
    for(i=base.length-1;i>=0;i--) ctx.lineTo(base[i].x,base[i].y);
    ctx.closePath();
    ctx.fillStyle=bgHex; ctx.fill();
    ctx.fillStyle=rgba(ac,isLight?FRONT_MOUNTAIN_FILL_LIGHT:FRONT_MOUNTAIN_FILL_DARK); ctx.fill();

    // Foreground skyline: the complete crest uses the secondary/highlight theme color
    // so it stays continuous even where the two ranges overlap.
    ctx.lineWidth=FRONT_MOUNTAIN_OUTLINE_WIDTH;
    for(i=0;i<sil.length-1;i++){
      var a=sil[i],b=sil[i+1];
      var q=(a.t+b.t)*0.5;
      ctx.strokeStyle=rgba(hl,(isLight?FRONT_MOUNTAIN_OUTLINE_LIGHT:FRONT_MOUNTAIN_OUTLINE_DARK)+FRONT_MOUNTAIN_OUTLINE_DEPTH_BOOST*q);
      ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();
    }

    // Jagged inner ridge plus sparse facets. These lines deliberately follow the
    // same perspective descent as the base so the layer reads as terrain, not a strip.
    ctx.lineWidth=1;
    for(i=0;i<mid.length-1;i++){
      var q2=(mid[i].t+mid[i+1].t)*0.5;
      ctx.strokeStyle=rgba(ac,(isLight?FRONT_MOUNTAIN_RIDGE_LIGHT:FRONT_MOUNTAIN_RIDGE_DARK)+FRONT_MOUNTAIN_RIDGE_DEPTH_BOOST*q2);
      ctx.beginPath(); ctx.moveTo(mid[i].x,mid[i].y); ctx.lineTo(mid[i+1].x,mid[i+1].y); ctx.stroke();
    }
    for(i=0;i<sil.length;i++){
      var op=(isLight?FRONT_MOUNTAIN_FACET_LIGHT:FRONT_MOUNTAIN_FACET_DARK)+FRONT_MOUNTAIN_FACET_DEPTH_BOOST*sil[i].t;
      ctx.strokeStyle=rgba(ac,op);
      ctx.beginPath();
      ctx.moveTo(sil[i].x,sil[i].y);
      ctx.lineTo(mid[i].x,mid[i].y);
      ctx.lineTo(base[i].x,base[i].y);
      ctx.stroke();
      if(i<sil.length-1){
        ctx.strokeStyle=rgba(ac,op*FRONT_MOUNTAIN_DIAGONAL_ALPHA);
        ctx.beginPath();
        if(i%2===0){
          ctx.moveTo(mid[i].x,mid[i].y); ctx.lineTo(base[i+1].x,base[i+1].y);
        } else {
          ctx.moveTo(base[i].x,base[i].y); ctx.lineTo(mid[i+1].x,mid[i+1].y);
        }
        ctx.stroke();
      }
    }

    // Perspective base edge. It is intentionally subdued: enough to define the
    // front range without becoming the dominant straight "ramp" from older builds.
    ctx.strokeStyle=rgba(ac,isLight?FRONT_MOUNTAIN_BASE_LIGHT:FRONT_MOUNTAIN_BASE_DARK);
    ctx.lineWidth=FRONT_MOUNTAIN_BASE_WIDTH;
    ctx.beginPath();
    ctx.moveTo(base[0].x,base[0].y);
    for(i=1;i<base.length;i++) ctx.lineTo(base[i].x,base[i].y);
    ctx.stroke();
    ctx.lineWidth=1;
  }

  function drawMountainBanks(now,hz,sx,ac,hl){
    // Tiny opposing lateral drift plus independent vertical vertex motion keeps the
    // horizon scenery alive while its bases stay planted.
    var drift=Math.sin(now*MOUNTAIN_SPEED*MOUNTAIN_DRIFT_SPEED)*MOUNTAIN_DRIFT_AMOUNT;
    var gap=MOUNTAIN_CENTER_GAP;

    ctx.save();
    ctx.beginPath(); ctx.rect(VISUAL_LEFT,0,(sx-gap)-VISUAL_LEFT,H); ctx.clip();
    // Layer 1: tall rear bank. Layer 2: lower foreground bank drawn on top.
    drawCustomBank(customMountainLeft,-1,hz,sx,ac,hl,drift,now);
    drawForegroundMountainLayer(-1,now,hz,sx,ac,hl);
    ctx.restore();

    ctx.save();
    ctx.beginPath(); ctx.rect(sx+gap,0,W-(sx+gap),H); ctx.clip();
    drawCustomBank(customMountainRight,1,hz,sx,ac,hl,-drift,now);
    drawForegroundMountainLayer(1,now,hz,sx,ac,hl);
    ctx.restore();
    ctx.lineWidth=1;
  }

  function drawWaves(now){
    fillBg();
    for(var k=0;k<st.l.length;k++){ var L=st.l[k], c=pick(L.ci), x;
      ctx.fillStyle=rgba(c,isLight?WAVES_ALPHA_LIGHT:WAVES_ALPHA_DARK);
      ctx.beginPath(); ctx.moveTo(0,H);
      for(x=0;x<=W;x+=WAVES_X_STEP){ var y=L.yb+Math.sin(x/L.wl*6.2832 + now*L.sp + L.ph)*L.amp; ctx.lineTo(x,y); }
      ctx.lineTo(W,H); ctx.closePath(); ctx.fill(); }
  }
  function makeGlow(color,size){
    var c=document.createElement("canvas"); c.width=size; c.height=size;
    var x=c.getContext?c.getContext("2d"):null; if(!x) return c;
    var r=size/2, g=x.createRadialGradient(r,r,0,r,r,r);
    g.addColorStop(0,"rgba(255,255,255,"+MAGIC_GLOW_WHITE_ALPHA+")");
    g.addColorStop(MAGIC_GLOW_MIDPOINT,rgba(color,MAGIC_GLOW_COLOR_ALPHA));
    g.addColorStop(1,rgba(color,0));
    x.fillStyle=g; x.fillRect(0,0,size,size);
    return c;
  }
  function buildMagicSprites(){ st.sprites=[]; for(var i=0;i<pal.length;i++) st.sprites.push(makeGlow(pal[i],MAGIC_SPRITE_SIZE)); }
  function drawMagic(now){
    fillBg();
    if(st.spriteVer!==colorVer){ buildMagicSprites(); st.spriteVer=colorVer; }
    for(var i=0;i<st.p.length;i++){ var o=st.p[i];
      o.y-=o.vy; o.sw+=o.ss; o.tw+=o.tsp;
      if(o.y<-MAGIC_RESET_MARGIN){ o.y=H+MAGIC_RESET_MARGIN; o.x=Math.random()*W; o.trail.length=0; }
      var x=o.x+Math.sin(o.sw)*o.amp, tw=0.5+0.5*Math.sin(o.tw), ga=(isLight?MAGIC_ALPHA_LIGHT:MAGIC_ALPHA_DARK)*(MAGIC_ALPHA_MIN+MAGIC_ALPHA_RANGE*tw), c=pick(o.ci);
      o.trail.push(x); o.trail.push(o.y);                 // record path (x,y pairs)
      var maxTrailValues=Math.max(0,Math.round(MAGIC_TRAIL_LENGTH))*2;
      while(o.trail.length>maxTrailValues && o.trail.length>=2){ o.trail.shift(); o.trail.shift(); }
      var n=o.trail.length/2;                             // fading spark trail, oldest first
      for(var j=0;j<n-1;j+=2){ var fr=(j+1)/n, tr=MAGIC_TRAIL_RADIUS_MIN+fr*MAGIC_TRAIL_RADIUS_RANGE, ta=ga*fr*MAGIC_TRAIL_ALPHA;
        ctx.fillStyle=rgba(c,ta); ctx.beginPath(); ctx.arc(o.trail[j*2],o.trail[j*2+1],tr,0,6.2832,false); ctx.fill(); }
      var sp=st.sprites[o.ci%st.sprites.length], ds=o.gs*(MAGIC_SPRITE_SCALE_MIN+MAGIC_SPRITE_SCALE_RANGE*tw);
      ctx.globalAlpha=ga; ctx.drawImage(sp,x-ds/2,o.y-ds/2,ds,ds); ctx.globalAlpha=1;
      ctx.fillStyle="rgba(255,255,255,"+(ga*MAGIC_CORE_ALPHA).toFixed(3)+")";
      ctx.beginPath(); ctx.arc(x,o.y,o.core,0,6.2832,false); ctx.fill(); }
  }
  function drawStarfield(now){
    fillBg();
    // Keep the warp composition intact; only lower its focal point as one unit.
    var cx=visualCenterX(), cy=H/2+STARFIELD_Y_OFFSET;
    // Use the farthest canvas corner so streak opacity/width still ramps
    // smoothly after moving the vanishing point to the right.
    var maxDx=Math.max(cx, W-cx), maxDy=Math.max(cy, H-cy);
    var maxR=Math.sqrt(maxDx*maxDx+maxDy*maxDy);
    for(var i=0;i<st.s.length;i++){ var s=st.s[i];
      var ca=Math.cos(s.a), sa=Math.sin(s.a), ox=cx+ca*s.rad, oy=cy+sa*s.rad;
      s.rad += s.sp*(1+s.rad*STARFIELD_ACCELERATION);
      var nx=cx+ca*s.rad, ny=cy+sa*s.rad, c=pick(s.ci), a=Math.min(1, s.rad/maxR+STARFIELD_ALPHA_BASE);
      ctx.strokeStyle=rgba(c, a*(isLight?STARFIELD_ALPHA_LIGHT:STARFIELD_ALPHA_DARK)); ctx.lineWidth=Math.max(STARFIELD_LINE_MIN_WIDTH, s.rad/maxR*STARFIELD_LINE_WIDTH_SCALE*s.sz);
      ctx.beginPath(); ctx.moveTo(ox,oy); ctx.lineTo(nx,ny); ctx.stroke();
      if(nx<-STARFIELD_RESET_MARGIN||nx>W+STARFIELD_RESET_MARGIN||ny<-STARFIELD_RESET_MARGIN||ny>H+STARFIELD_RESET_MARGIN){ s.a=Math.random()*6.2832; s.rad=Math.random()*STARFIELD_RESET_RADIUS_RANGE+STARFIELD_RESET_RADIUS_MIN; s.sp=STARFIELD_SPEED_MIN+Math.random()*STARFIELD_SPEED_RANGE; s.sz=STARFIELD_SIZE_MIN+Math.random()*STARFIELD_SIZE_RANGE; } }
  }
  function drawAurora(now){
    fillBg();
    for(var k=0;k<st.r.length;k++){ var R=st.r[k], c=pick(R.ci), x;
      ctx.beginPath();
      for(x=0;x<=W;x+=AURORA_X_STEP){ var y=R.yb+Math.sin(x/R.wl*6.2832 + now*R.sp + R.ph)*R.amp; if(x===0)ctx.moveTo(x,y); else ctx.lineTo(x,y); }
      for(x=W;x>=0;x-=AURORA_X_STEP){ var y2=R.yb+R.th+Math.sin(x/R.wl*6.2832 + now*R.sp + R.ph + AURORA_BACK_PHASE)*R.amp; ctx.lineTo(x,y2); }
      ctx.closePath();
      var g=ctx.createLinearGradient(0,R.yb-R.amp,0,R.yb+R.th+R.amp);
      g.addColorStop(0,rgba(c,0)); g.addColorStop(0.5,rgba(c,isLight?AURORA_ALPHA_LIGHT:AURORA_ALPHA_DARK)); g.addColorStop(1,rgba(c,0));
      ctx.fillStyle=g; ctx.fill(); }
  }
  function draw(now){
    if(pattern==="constellation") drawConstellation(now);
    else if(pattern==="waves") drawWaves(now);
    else if(pattern==="magic") drawMagic(now);
    else if(pattern==="starfield") drawStarfield(now);
    else if(pattern==="aurora") drawAurora(now);
    else drawAmbient(now);
  }
  function frame(){ if(!ctx||!enabled) return; draw((new Date()).getTime()); }

  // ── DOM fallback (only when canvas has no 2D context) ──
  function recolorDom(){ if(!domDots) return; for(var i=0;i<domDots.length;i++){ var c=pick(i); domDots[i].el.style.background="rgb("+c.r+","+c.g+","+c.b+")"; } }
  function buildDom(){
    var host=document.getElementById("app-root");
    domLayer=document.createElement("div");
    domLayer.style.position="absolute"; domLayer.style.top="0"; domLayer.style.left="0";
    domLayer.style.width=W+"px"; domLayer.style.height=H+"px"; domLayer.style.zIndex="0"; domLayer.style.overflow="hidden";
    host.insertBefore(domLayer, host.firstChild);
    domDots=[];
    for(var i=0;i<9;i++){ var d=document.createElement("div"), sz=90+Math.floor(Math.random()*130);
      d.style.position="absolute"; d.style.width=sz+"px"; d.style.height=sz+"px"; d.style.borderRadius="50%";
      setOpacity(d, isLight?0.16:0.13); domLayer.appendChild(d);
      domDots.push({el:d,x:Math.random()*W,y:Math.random()*H,sz:sz,vx:(Math.random()-0.5)*0.32,vy:(Math.random()-0.5)*0.28}); }
    recolorDom();
  }
  function domFrame(){ if(!enabled) return; for(var i=0;i<domDots.length;i++){ var o=domDots[i]; o.x+=o.vx;o.y+=o.vy;
    if(o.x<-o.sz)o.x=W; else if(o.x>W)o.x=-o.sz; if(o.y<-o.sz)o.y=H; else if(o.y>H)o.y=-o.sz;
    o.el.style.left=Math.round(o.x)+"px"; o.el.style.top=Math.round(o.y)+"px"; } }

  function ensureRunning(){
    if(ctx){ if(!timer) timer=setInterval(frame,33); }
    else if(domLayer){ if(!timer) timer=setInterval(domFrame,40); }
    else { buildDom(); timer=setInterval(domFrame,40); }
  }
  function stopRunning(){ if(timer){ clearInterval(timer); timer=null; } }

  // Resize both the canvas bitmap and the animation's coordinate space. Merely
  // stretching the original 980x700 bitmap would distort effects on ultrawide
  // screens, so layout changes update the real drawing surface instead.
  function resize(w,h){
    w=Math.max(1,Math.round(w)); h=Math.max(1,Math.round(h));
    if(w===W && h===H) return;
    W=w; H=h; VISUAL_W=Math.max(1,W-VISUAL_LEFT);
    if(!cv) cv=document.getElementById("bg-canvas");
    if(cv){
      cv.style.width=W+"px"; cv.style.height=H+"px";
      cv.width=W; cv.height=H;
      try{ ctx=cv.getContext ? cv.getContext("2d") : null; }catch(e){ ctx=null; }
    }
    if(domLayer){
      domLayer.style.width=W+"px"; domLayer.style.height=H+"px";
    }
    if(ctx) initPattern();
  }

  function start(){
    if(started) return; started=true;
    if(!pal) pal=palFrom(THEMES.amber);
    cv=document.getElementById("bg-canvas");
    if(cv){
      cv.style.width=W+"px"; cv.style.height=H+"px";
      cv.width=W; cv.height=H;
      try{ ctx = cv.getContext ? cv.getContext("2d") : null; }catch(e){ ctx=null; }
    }
    if(ctx) initPattern();
    if(enabled) ensureRunning();
    else if(cv) cv.style.display="none";
  }
  function setEnabled(on){
    enabled=on;
    if(!started) return;             // start() will honour the flag
    if(on){ if(cv) cv.style.display="block"; if(domLayer) domLayer.style.display="block"; ensureRunning(); }
    else  { stopRunning(); if(cv) cv.style.display="none"; if(domLayer) domLayer.style.display="none"; }
  }
  function setPattern(id){ pattern=id; if(ctx) initPattern(); }

  return { start:start, resize:resize, setColors:setColors, setEnabled:setEnabled, setPattern:setPattern };
})();

// Scale a centred box from its own centre (used for the popup bounce). Uses the
// IE9 -ms-transform property; unprefixed transform covers any higher mode.
function setScale(el, s){
  var v = "scale(" + s + ")";
  el.style.msTransformOrigin = "50% 50%"; el.style.transformOrigin = "50% 50%";
  el.style.msTransform = v; el.style.transform = v;
}
function clearScale(el){ el.style.msTransform = ""; el.style.transform = ""; }

// ── Bouncy popup show / hide (scales from the box centre) ──
function popIn(ov, box){
  if(!ov) return;
  ov.style.display="block";
  dropBridgePublishGeometry(true);
  if(!box){ setOpacity(ov,1); return; }
  var t0=(new Date()).getTime(), dur=280;
  setOpacity(ov,0); setScale(box,0.62);
  var tm=setInterval(function(){
    var p=((new Date()).getTime()-t0)/dur; if(p>1)p=1;
    setOpacity(ov, p<0.6? p/0.6 : 1);
    setScale(box, 0.62+(1-0.62)*easeOutBack(p));
    if(p>=1){ clearInterval(tm); clearScale(box); setOpacity(ov,1); }
  },16);
}
function popOut(ov, box, done){
  if(!ov){ if(done) done(); return; }
  var t0=(new Date()).getTime(), dur=150;
  var tm=setInterval(function(){
    var p=((new Date()).getTime()-t0)/dur; if(p>1)p=1;
    setOpacity(ov, 1-p);
    if(box) setScale(box, 1-0.10*p);
    if(p>=1){ clearInterval(tm); ov.style.display="none"; setOpacity(ov,1); if(box) clearScale(box); dropBridgePublishGeometry(true); if(done) done(); }
  },16);
}


// ── ffprobe integration ──────────────────────────────────

// Paths are written into temporary .bat files. Percent signs expand in cmd.exe
// even inside quotes, so double them before writing. This keeps files such as
// "100% done.mp4" and ffmpeg %04d sequence patterns intact.
function batEscapePercents(value) {
  return ("" + value).replace(/%/g, "%%");
}
function batQuote(path) {
  return '"' + batEscapePercents(path) + '"';
}

// Return the path to ffprobe.exe (same folder as ffmpeg.exe, or PATH).
function ffprobePath() {
  var local = appFolder() + "\\ffprobe.exe";
  if (fso.FileExists(local)) return batQuote(local);
  return "ffprobe";
}

// Queue a probe for a job.  Probes run one at a time to avoid
// spawning a flood of processes when many files are dropped at once.
function scheduleProbe(job) {
  probeQueue.push(job);
  if (!probing) runNextProbe();
}

function runNextProbe() {
  if (!probeQueue.length) { probing = false; return; }
  probing = true;
  var job = probeQueue.shift();
  // sequences: probe the first frame file so we at least get resolution/codec
  var probePath = job.isSequence ? probeSequenceFirstFrame(job) : job.inputPath;
  if (!probePath) { job.probe = { ok: false }; probing = false; runNextProbe(); return; }

  var tmp = wsh.ExpandEnvironmentStrings("%TEMP%") + "\\ffbatch_probe_" + job.id + ".txt";
  var bat = wsh.ExpandEnvironmentStrings("%TEMP%") + "\\ffbatch_probe_" + job.id + ".bat";
  var fp  = ffprobePath();
  // -v quiet -print_format json -show_streams -show_format
  var cmd = '@echo off\n' + fp + ' -v quiet -print_format json -show_streams -show_format -i ' + batQuote(probePath) + ' > ' + batQuote(tmp) + ' 2>&1\n';
  try {
    var bf = fso.CreateTextFile(bat, true, false);
    bf.Write(cmd); bf.Close();
    wsh.Run('"' + bat + '"', 0, false);
  } catch(e) {
    job.probe = { ok: false };
    try { fso.DeleteFile(bat); } catch(_) {}
    probing = false; runNextProbe(); return;
  }
  pollProbe(job, bat, tmp, 0);
}

function probeSequenceFirstFrame(job) {
  // job.inputPath is a pattern like C:\foo\frame_%04d.png
  // Reconstruct the actual first-frame filename from seqStart.
  try {
    var pat = job.inputPath;          // e.g.  C:\foo\frame_%04d.png
    var slash = pat.lastIndexOf("\\");
    var folder = pat.substring(0, slash);
    var namePat = pat.substring(slash + 1);
    // replace printf-style %0Nd or %d with the start number
    var start = job.seqStart || 0;
    var first = namePat.replace(/%0(\d+)d/, function(_, w) {
      var s = "" + start;
      while (s.length < parseInt(w)) s = "0" + s;
      return s;
    }).replace(/%d/, "" + start);
    var fp = folder + "\\" + first;
    if (fso.FileExists(fp)) return fp;
  } catch(_) {}
  return null;
}

function pollProbe(job, bat, tmp, ticks) {
  // wait up to 8 seconds (40 × 200 ms)
  if (ticks > 40) {
    job.probe = { ok: false };
    try { fso.DeleteFile(bat); } catch(_) {}
    try { fso.DeleteFile(tmp); } catch(_) {}
    probing = false; runNextProbe(); return;
  }
  var done = false;
  try {
    if (fso.FileExists(tmp)) {
      var sz = 0;
      try { sz = fso.GetFile(tmp).Size; } catch(_) {}
      if (sz > 0) {
        // ffprobe writes its full JSON then exits, so once the file has
        // content and is no longer growing we can read it.
        done = true;
        var rf = fso.OpenTextFile(tmp, 1, false);
        var raw = rf.ReadAll(); rf.Close();
        job.probe = parseProbeJson(raw, job);
        // Pre-populate duration for the progress bar
        if (job.probe.duration > 0 && !job.totalSec) {
          job.totalSec = job.probe.duration;
        }
        renderJobs(); updateRunButton();
        try { fso.DeleteFile(tmp); } catch(_) {}
        try { fso.DeleteFile(bat); } catch(_) {}
      }
    }
  } catch(e) {
    job.probe = { ok: false };
    done = true;
  }
  if (done) {
    probing = false; runNextProbe();
  } else {
    window.setTimeout(function(){ pollProbe(job, bat, tmp, ticks + 1); }, 200);
  }
}

// Parse ffprobe's JSON output into a simple object.
// We do not use JSON.parse (not available in IE/JScript) — we use the same
// Function() trick as everywhere else in the app.
function parseProbeJson(raw, job) {
  var info = { ok: false, width: 0, height: 0, fps: 0, duration: 0,
               vcodec: "", acodec: "", bitrate: 0, channels: 0,
               sampleRate: 0, colorSpace: "", pixFmt: "",
               hasVideo: false, hasAudio: false, rawJson: raw };
  try {
    // IE JScript doesn't have JSON.parse; use Function() eval
    var data = (new Function("return " + raw.replace(/\btrue\b/g,"true").replace(/\bfalse\b/g,"false").replace(/\bnull\b/g,"null")))();
    if (!data) return info;
    info.ok = true;
    // format-level info
    if (data.format) {
      if (data.format.duration) info.duration = parseFloat(data.format.duration) || 0;
      if (data.format.bit_rate) info.bitrate   = parseInt(data.format.bit_rate, 10) || 0;
    }
    // streams
    var streams = data.streams || [];
    for (var i = 0; i < streams.length; i++) {
      var s = streams[i];
      if (s.codec_type === "video" && !info.hasVideo) {
        info.hasVideo    = true;
        info.vcodec      = s.codec_name || "";
        info.width       = s.width  || 0;
        info.height      = s.height || 0;
        info.colorSpace  = s.color_space || "";
        info.pixFmt      = s.pix_fmt || "";
        // fps: try avg_frame_rate first, then r_frame_rate
        var fpsStr = s.avg_frame_rate || s.r_frame_rate || "";
        if (fpsStr && fpsStr.indexOf("/") >= 0) {
          var parts = fpsStr.split("/");
          var n = parseFloat(parts[0]), d = parseFloat(parts[1]);
          if (d > 0) info.fps = Math.round((n / d) * 100) / 100;
        } else if (fpsStr) {
          info.fps = parseFloat(fpsStr) || 0;
        }
        // duration fallback from stream if format didn't have it
        if (!info.duration && s.duration) info.duration = parseFloat(s.duration) || 0;
        // bitrate fallback
        if (!info.bitrate && s.bit_rate) info.bitrate = parseInt(s.bit_rate, 10) || 0;
      }
      if (s.codec_type === "audio" && !info.hasAudio) {
        info.hasAudio    = true;
        info.acodec      = s.codec_name || "";
        info.channels    = s.channels   || 0;
        info.sampleRate  = parseInt(s.sample_rate, 10) || 0;
      }
    }
  } catch(e) { info.ok = false; info.rawJson = raw + "\n\nPARSE ERROR: " + e.message; }
  return info;
}

// ── Pre-flight warnings ──────────────────────────────────
// Return a warning string (or "") for a job+preset combination.
function probeWarning(job, preset) {
  if (!job.probe || !job.probe.ok) return "";
  var p = job.probe;
  var warnings = [];
  // Video preset applied to audio-only file
  if (!p.hasVideo && preset && preset.args && !/^-vn/i.test(preset.args)) {
    var hasVCodec = /-c:v|libx264|libx265|prores|dnxhd|libvpx/i.test(preset.args);
    if (hasVCodec) warnings.push("No video stream \u2014 video preset may fail");
  }
  // Audio-only preset applied to video file (usually fine, just flag)
  // Mismatch: target preset has a fixed scale but source is already smaller
  if (p.hasVideo && preset) {
    var scaleM = preset.args.match(/-vf\s+scale=(\d+):(\d+)/);
    if (scaleM) {
      var tw = parseInt(scaleM[1]), th = parseInt(scaleM[2]);
      if (tw > 0 && th > 0 && p.width > 0 && p.height > 0) {
        if (tw > p.width * 1.5 || th > p.height * 1.5) {
          warnings.push("Upscaling " + p.width + "\xd7" + p.height + " \u2192 " + tw + "\xd7" + th);
        }
      }
    }
  }
  // Very high fps source being forced to a low-fps preset
  if (p.fps > 60 && preset && /fps=\d+|r\s+\d+|-r\s+\d+/.test(preset.args)) {
    warnings.push("High-fps source (" + p.fps + "fps) with fps-capped preset");
  }
  return warnings.join("  \u25aa  ");
}

// ── Output size estimator ────────────────────────────────
// Estimate output file size from preset args + probed duration.
// Returns a human-readable string, or "" if we can't estimate.
function estimateOutputSize(job, preset) {
  if (!job.probe || !job.probe.ok || !job.probe.duration) return "";
  if (!preset || !preset.args) return "";
  var dur = job.probe.duration;   // seconds
  var kbps = 0;

  // Audio-only presets: sum audio bitrate
  if (/^-vn/.test(preset.args) || /\bfla c\b/.test(preset.args)) {
    var abrM = preset.args.match(/-b:a\s+([\d.]+)\s*([kKmM]?)/);
    if (abrM) {
      kbps = parseFloat(abrM[1]);
      var u = abrM[2].toLowerCase();
      if (u === "m") kbps *= 1000;
      // default unit is kbits/s
    }
  } else {
    // CRF encoding: estimate from codec + CRF value
    var crfM = preset.args.match(/-crf\s+(\d+)/);
    var abrM2 = preset.args.match(/-b:a\s+([\d.]+)\s*([kKmM]?)/);
    var aBitrateKbps = 128; // default audio
    if (abrM2) {
      aBitrateKbps = parseFloat(abrM2[1]);
      if ((abrM2[2]||"").toLowerCase() === "m") aBitrateKbps *= 1000;
    }
    // Very rough CRF→bitrate heuristic based on codec and resolution
    if (crfM) {
      var crf = parseInt(crfM[1]);
      var pixels = (job.probe.width || 1920) * (job.probe.height || 1080);
      var isH265 = /libx265|hevc/i.test(preset.args);
      var isVP9  = /libvpx-vp9/i.test(preset.args);
      // Base kbps at CRF 20 for 1080p H.264 ≈ 4000 kbps
      // Scale by resolution and CRF offset
      var basePx = 1920 * 1080;
      var baseKbps = isH265 ? 2000 : (isVP9 ? 1800 : 4000);
      var resScale = pixels / basePx;
      // Each CRF unit ≈ 12% bitrate change (empirical)
      var crfOffset = Math.pow(1.12, 20 - crf);
      kbps = baseKbps * resScale * crfOffset + aBitrateKbps;
    }
    // Fixed bitrate (-b:v): use that directly
    var bvM = preset.args.match(/-b:v\s+([\d.]+)\s*([kKmMgG]?)/);
    if (bvM) {
      kbps = parseFloat(bvM[1]);
      var bvU = (bvM[2]||"").toLowerCase();
      if (bvU === "m") kbps *= 1000;
      else if (bvU === "g") kbps *= 1000000;
      var aBr2M = preset.args.match(/-b:a\s+([\d.]+)\s*([kKmM]?)/);
      var abr2 = 128;
      if (aBr2M) { abr2 = parseFloat(aBr2M[1]); if ((aBr2M[2]||"").toLowerCase()==="m") abr2*=1000; }
      kbps += abr2;
    }
    // ProRes / DNxHD / lossless: use known typical bitrates
    if (/prores_ks.*profile.*3|prores.*hq/i.test(preset.args) || /-profile:v\s+3/.test(preset.args)) kbps = 220000;
    else if (/prores_ks.*profile.*2|prores_ks/i.test(preset.args)) kbps = 120000;
    else if (/prores_ks.*profile.*0/i.test(preset.args)) kbps = 45000;
    else if (/dnxhd/i.test(preset.args)) kbps = 120000;
    else if (/pcm_s16le|pcm_s24le|flac/i.test(preset.args) && !job.probe.hasVideo) kbps = (job.probe.sampleRate||48000) * (job.probe.channels||2) * 16 / 1000;
  }

  if (kbps <= 0) return "";
  var bytes = (kbps * 1000 / 8) * dur;
  return "\u2248 " + fmtBytes(bytes) + " estimated output";
}

// ── Preset suggestion scoring ────────────────────────────
// Returns a score 0-100 for how well a preset matches probed info.
// Higher = better match.  Used to show "match" badges on top presets.
var probeMatchScores = {};   // presetId -> score; refreshed when probe completes

function scorePresetForProbe(preset, probe) {
  if (!probe || !probe.ok) return 0;
  var score = 0;
  // Resolution match: exact or very close
  if (probe.hasVideo && probe.width > 0 && probe.height > 0) {
    var scaleM = preset.args ? preset.args.match(/-vf\s+scale=(\d+):(\d+)/) : null;
    if (scaleM) {
      var pw = parseInt(scaleM[1]), ph = parseInt(scaleM[2]);
      var diffW = Math.abs(pw - probe.width), diffH = Math.abs(ph - probe.height);
      if (diffW === 0 && diffH === 0) score += 40;
      else if (diffW <= 4 && diffH <= 4) score += 35;
      else if (diffW < probe.width * 0.1) score += 15;
      // Slight bonus for downscaling (common workflow)
      if (pw <= probe.width && ph <= probe.height) score += 5;
    } else {
      // "keep size" preset — good match if source doesn't need resizing
      score += 20;
    }
  }
  // Codec affinity
  if (probe.hasVideo) {
    var vc = probe.vcodec ? probe.vcodec.toLowerCase() : "";
    var pa = (preset.args || "").toLowerCase();
    // H.264 source → H.264 or H.265 output are natural choices
    if ((vc === "h264" || vc === "avc") && /libx264|libx265/.test(pa)) score += 15;
    // ProRes source → ProRes output
    if (vc === "prores" && /prores_ks/.test(pa)) score += 25;
    // Already compressed → "keep size" is a natural option
    if ((vc === "h264" || vc === "hevc") && !/-vf\s+scale/.test(pa)) score += 8;
  }
  // Audio-only preset for audio-only file
  if (!probe.hasVideo && /^-vn/.test(preset.args || "")) score += 50;
  // Image sequence file → Image Sequence presets
  return score;
}

function refreshMatchScores(jobs) {
  // Find the dominant probe (first probed job with ok=true)
  var probe = null;
  for (var i = 0; i < jobs.length; i++) {
    if (jobs[i].probe && jobs[i].probe.ok) { probe = jobs[i].probe; break; }
  }
  probeMatchScores = {};
  if (!probe) return;
  var src = allPresets();
  // Score every preset and keep only the top 3 non-zero
  var scored = [];
  for (var j = 0; j < src.length; j++) {
    var sc = scorePresetForProbe(src[j], probe);
    if (sc > 0) scored.push({ id: src[j].id, score: sc });
  }
  scored.sort(function(a,b){ return b.score - a.score; });
  var topN = Math.min(3, scored.length);
  for (var k = 0; k < topN; k++) {
    if (scored[k].score >= 20) probeMatchScores[scored[k].id] = scored[k].score;
  }
}

// ── Inspect modal ────────────────────────────────────────
function openInspect(jobId) {
  var job = null;
  for (var i = 0; i < jobs.length; i++) { if (jobs[i].id === jobId) { job = jobs[i]; break; } }
  if (!job) return;
  var t = getT();
  var ov = document.getElementById("inspect-overlay");
  var box = document.getElementById("inspect-box");
  var title = document.getElementById("inspect-title");
  var body  = document.getElementById("inspect-body");
  if (!ov) return;

  var displayTitle = job.filename + (job.probe && job.probe.ok ? "" : " \u2014 probe unavailable");
  title.innerText = displayTitle;
  title.style.color = t.ac;
  box.style.background   = t.surf;
  box.style.borderColor  = t.bordHi;
  box.style.color        = t.text;
  body.style.background  = t.logBg;
  body.style.borderColor = t.bord;
  body.style.color       = t.muted;

  var closeBtn = document.getElementById("inspect-close");
  if (closeBtn) {
    closeBtn.innerText = L("close");
    closeBtn.style.borderColor = t.bord;
    closeBtn.style.color       = t.muted;
  }

  if (!job.probe) {
    body.innerText = "Probe has not run yet. ffprobe.exe must be in the same folder as ffmpeg.exe.";
  } else if (!job.probe.ok) {
    body.innerText = job.probe.rawJson || "ffprobe could not read this file.\n\nMake sure ffprobe.exe is present next to ffmpeg.exe.";
  } else {
    // Pretty-print: summary block first, then full JSON
    var p = job.probe;
    var lines = [];
    lines.push("=== SUMMARY ===");
    if (p.hasVideo) {
      lines.push("Video : " + p.vcodec + "  " + p.width + "\xd7" + p.height
        + "  " + p.fps + " fps"
        + (p.colorSpace ? "  " + p.colorSpace : "")
        + (p.pixFmt     ? "  (" + p.pixFmt + ")" : ""));
    }
    if (p.hasAudio) {
      lines.push("Audio : " + p.acodec
        + (p.sampleRate ? "  " + Math.round(p.sampleRate/1000) + " kHz" : "")
        + (p.channels   ? "  " + p.channels + "ch" : ""));
    }
    if (p.duration) lines.push("Duration : " + fmtSec(p.duration));
    if (p.bitrate)  lines.push("Bitrate  : " + fmtBytes(p.bitrate / 8) + "/s  (" + Math.round(p.bitrate / 1000) + " kbps)");
    var srcSize = 0;
    try { if (fso.FileExists(job.inputPath) || job.isSequence) {
      if (!job.isSequence) srcSize = fso.GetFile(job.inputPath).Size;
    } } catch(_) {}
    if (srcSize) lines.push("File size: " + fmtBytes(srcSize));
    lines.push("");
    lines.push("=== FULL FFPROBE JSON ===");
    lines.push(p.rawJson || "(no data)");
    body.innerText = lines.join("\n");
  }

  popIn(ov, document.getElementById("inspect-box"));
}

function closeInspect() {
  var ov = document.getElementById("inspect-overlay");
  popOut(ov, document.getElementById("inspect-box"));
}

// ── FPS hint for image sequences ─────────────────────────
// Return a note string if the selected preset lacks explicit fps for a sequence.
function seqFpsHint(job, preset) {
  if (!job.isSequence) return "";
  if (!preset) return "";
  var ia = preset.inputArgs || "";
  var a  = preset.args || "";
  var hasRate = (/-r\s+\d+|-framerate\s+\d+/i.test(ia) || /-r\s+\d+/i.test(a));
  if (hasRate) return "";
  // Count frames if available
  var frameNote = job.seqCount ? "  (" + job.seqCount + " frames)" : "";
  return "Seq preset has no explicit fps \u2014 will default to 30fps" + frameNote;
}


