// reliable local paths, so a tiny owned WinForms surface receives Windows
// CF_HDROP data from Explorer, Chrome and Firefox and forwards verified paths
// through a private per-session temp folder.
var dropBridgeDir       = "";
var dropBridgeTimer     = null;
var dropBridgeStartedAt = 0;
var dropBridgeReady     = false;
var dropBridgeFailed    = false;
var dropBridgeErrorSeen = false;
var dropBridgeLastGeo   = "";
var dropBridgeLastState = "";
var dropBridgeSuspended = 0;
var dropBridgeErrorText = "";

