function L(key, n, m) {
  var d = LANG[currentLang] || LANG.en;
  var s = (d[key] !== undefined) ? d[key] : (LANG.en[key] !== undefined ? LANG.en[key] : key);
  if (n !== undefined && n !== null) s = s.replace(/\{n\}/g, n);
  if (m !== undefined && m !== null) s = s.replace(/\{m\}/g, m);
  return s;
}

// Apply the active language to all static UI text, then refresh the dynamic bits.
function applyLanguage() {
  function T(id,k){ var e=document.getElementById(id); if(e) e.innerText=L(k); }
  function H(id,h){ var e=document.getElementById(id); if(e) e.innerHTML=h; }
  T("btn-editpresets","editpresets");           H("btn-settings","&#9881; "+L("settings"));
  T("settings-bg-title","sec_bg");               T("settings-title","sec_theme");
  T("settings-scale-title","sec_scale");         T("settings-lang-title","sec_lang");
  T("settings-update-title","sec_updates");
  T("ui-scale-label","zoom");                    T("sp-editbtn","openpresets");
  H("sp-reloadbtn","&#8635; "+L("reload"));
  var sb=document.getElementById("search-box"); if(sb) sb.setAttribute("placeholder", L("filter_ph"));
  H("fav-filter","&#9733; "+L("fav_only"));      H("compat-filter","&#10003; "+L("compat_only"));
  H("btn-reload","&#8635; "+L("reload"));
  H("dz-title","&#8659; "+L("drop_title"));      T("dz-sub","drop_sub");   T("dz-browse","browse_files");
  T("out-label","output_folder");
  if(!outputFolder){ H("out-path","&mdash; "+L("output_default")+" &mdash;"); }
  T("btn-pickout","browse");                     H("btn-resetout","&times; "+L("reset"));
  T("empty-text","empty_text");
  T("btn-game","play_wait");                    T("btn-clear","clear_done");
  H("btn-stop","&#9632; "+L("stop_all"));       H("btn-run","&#9654; "+L("convert"));
  renderLangControls(); renderBgControls(); renderUpdateControls(); updateTally(); renderPresets(); renderJobs();
  dropBridgeUpdateUi();
}
function renderLangControls() {
  var t = getT(), codes = ["en","nl","ja","zh","ko"];
  for (var i=0;i<codes.length;i++){
    var b=document.getElementById("lang-"+codes[i]); if(!b) continue;
    var sel=(codes[i]===currentLang);
    b.style.background="none";
    b.style.borderColor = sel ? t.ac : t.bordHi;
    b.style.color       = sel ? t.ac : t.muted;
  }
}
function chooseLang(code) {
  currentLang = code;
  applyLanguage();
  saveSettings();
}
var probeQueue = [];   // paths queued for probing
var probing    = false; // is a probe bat currently running?

// ══ Visual polish: animated themed background + bouncy popups ══════════════

function hexToRgb(h) {
  h = ("" + h).replace("#", "");
  if (h.length === 3) h = h.charAt(0)+h.charAt(0)+h.charAt(1)+h.charAt(1)+h.charAt(2)+h.charAt(2);
  var n = parseInt(h, 16);
  if (isNaN(n)) return { r: 128, g: 128, b: 128 };
  return { r: (n>>16)&255, g: (n>>8)&255, b: n&255 };
}
// Cross-mode opacity: the standard property plus the IE filter form.
function setOpacity(el, a) {
  if (!el) return;
  if (a < 0) a = 0; if (a > 1) a = 1;
  el.style.opacity = a;
  try { el.style.filter = "alpha(opacity=" + Math.round(a*100) + ")"; } catch(e) {}
}
// easeOutBack: overshoots past 1 then settles — the "bounce".
function easeOutBack(t) {
  var c1 = 1.70158, c3 = c1 + 1;
  return 1 + c3*Math.pow(t-1, 3) + c1*Math.pow(t-1, 2);
}

// ── Animated background ──────────────────────────────────
