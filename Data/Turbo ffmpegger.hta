    bg:"#ffffff", surf:"#ffffff", surf2:"#f2f2f2", bord:"#000000", bordHi:"#000000",
    text:"#000000", muted:"#333333", ac:"#0000cc", acText:"#ffffff",
    ok:"#006622", err:"#cc0000", logBg:"#f2f2f2",
    starOff:"#555555", starOn:"#0000cc"
  },
  hcamber: {
    bg:"#000000", surf:"#080600", surf2:"#100c00", bord:"#705500", bordHi:"#b88a00",
    text:"#ffcc33", muted:"#b88a00", ac:"#ffb000", acText:"#000000",
    ok:"#88ff00", err:"#ff5050", logBg:"#000000",
    starOff:"#705500", starOn:"#ffb000"
  }
};

function applyTheme(name) {
  var t = THEMES[name] || THEMES.amber;
  currentTheme = name;
  bgAnim.setColors(t);

  function s(id, prop, val) {
    var el = document.getElementById(id);
    if (el) el.style[prop] = val;
  }
  function sc(sel, prop, val) {
    // apply to all matching by className — IE compatible loop
    var all = document.getElementsByTagName("*");
    for (var i=0; i<all.length; i++) {
      if ((" "+all[i].className+" ").indexOf(" "+sel+" ")>=0)
        all[i].style[prop] = val;
    }
  }

  // Body
  document.body.style.background = t.bg;
  document.body.style.color = t.text;

  // Header
  s("header","background",t.surf);
  s("header","borderBottomColor",t.bord);
  s("title-ff","color",t.ac);
  s("title-batch","color",t.muted);
  styleBtn("btn-editpresets", t);
  styleBtn("btn-settings", t);

  // Sidebar
  s("sidebar","background",t.surf2);
  s("sidebar","borderRightColor",t.bord);
  s("sidebar-top","borderBottomColor",t.bord);
  s("search-box","background",t.bg);
  s("search-box","borderColor",t.bord);
  s("search-box","color",t.text);
  s("fav-filter","color", showFavsOnly ? t.ac : t.muted);
  s("compat-filter","color", compatOnly ? t.ac : t.muted);
  s("sidebar-footer","borderTopColor",t.bord);
  s("sidebar-footer","background",t.surf2);
  styleBtn("btn-reload", t);

  // Group headers
  sc("group-header","background",t.surf2);
  sc("group-header","color",t.muted);

  // Dropzone
  s("dropzone","borderColor",t.bordHi);
  s("dropzone","background",t.surf2);
  s("dz-sub","color",t.muted);
  styleBtn("dz-browse", t);

  // Output row
  s("out-label","color",t.muted);
  s("out-path","background",t.surf);
  s("out-path","borderColor",t.bord);
  s("out-path","color",t.muted);
  styleBtn("btn-pickout", t);
  styleBtn("btn-resetout", t);

  // Queue empty
  s("empty-text","color",t.muted);

  // Toolbar
  s("toolbar","borderTopColor",t.bord);
  s("toolbar","background",t.surf2);
  s("tally","color",t.muted);
  styleBtn("btn-game", t);
  s("btn-game","borderColor",t.ac);
  s("btn-game","color",t.ac);
  styleBtn("btn-clear", t);
  s("btn-stop","borderColor",t.err);
  s("btn-stop","color",t.err);
  s("btn-run","background",t.ac);
  s("btn-run","borderColor",t.ac);
  s("btn-run","color",t.acText);

  // Settings panel
  s("settings-panel","background",t.surf);
  s("settings-panel","borderColor",t.bord);
  s("settings-bg-title","color",t.muted);
  s("settings-title","color",t.muted);
  s("settings-scale-title","color",t.muted);
  s("settings-lang-title","color",t.muted);
  s("settings-update-title","color",t.muted);
  s("settings-sep0","borderTopColor",t.bord);
  s("settings-sep","borderTopColor",t.bord);
  s("settings-sep2","borderTopColor",t.bord);
  s("settings-sep3","borderTopColor",t.bord);
  s("settings-sep4","borderTopColor",t.bord);
  s("ui-scale-label","color",t.muted);
  // re-apply scale button active state
  var scaleIds=[1,1.5,2];
  for(var sci=0;sci<scaleIds.length;sci++){
    var sbtn=document.getElementById("scale-"+scaleIds[sci]+"x");
    if(!sbtn)continue;
    sbtn.style.borderColor=(scaleIds[sci]===currentScale)?t.ac:t.bord;
    sbtn.style.color=(scaleIds[sci]===currentScale)?t.ac:t.muted;
    sbtn.style.fontWeight=(scaleIds[sci]===currentScale)?"900":"700";
  }
  styleSettingsBtn("sp-editbtn", t);
  styleSettingsBtn("sp-reloadbtn", t);
  styleSettingsBtn("sp-updatebtn", t);
  renderUpdateControls();

  // Swatches — highlight active
  var swIds = ["sw-amber","sw-blue","sw-green","sw-purple","sw-red","sw-light","sw-cyan","sw-rose","sw-slate","sw-sand","sw-mint","sw-midnight","sw-paper","sw-sky","sw-sage","sw-hcdark","sw-hclight","sw-hcamber"];
  var swColors = {
    "sw-amber":    {bg:"#1e1e1e", color:"#e8a020"},
    "sw-blue":     {bg:"#162030", color:"#4a9eff"},
    "sw-green":    {bg:"#162218", color:"#4caf7d"},
    "sw-purple":   {bg:"#1c1729", color:"#a374f7"},
    "sw-red":      {bg:"#251515", color:"#e05454"},
    "sw-light":    {bg:"#ffffff", color:"#c07010"},
    "sw-cyan":     {bg:"#122028", color:"#00c8e0"},
    "sw-rose":     {bg:"#271520", color:"#f06090"},
    "sw-slate":    {bg:"#191e24", color:"#7aa8d0"},
    "sw-sand":     {bg:"#242018", color:"#d4a840"},
    "sw-mint":     {bg:"#152420", color:"#30d4a8"},
    "sw-midnight": {bg:"#0c1018", color:"#5080c0"},
    "sw-paper":    {bg:"#fbf7ee", color:"#b5651d"},
    "sw-sky":      {bg:"#ffffff", color:"#1e7ac0"},
    "sw-sage":     {bg:"#fbfcf9", color:"#4f8a3d"},
    "sw-hcdark":   {bg:"#000000", color:"#ffff00"},
    "sw-hclight":  {bg:"#ffffff", color:"#0000cc"},
    "sw-hcamber":  {bg:"#000000", color:"#ffb000"}
  };
  for (var si=0; si<swIds.length; si++) {
    var swEl = document.getElementById(swIds[si]);
    if (!swEl) continue;
    swEl.style.background   = swColors[swIds[si]].bg;
    swEl.style.color        = swColors[swIds[si]].color;
    swEl.style.borderColor  = (swIds[si] === "sw-"+name) ? t.ac : "#333333";
    swEl.style.borderWidth  = (swIds[si] === "sw-"+name) ? "2px" : "1px";
  }

  // Re-render preset list and jobs so their inline styles update
  renderPresets();
  renderJobs();
  renderBgControls();
  renderLangControls();
  saveSettings();
}

function styleBtn(id, t) {
  var el = document.getElementById(id);
  if (!el) return;
  el.style.borderColor = t.bord;
  el.style.color = t.muted;
}
function styleSettingsBtn(id, t) {
  var el = document.getElementById(id);
  if (!el) return;
  el.style.borderColor = t.bord;
  el.style.color = t.muted;
  el.style.background = "none";
}

function getT() { return THEMES[currentTheme] || THEMES.amber; }

var BASE_W = 980, BASE_H = 700;
var HEADER_H = 42, TOOLBAR_H = 46, SIDEBAR_W = 240, QUEUE_TOP = 174;
var lastClientW = 0, lastClientH = 0;

// Keep the user's selected UI zoom (1x / 1.5x / 2x) as the REAL IE zoom.
// HTA/IE hit-testing is reliable with that normal zoom, but can become offset if
// we replace it with an arbitrary per-monitor zoom value.  When Windows changes
// the client-pixel size while crossing monitors with different DPI, compensate
// only when the selected zoom cannot fit. Larger/maximized windows receive a
// genuinely larger layout instead of a cropped, enlarged 980x700 layout.
function fitAppRootToViewport(force) {
  try {
    var haveW = document.body.clientWidth  || document.documentElement.clientWidth  || 0;
    var haveH = document.body.clientHeight || document.documentElement.clientHeight || 0;
    if (!haveW || !haveH) return;
    if (!force && haveW === lastClientW && haveH === lastClientH) return;
    lastClientW = haveW; lastClientH = haveH;

    var root = document.getElementById("app-root");
    if (!root) return;

    // Use the requested zoom whenever it fits. If the window/monitor is smaller,
    // shrink uniformly just enough to keep every edge reachable. The logical
    // root then expands to fill any remaining width or height, which gives wide
    // full-screen windows real queue space instead of clipping the bottom.
    var effectiveScale = currentScale;
    var fitW = haveW / BASE_W, fitH = haveH / BASE_H;
    if (effectiveScale > fitW) effectiveScale = fitW;
    if (effectiveScale > fitH) effectiveScale = fitH;
    if (effectiveScale < 0.10) effectiveScale = 0.10;

    var layoutW = Math.max(BASE_W, Math.round(haveW / effectiveScale));
    var layoutH = Math.max(BASE_H, Math.round(haveH / effectiveScale));
    var bodyH   = Math.max(1, layoutH - HEADER_H - TOOLBAR_H);
    var mainW   = Math.max(1, layoutW - SIDEBAR_W);
    var queueH  = Math.max(1, bodyH - QUEUE_TOP);

    root.style.zoom = currentScale;
    root.style.width = layoutW + "px";
    root.style.height = layoutH + "px";

    function size(id,w,h) {
      var el = document.getElementById(id);
      if (!el) return;
      if (w !== null) el.style.width = Math.max(1,w) + "px";
      if (h !== null) el.style.height = Math.max(1,h) + "px";
    }
    size("header",         layoutW, null);
    size("toolbar",        layoutW, null);
    size("body-wrap",      layoutW, bodyH);
    size("sidebar",        SIDEBAR_W, bodyH);
    size("main-panel",     mainW, bodyH);
    size("queue-wrap",     mainW, queueH);
    size("editor-overlay", layoutW, layoutH);
    size("inspect-overlay",layoutW, layoutH);
    size("apply-overlay",  layoutW, layoutH);
    size("game-overlay",   layoutW, layoutH);

    var settings = document.getElementById("settings-panel");
    if (settings) settings.style.maxHeight = Math.max(120,layoutH-HEADER_H) + "px";
    bgAnim.resize(layoutW,layoutH);

    // The transform is only the fit/DPI correction; the normal UI zoom remains
    // on root.style.zoom so HTA pointer hit-testing stays aligned.
    var monitorScale = effectiveScale / currentScale;
    var tr = "scale(" + monitorScale + ")";
    root.style.msTransformOrigin = "0 0";
    root.style.transformOrigin = "0 0";
    root.style.msTransform = tr;
    root.style.transform = tr;
  } catch(_) {}
}

function applyScale(n) {
  if (n !== 1.5 && n !== 2) n = 1;   // 1x, 1.5x and 2x supported
  currentScale = n;

  // Set the real IE zoom immediately.  Per-monitor compensation is layered on
  // separately by fitAppRootToViewport(), so hit-testing stays stable.
  var root = document.getElementById("app-root");
  if (root) root.style.zoom = n;

  // The scale buttons intentionally resize the window. This is the ONLY place
  // normal UI operation programmatically changes the outer window size.
  try {
    var CHROME_W = 16, CHROME_H = 39;
    var w = BASE_W * n + CHROME_W, h = BASE_H * n + CHROME_H;
    if (w > screen.availWidth)  w = screen.availWidth;
    if (h > screen.availHeight) h = screen.availHeight;
    window.resizeTo(w, h);
  } catch(_) {}

  // Let Windows finish the resize/DPI negotiation, then lay out whatever client
  // area resulted. No moveTo/resizeTo happens in this path.
  fitAppRootToViewport(true);
  window.setTimeout(function(){ fitAppRootToViewport(true); }, 60);

  // update button styles
  var t = getT();
  var ids = [1,1.5,2];
  for (var i=0; i<ids.length; i++) {
    var btn = document.getElementById("scale-"+ids[i]+"x");
    if (!btn) continue;
    btn.style.borderColor = (ids[i]===n) ? t.ac : t.bord;
    btn.style.color       = (ids[i]===n) ? t.ac : t.muted;
    btn.style.fontWeight  = (ids[i]===n) ? "900" : "700";
  }
  saveSettings();
}

// React immediately to maximize/restore and monitor/DPI client-size changes. A
// lightweight watcher also catches mshta/IE transitions that miss resize events.
window.onresize = function(){ fitAppRootToViewport(false); };
var viewportWatchTimer = window.setInterval(function(){ fitAppRootToViewport(false); }, 120);

// ── Background: enable/disable + pattern selection ───────
function toggleFancy() {
  fancyEnabled = !fancyEnabled;
  bgAnim.setEnabled(fancyEnabled);
  renderBgControls();
  saveSettings();
}
function chooseBgPattern(id) {
  if (!fancyEnabled) return;      // pattern buttons are disabled while off
  bgPattern = id;
  bgAnim.setPattern(id);
  renderBgControls();
  saveSettings();
}
// Colour the toggle + the six pattern buttons for the current theme and state.
function renderBgControls() {
  var t = getT();
  var ft = document.getElementById("fancy-toggle");
  if (ft) {
    ft.innerText = L("fancy") + ": " + (fancyEnabled ? L("on") : L("off"));
    ft.style.background = "none";
    ft.style.borderColor = fancyEnabled ? t.ac : t.bord;
    ft.style.color       = fancyEnabled ? t.ac : t.muted;
  }
  var ids  = ["ambient","constellation","waves","magic","starfield","aurora"];
  var keys = ["pat_ambient","pat_futuristic","pat_waves","pat_magic","pat_starfield","pat_aurora"];
  for (var i = 0; i < ids.length; i++) {
    var b = document.getElementById("pat-" + ids[i]);
    if (!b) continue;
    b.innerText = L(keys[i]);
    var sel = (ids[i] === bgPattern);
    b.disabled = !fancyEnabled;
    b.style.background = "none";
    if (!fancyEnabled) { b.style.borderColor = t.bord; b.style.color = t.bord; }
    else { b.style.borderColor = sel ? t.ac : t.bordHi; b.style.color = sel ? t.ac : t.muted; }
  }
}

// ── Settings panel toggle ───────────────────────────────
// The PowerShell helper performs network and file operations outside this
// running HTA. The UI only starts it and watches a small status file.
function versionPath() { return appFolder() + "\\version.txt"; }
function updaterScriptPath() { return appFolder() + "\\check_for_updates.ps1"; }
function appRootFolder() { return fso.GetParentFolderName(appFolder()); }

function isSafeUpdateTag(tag) {
  return /^v?[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$/.test("" + tag);
}

function loadAppVersion() {
  var resolved = APP_VERSION_FALLBACK;
  try {
    var p = versionPath();
    if (fso.FileExists(p)) {
      var value = readTextFile(p).replace(/^\uFEFF/, "").replace(/^\s+|\s+$/g, "");
      if (isSafeUpdateTag(value)) resolved = value;
    }
  } catch (_) {}
  APP_VERSION = resolved;
  return APP_VERSION;
}

function refreshDisplayedAppVersion() {
  loadAppVersion();
  if (!updateChecking && !updateInstalling) {
    updateStatusKind = "installed";
    updateStatusValue = "";
    updateStatusDetail = "";
  }
  renderUpdateControls();
}

function setUpdateStatus(kind, value, detail) {
  updateStatusKind = kind || "installed";
  updateStatusValue = value || "";
  updateStatusDetail = detail || "";
  renderUpdateControls();
}

function renderUpdateControls() {
  var t = getT();
  var btn = document.getElementById("sp-updatebtn");
  var label = document.getElementById("update-status");
  if (btn) {
    btn.disabled = !!updateChecking;
    btn.innerHTML = "&#8635; " + (updateChecking ? L("checking_updates") : L("check_updates"));
    btn.style.borderColor = t.bord;
    btn.style.color = updateChecking ? t.bordHi : t.muted;
  }
  if (!label) return;
  var version = updateStatusValue || APP_VERSION;
  var message = L("installed_version", APP_VERSION);
  if (updateStatusKind === "checking") message = L("checking_updates");
  else if (updateStatusKind === "current") message = L("up_to_date", version);
  else if (updateStatusKind === "available") message = L("update_available", version);
  else if (updateStatusKind === "installing") message = L("update_starting", version);
  else if (updateStatusKind === "error") {
    message = L("update_failed");
    if (updateStatusDetail) message += " " + updateStatusDetail;
  }
  label.innerText = message;
  label.style.color = (updateStatusKind === "error") ? t.err :
                      (updateStatusKind === "available" || updateStatusKind === "installing") ? t.ac : t.muted;
}

function updateCommandArg(value) {
  value = "" + value;
  if (value.indexOf('"') >= 0) throw new Error("Invalid quote in update path.");
  return '"' + value + '"';
}

function buildUpdaterCommand(action, statusPath, expectedTag, scriptPath) {
  var windowsDir = wsh.ExpandEnvironmentStrings("%SystemRoot%");
  var powershell = windowsDir + "\\System32\\WindowsPowerShell\\v1.0\\powershell.exe";
  var cmd = updateCommandArg(powershell) +
    " -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File " + updateCommandArg(scriptPath || updaterScriptPath()) +
    " -Action " + action +
    " -AppRoot " + updateCommandArg(appRootFolder()) +
    " -CurrentVersion " + updateCommandArg(APP_VERSION) +
    " -StatusPath " + updateCommandArg(statusPath);
  if (expectedTag) cmd += " -ExpectedTag " + updateCommandArg(expectedTag);
  return cmd;
}

function makeUpdateStatusPath() {
  var tempDir = "" + fso.GetSpecialFolder(2);
  var name = "Turbo_ffmpegger_update_" + (new Date()).getTime() + "_" + Math.floor(Math.random() * 100000) + ".txt";
  return fso.BuildPath(tempDir, name);
}

function parseUpdateStatus(raw) {
  var result = {};
  var lines = ("" + raw).replace(/^\uFEFF/, "").replace(/\r/g, "").split("\n");
  for (var i = 0; i < lines.length; i++) {
    var at = lines[i].indexOf("=");
    if (at <= 0) continue;
    var key = lines[i].substring(0, at).replace(/^\s+|\s+$/g, "");
    var value = lines[i].substring(at + 1).replace(/^\s+|\s+$/g, "");
    result[key] = value;
  }
  return result;
}

function stopUpdatePolling() {
  if (updateCheckTimer) {
    window.clearInterval(updateCheckTimer);
    updateCheckTimer = null;
  }
}

function removeUpdateStatusFile() {
  try {
    if (updateStatusPath && fso.FileExists(updateStatusPath)) fso.DeleteFile(updateStatusPath, true);
  } catch (_) {}
}

function checkForUpdates() {
  if (updateChecking) return;
  // version.txt is the single source of truth. Reload it immediately before
  // building the updater command so an edit made while the HTA is open counts.
  loadAppVersion();
  if (!fso.FileExists(updaterScriptPath())) {
    setUpdateStatus("error", "", L("updater_missing"));
    return;
  }
  stopUpdatePolling();
  removeUpdateStatusFile();
  updateStatusPath = makeUpdateStatusPath();
  updateChecking = true;
  updateCheckStarted = (new Date()).getTime();
  setUpdateStatus("checking", "", "");
  try {
    wsh.Run(buildUpdaterCommand("Check", updateStatusPath, "", ""), 0, false);
    updateCheckTimer = window.setInterval(pollUpdateCheck, 250);
  } catch (e) {
    updateChecking = false;
    setUpdateStatus("error", "", e.message || ("" + e));
  }
}

function pollUpdateCheck() {
  if ((new Date()).getTime() - updateCheckStarted > 90000) {
    stopUpdatePolling();
    updateChecking = false;
    removeUpdateStatusFile();
    setUpdateStatus("error", "", L("update_timeout"));
    return;
  }
  if (!updateStatusPath || !fso.FileExists(updateStatusPath)) return;
  var status;
  try { status = parseUpdateStatus(readTextFile(updateStatusPath)); }
  catch (_) { return; }
  if (!status.state || status.state === "checking") return;

  stopUpdatePolling();
  updateChecking = false;
  removeUpdateStatusFile();

  if (status.state === "up-to-date") {
    setUpdateStatus("current", status.version || APP_VERSION, "");
    return;
  }
  if (status.state === "available") {
    var tag = status.version || "";
    if (!isSafeUpdateTag(tag)) {
      setUpdateStatus("error", "", L("update_failed"));
      return;
    }
    setUpdateStatus("available", tag, "");
    if (running || probing) {
      window.alert(L("update_busy"));
      return;
    }
    if (window.confirm(L("update_prompt", tag))) beginUpdateInstall(tag);
    return;
  }
  setUpdateStatus("error", "", status.message || "");
}

function beginUpdateInstall(tag) {
  if (running || probing) {
    window.alert(L("update_busy"));
    return;
  }
  if (!isSafeUpdateTag(tag) || !fso.FileExists(updaterScriptPath())) {
    setUpdateStatus("error", "", L("updater_missing"));
    return;
  }
  removeUpdateStatusFile();
  updateStatusPath = makeUpdateStatusPath();
  updateInstalling = true;
  updateChecking = true;
  setUpdateStatus("installing", tag, "");
  updateRunButton();
  try {
    var tempDir = "" + fso.GetSpecialFolder(2);
    updateWorkerPath = fso.BuildPath(tempDir, "Turbo_ffmpegger_updater_" + (new Date()).getTime() + "_" + Math.floor(Math.random() * 100000) + ".ps1");
    fso.CopyFile(updaterScriptPath(), updateWorkerPath, true);
    wsh.Run(buildUpdaterCommand("Install", updateStatusPath, tag, updateWorkerPath), 0, false);
    window.setTimeout(function () { dropBridgeStop(); window.close(); }, 350);
  } catch (e) {
    try { if (updateWorkerPath && fso.FileExists(updateWorkerPath)) fso.DeleteFile(updateWorkerPath, true); } catch (_) {}
    updateInstalling = false;
    updateChecking = false;
    setUpdateStatus("error", "", e.message || ("" + e));
    updateRunButton();
  }
}

function toggleSettings() {
  var p = document.getElementById("settings-panel");
  if (p.className.indexOf("open") >= 0) {
    p.className = "";
  } else {
    refreshDisplayedAppVersion();
    p.className = "open";
  }
  dropBridgePublishGeometry(true);
}
document.onclick = function(e) {
  var t = e ? e.srcElement : window.event.srcElement;
  var panel = document.getElementById("settings-panel");
  var btn   = document.getElementById("btn-settings");
  if (!panel || panel.className.indexOf("open") < 0) return;
  var el = t;
  while (el) {
    if (el === panel || el === btn) return;
    el = el.parentElement;
  }
  panel.className = "";
  dropBridgePublishGeometry(true);
};

// ── Native drop bridge ────────────────────────────────────
// MSHTML does not consistently expose local paths from Chromium/Firefox
// download-list drags. A tiny owned WinForms surface receives Windows'
// genuine FileDrop payload and queues verified paths for this HTA.
function dropBridgePath(name) {
  return dropBridgeDir ? (dropBridgeDir + "\\" + name) : "";
}

function writeDropBridgeAscii(path, text) {
  var out = fso.CreateTextFile(path, true, false);
  out.Write(text);
  out.Close();
}

function readDropBridgeAscii(path) {
  var input = fso.OpenTextFile(path, 1, false, 0);
  var text = input.AtEndOfStream ? "" : input.ReadAll();
  input.Close();
  return text;
}

function readDropBridgeUnicode(path) {
  var input = fso.OpenTextFile(path, 1, false, -1);
  var text = input.AtEndOfStream ? "" : input.ReadAll();
  input.Close();
  return text;
}

function dropBridgeElementVisible(id) {
  var el = document.getElementById(id);
  if (!el) return false;
  try {
    var display = el.currentStyle ? el.currentStyle.display : el.style.display;
    return display !== "none";
  } catch(_) { return false; }
}

function dropBridgeUiClear() {
  if (dropBridgeSuspended > 0) return false;
  var settings = document.getElementById("settings-panel");
  if (settings && settings.className.indexOf("open") >= 0) return false;
  if (dropBridgeElementVisible("editor-overlay")) return false;
  if (dropBridgeElementVisible("inspect-overlay")) return false;
  if (dropBridgeElementVisible("apply-overlay")) return false;
  if (dropBridgeElementVisible("game-overlay")) return false;
  return true;
}

function dropBridgeSetHover(on) {
  try {
    var t = getT();
    var dz = document.getElementById("dropzone");
    if (!dz) return;
    dz.style.borderColor = on ? t.ac : t.bordHi;
    dz.style.background  = on ? t.surf : t.surf2;
  } catch(_) {}
}

function dropBridgeUpdateUi() {
  var sub = document.getElementById("dz-sub");
  if (!sub) return;
  if (dropBridgeFailed) {
    sub.innerText = "Drag helper unavailable \u2014 Browse still works";
    sub.title = dropBridgeErrorText || "The local drag helper could not start.";
  } else {
    sub.innerText = L("drop_sub");
    sub.title = "";
  }
}

function dropBridgePublishGeometry(force) {
  if (!dropBridgeDir) return;
  try {
    var dz = document.getElementById("dropzone");
    if (!dz) return;
    var browse = document.getElementById("dz-browse");
    var dr = dz.getBoundingClientRect();
    var br = browse ? browse.getBoundingClientRect() : null;
    var de = document.documentElement, body = document.body;
    var vw = (de && de.clientWidth) || (body && body.clientWidth) || 1;
    var vh = (de && de.clientHeight) || (body && body.clientHeight) || 1;
    var clientLeft = (de && de.clientLeft) || (body && body.clientLeft) || 0;
    var clientTop  = (de && de.clientTop)  || (body && body.clientTop)  || 0;
    var left = Math.round(dr.left - clientLeft);
    var top = Math.round(dr.top - clientTop);
    var width = Math.max(1, Math.round(dr.right - dr.left));
    var height = Math.max(1, Math.round(dr.bottom - dr.top));
    var holeX = br ? Math.round(br.left - dr.left) : 0;
    var holeY = br ? Math.round(br.top - dr.top) : 0;
    var holeWidth = br ? Math.max(0, Math.round(br.right - br.left)) : 0;
    var holeHeight = br ? Math.max(0, Math.round(br.bottom - br.top)) : 0;
    var enabled = (dropBridgeReady && !dropBridgeFailed && dropBridgeUiClear()) ? 1 : 0;
    var geo = [enabled,left,top,width,height,holeX,holeY,holeWidth,holeHeight,Math.round(vw),Math.round(vh)].join("|");
    if (force || geo !== dropBridgeLastGeo) {
      writeDropBridgeAscii(dropBridgePath("geometry.txt"), geo);
      dropBridgeLastGeo = geo;
    }
    if (!enabled) dropBridgeSetHover(false);
  } catch(_) {}
}

function dropBridgeConsumeDrops() {
  if (!dropBridgeDir || !fso.FolderExists(dropBridgeDir)) return;
  var queue = [];
  try {
    var files = new Enumerator(fso.GetFolder(dropBridgeDir).Files);
    for (; !files.atEnd(); files.moveNext()) {
      var item = files.item();
      if (/\.drop$/i.test("" + item.Name)) queue.push("" + item.Path);
    }
  } catch(_) { return; }
  queue.sort();

  var added = 0;
  for (var i=0; i<queue.length; i++) {
    var readOk = false;
    try {
      var raw = readDropBridgeUnicode(queue[i]);
      readOk = true;
      var lines = raw.replace(/\r/g, "").split("\n");
      for (var j=0; j<lines.length; j++) {
        var path = lines[j].replace(/^\s+|\s+$/g, "");
        if (!path) continue;
        try {
          if (fso.FileExists(path)) {
            path = fso.GetAbsolutePathName(path);
            if (addInputFile(path)) added++;
          }
        } catch(_) {}
      }
    } catch(_) {}
    if (readOk) { try { fso.DeleteFile(queue[i], true); } catch(_) {} }
  }
  if (added > 0) { renderJobs(); updateRunButton(); renderPresets(); }
}

function dropBridgeReadStatus() {
  if (!dropBridgeDir) return;
  try {
    if (!dropBridgeReady && fso.FileExists(dropBridgePath("ready.txt"))) {
      dropBridgeReady = true;
      dropBridgeFailed = false;
      dropBridgeUpdateUi();
    }
  } catch(_) {}

  try {
    var statePath = dropBridgePath("state.txt");
    if (fso.FileExists(statePath)) {
      var state = readDropBridgeAscii(statePath).replace(/^\s+|\s+$/g, "").toLowerCase();
      if (state !== dropBridgeLastState) {
        dropBridgeLastState = state;
        dropBridgeSetHover(state === "hover");
      }
    }
  } catch(_) {}

  try {
    var errorPath = dropBridgePath("error.txt");
    if (!dropBridgeErrorSeen && fso.FileExists(errorPath)) {
      var bridgeError = readDropBridgeUnicode(errorPath).replace(/^\s+|\s+$/g, "");
      dropBridgeErrorSeen = true;
      dropBridgeErrorText = bridgeError;
      dropBridgeFailed = true;
      dropBridgeSetHover(false);
      dropBridgeUpdateUi();
    }
  } catch(_) {}

  if (!dropBridgeReady && !dropBridgeFailed && dropBridgeStartedAt &&
      ((new Date()).getTime() - dropBridgeStartedAt > 12000)) {
    dropBridgeFailed = true;
    dropBridgeErrorText = "The local drag helper did not become ready in time.";
    dropBridgeUpdateUi();
  }
}

function dropBridgeTick() {
  dropBridgeReadStatus();
  dropBridgeConsumeDrops();
  dropBridgePublishGeometry(false);
}

function dropBridgeSuspend(on) {
  if (on) dropBridgeSuspended++;
  else if (dropBridgeSuspended > 0) dropBridgeSuspended--;
  dropBridgePublishGeometry(true);
}

function dropBridgeStart() {
  if (dropBridgeTimer || dropBridgeDir) return;
  try {
    var helper = appFolder() + "\\drop_receiver.ps1";
    if (!fso.FileExists(helper)) throw new Error("Missing Data\\drop_receiver.ps1");
    var temp = wsh.ExpandEnvironmentStrings("%TEMP%");
    var leaf = "TurboFfmpeggerDrop_" + (new Date()).getTime() + "_" + Math.floor(Math.random()*1000000000);
    dropBridgeDir = temp + "\\" + leaf;
    fso.CreateFolder(dropBridgeDir);
    dropBridgeStartedAt = (new Date()).getTime();

    var psExe = wsh.ExpandEnvironmentStrings("%SystemRoot%") + "\\System32\\WindowsPowerShell\\v1.0\\powershell.exe";
    if (!fso.FileExists(psExe)) psExe = "powershell.exe";
    var cmd = '"' + psExe + '" -NoLogo -NoProfile -NonInteractive -STA -ExecutionPolicy Bypass -WindowStyle Hidden -File "' + helper + '" -SessionDir "' + dropBridgeDir + '"';
    wsh.Run(cmd, 0, false);
    dropBridgeTimer = window.setInterval(dropBridgeTick, 150);
    dropBridgeTick();
  } catch(e) {
    dropBridgeFailed = true;
    dropBridgeErrorText = e.message || ("" + e);
    dropBridgeUpdateUi();
    // If launch itself failed, no helper exists to remove the empty private
    // session directory.
    try {
      if (dropBridgeDir && fso.FolderExists(dropBridgeDir)) fso.DeleteFolder(dropBridgeDir, true);
    } catch(_) {}
    dropBridgeDir = "";
  }
}

function dropBridgeStop() {
  if (dropBridgeTimer) {
    window.clearInterval(dropBridgeTimer);
    dropBridgeTimer = null;
  }
  try {
    if (dropBridgeDir && fso.FolderExists(dropBridgeDir)) {
      writeDropBridgeAscii(dropBridgePath("stop.txt"), "stop");
    }
  } catch(_) {}
}

window.onbeforeunload = function() { if (waitingGame) waitingGame.destroy(); stopUpdatePolling(); dropBridgeStop(); };
window.onunload = function() { if (waitingGame) waitingGame.destroy(); dropBridgeStop(); };

// ── Boot ───────────────────────────────────────────────
window.onload = function() {
  // Keep the window wherever Windows/the user places it; do not force it onto
  // the primary monitor during startup.
  loadAppVersion();
  loadSettings();   // applies saved scale, which sizes the window
  loadPresets();
  bgAnim.setPattern(bgPattern);
  bgAnim.setEnabled(fancyEnabled);
  bgAnim.start();
  applyLanguage();
  fitAppRootToViewport(true);
  window.setTimeout(function(){ fitAppRootToViewport(true); }, 80);
  window.setTimeout(function(){ fitAppRootToViewport(true); }, 300);
  dropBridgeStart();
};

function appFolder() {
  var cl = window.location.href;
  cl = cl.replace(/^file:\/\/\//, "").replace(/\//g, "\\");
  cl = decodeURIComponent(cl);
  return fso.GetParentFolderName(cl);
}
function settingsPath() { return appFolder() + "\\settings.json"; }

// ── Persistence ─────────────────────────────────────────
// Read a UTF-8/ASCII text file from local disk.
//
// Previously the presets/settings/custom-template files were read with
// Microsoft.XMLHTTP over file:// URLs. That works on a local copy, but a copy
// downloaded from the internet carries the "Mark of the Web", which makes mshta
// run the HTA in the Internet security zone -- and from that zone a file:// read
// is a blocked cross-zone access, so it fails with "Permission denied" unless
// the user manually unblocks the files (right-click > Properties > Unblock).
//
// ADODB.Stream reads the bytes straight off disk (no URL, no zone check), so it
// keeps working on downloaded copies. We try it first, then fall back to the
// original XMLHTTP read (so anything that worked before still works), then to
// the FileSystemObject as a last resort. The helper throws only if all three
// fail, so each caller's existing try/catch behaves exactly as before.
// Windows-1252 chars in the 0x80–0x9F range mapped back to their byte value.
// (0x00–0x7F and 0xA0–0xFF already equal their byte in CP1252.) Used to undo a
// UTF-8-read-as-ANSI when the tier-3 fallback below has to run.
var CP1252_REV = {
  0x20AC:0x80,0x201A:0x82,0x0192:0x83,0x201E:0x84,0x2026:0x85,0x2020:0x86,
  0x2021:0x87,0x02C6:0x88,0x2030:0x89,0x0160:0x8A,0x2039:0x8B,0x0152:0x8C,
  0x017D:0x8E,0x2018:0x91,0x2019:0x92,0x201C:0x93,0x201D:0x94,0x2022:0x95,
  0x2013:0x96,0x2014:0x97,0x02DC:0x98,0x2122:0x99,0x0161:0x9A,0x203A:0x9B,
  0x0153:0x9C,0x017E:0x9E,0x0178:0x9F
};

// When ADODB.Stream and XMLHTTP are both blocked (e.g. a freshly downloaded
// .hta still carrying the Mark-of-the-Web), readTextFile falls back to the FSO
// reader, which decodes bytes through the system codepage. A UTF-8 file then
// arrives with every multibyte character split into Windows-1252 chars — e.g.
// "→" (E2 86 92) shows up as "â†’". This re-reads that string as the UTF-8
// bytes it really was. Pure-ASCII text passes through unchanged, so it is only
// ever applied on the fallback path where we KNOW the bytes came in as ANSI.
function repairUtf8FromAnsi(s) {
  if (!s) return s;
  var bytes = [], i, c;
  for (i = 0; i < s.length; i++) {
    c = s.charCodeAt(i);
    if (c <= 0xFF) bytes.push(c);
    else if (CP1252_REV[c] !== undefined) bytes.push(CP1252_REV[c]);
    else if (c < 0x800) { bytes.push(0xC0|(c>>6)); bytes.push(0x80|(c&0x3F)); }
    else { bytes.push(0xE0|(c>>12)); bytes.push(0x80|((c>>6)&0x3F)); bytes.push(0x80|(c&0x3F)); }
  }
  var out = "", j = 0, n = bytes.length, b0;
  while (j < n) {
    b0 = bytes[j];
    if (b0 < 0x80) { out += String.fromCharCode(b0); j += 1; }
    else if ((b0&0xE0)===0xC0 && j+1<n && (bytes[j+1]&0xC0)===0x80) {
      out += String.fromCharCode(((b0&0x1F)<<6)|(bytes[j+1]&0x3F)); j += 2;
    }
    else if ((b0&0xF0)===0xE0 && j+2<n && (bytes[j+1]&0xC0)===0x80 && (bytes[j+2]&0xC0)===0x80) {
      out += String.fromCharCode(((b0&0x0F)<<12)|((bytes[j+1]&0x3F)<<6)|(bytes[j+2]&0x3F)); j += 3;
    }
    else if ((b0&0xF8)===0xF0 && j+3<n && (bytes[j+1]&0xC0)===0x80 && (bytes[j+2]&0xC0)===0x80 && (bytes[j+3]&0xC0)===0x80) {
      var cp = ((b0&0x07)<<18)|((bytes[j+1]&0x3F)<<12)|((bytes[j+2]&0x3F)<<6)|(bytes[j+3]&0x3F);
      cp -= 0x10000;
      out += String.fromCharCode(0xD800|(cp>>10), 0xDC00|(cp&0x3FF)); j += 4;
    }
    else { out += String.fromCharCode(b0); j += 1; }   // invalid/truncated — keep byte
  }
  return out;
}

// Write UTF-8, mirroring readTextFile's tiers: ADODB.Stream first (real UTF-8
// bytes, survives the MOTW zone block), FSO as a last resort. Keeps preset
// names / descriptions with arrows and "×" round-tripping correctly on save.
function writeTextFile(path, text) {
  try {
    var st = new ActiveXObject("ADODB.Stream");
    st.Type = 2;              // adTypeText
    st.Charset = "utf-8";
    st.Open();
    st.WriteText(text);
    st.SaveToFile(path, 2);   // adSaveCreateOverWrite
    st.Close();
    return true;
  } catch(e1) { /* fall back to FSO (system codepage) */ }
  var f = fso.CreateTextFile(path, true, false);
  f.Write(text); f.Close();
  return true;
}

function readTextFile(path) {
  var lastErr = null;
  // 1) ADODB.Stream as UTF-8 -- unaffected by the Mark-of-the-Web zone block.
  try {
    var st = new ActiveXObject("ADODB.Stream");
    st.Type = 2;              // adTypeText
    st.Charset = "utf-8";
    st.Open();
    st.LoadFromFile(path);
    var t1 = st.ReadText(-1); // adReadAll
    st.Close();
    return t1;
  } catch(e1) { lastErr = e1; }
  // 2) Original Microsoft.XMLHTTP read (unchanged behaviour, also UTF-8).
  try {
    var xhr = new ActiveXObject("Microsoft.XMLHTTP");
    xhr.open("GET", "file:///" + path.replace(/\\/g, "/"), false);
    xhr.send();
    return xhr.responseText;
  } catch(e2) { lastErr = e2; }
  // 3) Last resort: FileSystemObject. This reads through the system codepage,
  //    so a UTF-8 file comes back mangled — repairUtf8FromAnsi undoes that.
  try {
    var f = fso.OpenTextFile(path, 1, false);
    var t3 = f.AtEndOfStream ? "" : f.ReadAll();
    f.Close();
    return repairUtf8FromAnsi(t3);
  } catch(e3) { lastErr = e3; }
  throw lastErr;
}

function loadSettings() {
  try {
    var p = settingsPath();
    if (!fso.FileExists(p)) { applyTheme("amber"); applyScale(1); return; }
    var raw = readTextFile(p).replace(/^\uFEFF/,"");
    var s = (new Function("return " + raw))();
    if (s.favourites) favourites = s.favourites;
    if (s.scale) currentScale = s.scale;
    if (typeof s.fancy !== "undefined") fancyEnabled = !!s.fancy;
    if (s.pattern) bgPattern = (s.pattern === "bokeh") ? "magic" : s.pattern;
    if (s.lang) currentLang = s.lang;
    applyTheme(s.theme || "amber");
    applyScale(currentScale);
  } catch(e) { applyTheme("amber"); applyScale(1); }
}

function saveSettings() {
  try {
    var fkeys = [];
    for (var k in favourites) { if (favourites[k]) fkeys.push('"'+k+'":true'); }
    var json = '{"theme":"'+currentTheme+'","scale":'+currentScale+',"lang":"'+currentLang+'","fancy":'+(fancyEnabled?"true":"false")+',"pattern":"'+bgPattern+'","favourites":{'+fkeys.join(",")+'}}';
    writeTextFile(settingsPath(), json);
  } catch(e) {}
}

// ── Presets ─────────────────────────────────────────────
// ── Preset compatibility ────────────────────────────────
// Derive which input extensions a preset is meant for. Audio/Special/Custom
// presets are universal (work on any input); format-named groups map to that
// input extension.
function presetInputExts(p) {
  if (p.inputExts && p.inputExts.length) return p.inputExts;
  var g = ("" + (p.group || "")).toLowerCase();
  if (g === "audio" || g === "special" || g === "custom" || g === "other" || g === "") return ["*"];
  return [g];
}
function presetMatchesInputs(p, extSet) {
  var ie = presetInputExts(p);
  for (var i = 0; i < ie.length; i++) {
    if (ie[i] === "*") return true;
    if (extSet[ie[i]]) return true;
  }
  return false;
}
function queueInputExtSet() {
  var set = {}, any = false;
  for (var i = 0; i < jobs.length; i++) {
    if (jobs[i].isSequence) { set[jobs[i].ext || "png"] = 1; any = true; continue; }
    var nm = jobs[i].filename || "";
    var dot = nm.lastIndexOf(".");
    if (dot >= 0) { set[nm.substring(dot + 1).toLowerCase()] = 1; any = true; }
  }
  set.__any = any;
  return set;
}

// ── ffmpeg args <-> editable fields ─────────────────────
// Parse a preset's args string into the basic fields the editor exposes.
function parseArgs(args) {
  args = args || "";
  var f = { crf: "", speed: "", scale: "", abr: "", vcodec: "", acodec: "", extra: "" };
  var consumed = {};
  var m;
  if ((m = args.match(/-crf\s+(\d+)/)))            { f.crf = m[1];   consumed[m[0]] = 1; }
  if ((m = args.match(/-preset\s+(\w+)/)))         { f.speed = m[1]; consumed[m[0]] = 1; }
  if ((m = args.match(/-vf\s+scale=([\d\-]+:[\d\-]+)/))) { f.scale = m[1]; consumed[m[0]] = 1; }
  if ((m = args.match(/-b:a\s+(\w+)/)))            { f.abr = m[1];   consumed[m[0]] = 1; }
  if ((m = args.match(/-c:v\s+([\w\-]+)/)))            { f.vcodec = m[1];consumed[m[0]] = 1; }
  if ((m = args.match(/-c:a\s+([\w\-]+)/)))            { f.acodec = m[1];consumed[m[0]] = 1; }
  // whatever is left becomes the "extra args" field
  var extra = args;
  for (var k in consumed) { extra = extra.split(k).join(" "); }
  f.extra = extra.replace(/\s+/g, " ").replace(/^\s+|\s+$/g, "");
  return f;
}
// Build an args string back from the editable fields.
function buildArgs(f) {
  var parts = [];
  if (f.vcodec) parts.push("-c:v " + f.vcodec);
  if (f.speed)  parts.push("-preset " + f.speed);
  if (f.crf !== "" && f.crf != null) parts.push("-crf " + f.crf);
  if (f.acodec) parts.push("-c:a " + f.acodec);
  if (f.abr)    parts.push("-b:a " + f.abr);
  if (f.scale)  parts.push("-vf scale=" + f.scale);
  if (f.extra)  parts.push(f.extra);
  return parts.join(" ").replace(/\s+/g, " ").replace(/^\s+|\s+$/g, "");
}

// ── Custom presets persistence ──────────────────────────
function customPath() { return appFolder() + "\\custom_presets.json"; }
function loadCustomPresets() {
  customPresets = [];
  try {
    var p = customPath();
    if (!fso.FileExists(p)) return;
    var raw = readTextFile(p).replace(/^\uFEFF/, "");
    if (!raw.replace(/\s/g, "")) return;
    var arr = (new Function("return " + raw))();
    if (arr && arr.length) {
      for (var i = 0; i < arr.length; i++) { arr[i].group = "Custom"; customPresets.push(arr[i]); }
    }
  } catch(e) {}
}
function saveCustomPresets() {
  try {
    var items = [];
    for (var i = 0; i < customPresets.length; i++) {
      var c = customPresets[i];
      var ie = c.inputExts && c.inputExts.length ? '["' + c.inputExts.join('","') + '"]' : '["*"]';
      items.push('{"id":' + jsonStr(c.id) + ',"name":' + jsonStr(c.name)
        + ',"group":"Custom","description":' + jsonStr(c.description)
        + ',"outputExt":' + jsonStr(c.outputExt) + ',"inputExts":' + ie
        + ',"inputArgs":' + jsonStr(c.inputArgs || "")
        + (c.flatten ? (',"flatten":' + jsonStr(c.flatten)) : "")
        + ',"args":' + jsonStr(c.args) + '}');
    }
    var json = items.length ? "[\n  " + items.join(",\n  ") + "\n]" : "[]";
    writeTextFile(customPath(), json);
  } catch(e) { alert("Could not save custom templates:\n" + e.message); }
}
function jsonStr(s) {
  s = "" + (s == null ? "" : s);
  s = s.replace(/\\/g, "\\\\").replace(/"/g, '\\"').replace(/\r/g, "").replace(/\n/g, " ");
  // Escape every non-ASCII char (→ × ° accents …) and any stray control char as
  // \uXXXX. custom_presets.json is written through an ANSI TextStream, which
  // throws "Invalid procedure call or argument" the moment it's handed a
  // character with no ANSI mapping (the → in every built-in preset name is the
  // usual culprit). Keeping the file pure ASCII sidesteps that entirely, and the
  // loader's eval restores the original characters on read.
  s = s.replace(/[\u0000-\u001f\u0080-\uffff]/g, function (ch) {
    return "\\u" + ("0000" + ch.charCodeAt(0).toString(16)).slice(-4);
  });
  return '"' + s + '"';
}
function allPresets() {
  var all = [];
  for (var i = 0; i < presets.length; i++) all.push(presets[i]);
  for (var j = 0; j < customPresets.length; j++) all.push(customPresets[j]);
  return all;
}
function findPreset(id) {
  var all = allPresets();
  for (var i = 0; i < all.length; i++) if (all[i].id === id) return all[i];
  return null;
}
function newId() {
  return "custom-" + (new Date()).getTime() + "-" + Math.floor(Math.random() * 1000);
}

function loadPresets() {
  var path = appFolder() + "\\presets.json";
  try {
    var raw = readTextFile(path).replace(/^\uFEFF/,"").replace(/\/\/[^\n]*/g,"");
    presets = (new Function("return " + raw))();
  } catch(e) {
    presets = [];
    alert("Could not load presets.json:\n" + e.message + "\n\nPath: " + path);
  }
  loadCustomPresets();
  renderPresets();
  if (!selectedPreset) {
    var all = allPresets();
    if (all.length) selectPreset(all[0]);
  }
}

function reloadPresets() {
  var panel = document.getElementById("settings-panel");
  panel.className = "";
  loadPresets();
}
function editPresets() { wsh.Run('notepad.exe "' + appFolder() + '\\presets.json"'); }

function filterPresets() {
  searchTerm = document.getElementById("search-box").value.toLowerCase();
  renderPresets();
}
function toggleFavFilter() {
  showFavsOnly = !showFavsOnly;
  var t = getT();
  document.getElementById("fav-filter").style.color = showFavsOnly ? t.ac : t.muted;
  renderPresets();
}
function toggleFav(id) {
  favourites[id] = !favourites[id];
  saveSettings(); renderPresets();
}

function renderPresets() {
  var t = getT();
  var extSet = queueInputExtSet();
  var doCompat = compatOnly && extSet.__any;   // only filter when we have files
  var src = allPresets();
  var groups = {}; var order = [];
  for (var i = 0; i < src.length; i++) {
    var p = src[i];
    if (searchTerm && p.name.toLowerCase().indexOf(searchTerm) < 0
        && (""+(p.description||"")).toLowerCase().indexOf(searchTerm) < 0
        && (""+(p.group||"")).toLowerCase().indexOf(searchTerm) < 0) continue;
    if (showFavsOnly && !favourites[p.id]) continue;
    if (doCompat && p.group !== "Custom" && !presetMatchesInputs(p, extSet)) continue;
    var g = p.group || "Other";
    if (!groups[g]) { groups[g] = []; order.push(g); }
    groups[g].push(p);
  }
  // Always show the Custom group last, even when empty, so the "+ new" button
  // is reachable.
  if (order.indexOf("Custom") < 0) order.push("Custom");
  if (!groups["Custom"]) groups["Custom"] = [];

  var html = "";
  for (var gi = 0; gi < order.length; gi++) {
    var gname = order[gi];
    var gp = groups[gname];
    // skip empty non-custom groups produced by filtering
    if (gname !== "Custom" && (!gp || !gp.length)) continue;
    html += '<div class="group-header" style="background:'+t.surf2+';color:'+t.muted+'">'+esc(gname==="Custom"?L("grp_custom"):gname)+'</div>';
    for (var pi = 0; pi < gp.length; pi++) {
      var p = gp[pi];
      var isActive = selectedPreset && selectedPreset.id === p.id;
      var isFav    = !!favourites[p.id];
      var isCustom = (p.group === "Custom");
      var itemBg   = isActive ? t.surf : "transparent";
      var leftBord = isActive ? t.ac : "transparent";
      var nameCol  = isActive ? t.ac : t.text;
      // Match badge: shown when probe data suggests this preset fits the queued files
      var matchBadge = "";
      if (probeMatchScores[p.id]) {
        matchBadge = '<span class="preset-match" style="background:'+t.ac+';color:'+t.acText+'">match</span>';
      }
      html += '<div class="preset-item" onclick="selectPresetById(\''+p.id+'\')" style="background:'+itemBg+';border-left-color:'+leftBord+'">'
            + '<div class="pi-left">'
            + '<div class="preset-name" style="color:'+nameCol+'">'+esc(p.name)+matchBadge+'</div>'
            + '<div class="preset-desc" style="color:'+t.muted+'">'+esc(p.description)+'</div>'
            + '</div>'
            + '<div class="pi-right">'
            + '<button class="row-btn" title="Edit / duplicate" onclick="event.cancelBubble=true;openEditor(\''+p.id+'\')" style="color:'+t.muted+'">&#9998;</button>'
            + (isCustom
                ? '<button class="row-btn" title="Delete template" onclick="event.cancelBubble=true;deleteCustom(\''+p.id+'\')" style="color:'+t.err+'">&times;</button>'
                : '')
            + '<button class="star-btn" title="'+(isFav?"Remove from":"Add to")+' favourites" onclick="event.cancelBubble=true;toggleFav(\''+p.id+'\')" style="color:'+(isFav?t.starOn:t.starOff)+'">'
            + (isFav?"&#9733;":"&#9734;")
            + '</button>'
            + '</div>'
            + '</div>';
    }
    if (gname === "Custom") {
      html += '<div class="new-tpl-row"><button id="btn-newtpl" onclick="openEditor(null)" style="border-color:'+t.bord+';color:'+t.ac+';background:'+t.surf2+'">'+L("new_custom")+'</button></div>';
    }
  }
  if (!html) html = '<div style="padding:16px;font-size:11px;color:'+t.muted+';text-align:center;">No presets match</div>';
  document.getElementById("preset-list").innerHTML = html;
}

function selectPresetById(id) {
  var p = findPreset(id);
  if (p) applyPresetSelection(p);
}

// Clicking a preset in the list always sets it as the active preset (the
// highlight + what NEW imports inherit). What it does to EXISTING pending jobs
// depends on how many are queued:
//   0 pending  -> nothing to repaint; the default is set for the next import
//   1 pending  -> apply immediately, no prompt
//   >1 pending -> ask: all pending, or only the selected ones
function applyPresetSelection(p) {
  selectedPreset = p;
  renderPresets();
  updateRunButton();

  var pend = [];
  for (var i=0;i<jobs.length;i++) { if(jobs[i].status==="pending") pend.push(jobs[i]); }

  if (pend.length === 0) return;                 // default set for next import
  if (pend.length === 1) {                        // single job -> instant
    pend[0].preset = p;
    renderJobs(); updateTally();
    return;
  }
  // More than one pending -> confirm the scope.
  var sel = [];
  for (var j=0;j<pend.length;j++) { if(pend[j].selected) sel.push(pend[j]); }
  showApplyPresetModal(p, pend, sel);
}

function applyPresetToJobs(p, list) {
  for (var i=0;i<list.length;i++) { list[i].preset = p; }
  renderJobs(); updateTally();
}

// Per-job selection toggle (drives the "only selected" apply scope). Only
// pending jobs are re-assignable, so only they carry a checkbox.
function toggleJobSelected(id) {
  for (var i=0;i<jobs.length;i++) {
    if (jobs[i].id===id) {
      if (jobs[i].status!=="pending") return;
      jobs[i].selected = !jobs[i].selected;
      renderJobs();
      return;
    }
  }
}

// ── Apply-preset scope modal ────────────────────────────
var pendingApply = null;   // {preset, all:[...], sel:[...]}

function showApplyPresetModal(preset, pendingList, selectedList) {
  pendingApply = { preset: preset, all: pendingList, sel: selectedList };
  var t = getT();
  var ov  = document.getElementById("apply-overlay");
  var box = document.getElementById("apply-box");
  if (!ov) { // safety: no modal in DOM -> fall back to applying to all
    applyPresetToJobs(preset, pendingList); pendingApply=null; return;
  }
  var nAll = pendingList.length, nSel = selectedList.length;

  box.style.background  = t.surf;
  box.style.borderColor = t.bordHi;
  box.style.color       = t.text;

  var title = document.getElementById("apply-title");
  title.style.color = t.ac;
  title.innerText = L("apply_title");

  var body = document.getElementById("apply-body");
  body.style.color = t.muted;
  body.innerHTML =
      '<b style="color:'+t.text+'">'+esc(preset.name)+'</b><br>'
    + L("apply_q", nAll, '<b style="color:'+t.text+'">'+nSel+'</b>')
    + (nSel===0 ? '<br><span style="color:'+t.err+'">'+L("apply_none")+'</span>' : '');

  var bAll = document.getElementById("apply-all");
  bAll.style.borderColor = t.ac; bAll.style.color = t.ac; bAll.style.background="none";
  bAll.innerHTML = L("apply_all", nAll);

  var bSel = document.getElementById("apply-selected");
  bSel.innerHTML = L("apply_selected", nSel);
  if (nSel === 0) {
    bSel.disabled = true;
    bSel.style.borderColor = t.bord; bSel.style.color = t.bord; bSel.style.background="none";
  } else {
    bSel.disabled = false;
    bSel.style.borderColor = t.ac; bSel.style.color = t.ac; bSel.style.background="none";
  }

  var bCancel = document.getElementById("apply-cancel");
  bCancel.innerText = L("cancel");
  bCancel.style.borderColor = t.bord; bCancel.style.color = t.muted; bCancel.style.background="none";

  popIn(ov, box);
}
function closeApplyModal() {
  var ov = document.getElementById("apply-overlay");
  var box = document.getElementById("apply-box");
  popOut(ov, box);
  pendingApply = null;
}
function confirmApplyAll() {
  if (pendingApply) applyPresetToJobs(pendingApply.preset, pendingApply.all);
  closeApplyModal();
}
function confirmApplySelected() {
  if (pendingApply && pendingApply.sel.length) applyPresetToJobs(pendingApply.preset, pendingApply.sel);
  closeApplyModal();
}

function deleteCustom(id) {
  for (var i = 0; i < customPresets.length; i++) {
    if (customPresets[i].id === id) {
      customPresets.splice(i, 1);
      saveCustomPresets();
      if (selectedPreset && selectedPreset.id === id) {
        var all = allPresets();
        selectedPreset = all.length ? all[0] : null;
      }
      renderPresets(); updateRunButton();
      return;
    }
  }
}

function toggleCompatFilter() {
  compatOnly = !compatOnly;
  var t = getT();
  var el = document.getElementById("compat-filter");
  if (el) el.style.color = compatOnly ? t.ac : t.muted;
  renderPresets();
}

// ── Template editor ─────────────────────────────────────
function openEditor(id) {
  var t = getT();
  editingId = id;            // null = brand-new from scratch
  var base = id ? findPreset(id) : null;
  var f = parseArgs(base ? base.args : "-c:v libx264 -preset medium -crf 20 -c:a aac -b:a 128k");
  var name = base ? (base.name + " (copy)") : "My custom template";
  var outExt = base ? (base.outputExt || "mp4") : "mp4";
  var inExts = base ? presetInputExts(base) : ["*"];
  var inSel = (inExts.length === 1 && inExts[0] === "*") ? "*" : inExts[0];
  var inArgs = base && base.inputArgs ? base.inputArgs : "";
  // FPS is exposed as its own field. Pull any "-r N" out of the input args so
  // it prefills the FPS box; the remainder stays in the input-args field.
  var fps = "";
  var fpsM = inArgs.match(/(^|\s)-r\s+([\d.]+)/);
  if (fpsM) { fps = fpsM[2]; inArgs = inArgs.replace(fpsM[0], " ").replace(/\s+/g, " ").replace(/^\s+|\s+$/g, ""); }

  function opt(v, label, sel) { return '<option value="'+v+'"'+(sel===v?' selected':'')+'>'+label+'</option>'; }

  var inputOpts = opt("*",L("ed_anyfmt"), inSel) + opt("mp4","MP4", inSel) + opt("mov","MOV", inSel)
    + opt("mkv","MKV", inSel) + opt("avi","AVI", inSel) + opt("wmv","WMV", inSel) + opt("mxf","MXF", inSel)
    + opt("webm","WEBM", inSel) + opt("flv","FLV", inSel);
  var outOpts = opt("mp4","MP4", outExt) + opt("mov","MOV", outExt) + opt("mkv","MKV", outExt)
    + opt("avi","AVI", outExt) + opt("wmv","WMV", outExt) + opt("webm","WEBM", outExt)
    + opt("gif","GIF", outExt) + opt("mp3","MP3 (audio)", outExt) + opt("m4a","M4A (audio)", outExt);
  var vcOpts = opt("","(auto/keep)", f.vcodec) + opt("libx264","H.264 (libx264)", f.vcodec)
    + opt("libx265","H.265 (libx265)", f.vcodec) + opt("msmpeg4","WMV2 (msmpeg4)", f.vcodec)
    + opt("prores_ks","ProRes", f.vcodec) + opt("libvpx-vp9","VP9 (for WebM)", f.vcodec)
    + opt("libvpx","VP8 (for WebM)", f.vcodec);
  var spOpts = opt("","(none)", f.speed) + opt("ultrafast","ultrafast", f.speed) + opt("veryfast","veryfast", f.speed)
    + opt("fast","fast", f.speed) + opt("medium","medium", f.speed) + opt("slow","slow", f.speed)
    + opt("veryslow","veryslow", f.speed);
  var acOpts = opt("","(auto/keep)", f.acodec) + opt("aac","AAC", f.acodec) + opt("libmp3lame","MP3", f.acodec)
    + opt("libopus","Opus (for WebM)", f.acodec) + opt("libvorbis","Vorbis (for WebM/OGG)", f.acodec)
    + opt("flac","FLAC (lossless)", f.acodec) + opt("wmav2","WMA", f.acodec)
    + opt("pcm_s16le","PCM 16-bit", f.acodec) + opt("copy","copy (no re-encode)", f.acodec);

  var html = ''
    + '<div>'
    + '<div id="editor-title" style="color:'+t.ac+'">'+(id?L("ed_title_edit"):L("ed_title_new"))+'</div>'
    + '<div class="ed-row"><label style="color:'+t.muted+'">'+L("ed_name")+'</label>'
    + '<input type="text" id="ed-name" value="'+esc(name)+'" style="background:'+t.surf2+';border-color:'+t.bord+';color:'+t.text+'" /></div>'
    + '<div class="ed-cols">'
    + '<div class="ed-col"><label style="color:'+t.muted+'">'+L("ed_applies")+'</label>'
    + '<select id="ed-input" style="background:'+t.surf2+';border-color:'+t.bord+';color:'+t.text+'">'+inputOpts+'</select></div>'
    + '<div class="ed-col"><label style="color:'+t.muted+'">'+L("ed_outfmt")+'</label>'
    + '<select id="ed-output" style="background:'+t.surf2+';border-color:'+t.bord+';color:'+t.text+'">'+outOpts+'</select></div>'
    + '</div>'
    + '<div class="ed-cols">'
    + '<div class="ed-col"><label style="color:'+t.muted+'">'+L("ed_vcodec")+'</label>'
    + '<select id="ed-vcodec" style="background:'+t.surf2+';border-color:'+t.bord+';color:'+t.text+'">'+vcOpts+'</select></div>'
    + '<div class="ed-col"><label style="color:'+t.muted+'">'+L("ed_speed")+'</label>'
    + '<select id="ed-speed" style="background:'+t.surf2+';border-color:'+t.bord+';color:'+t.text+'">'+spOpts+'</select></div>'
    + '</div>'
    + '<div class="ed-cols">'
    + '<div class="ed-col"><label style="color:'+t.muted+'">'+L("ed_res")+'</label>'
    + '<input type="text" id="ed-scale" value="'+esc(f.scale.replace(":","x"))+'" placeholder="1920x1080" style="background:'+t.surf2+';border-color:'+t.bord+';color:'+t.text+'" /></div>'
    + '<div class="ed-col"><label style="color:'+t.muted+'">'+L("ed_crf")+'</label>'
    + '<input type="text" id="ed-crf" value="'+esc(f.crf)+'" placeholder="20" style="background:'+t.surf2+';border-color:'+t.bord+';color:'+t.text+'" /></div>'
    + '</div>'
    + '<div class="ed-cols">'
    + '<div class="ed-col"><label style="color:'+t.muted+'">'+L("ed_fps")+'</label>'
    + '<input type="text" id="ed-fps" value="'+esc(fps)+'" placeholder="30" style="background:'+t.surf2+';border-color:'+t.bord+';color:'+t.text+'" /></div>'
    + '<div class="ed-col">&nbsp;</div>'
    + '</div>'
    + '<div class="ed-cols">'
    + '<div class="ed-col"><label style="color:'+t.muted+'">'+L("ed_acodec")+'</label>'
    + '<select id="ed-acodec" style="background:'+t.surf2+';border-color:'+t.bord+';color:'+t.text+'">'+acOpts+'</select></div>'
    + '<div class="ed-col"><label style="color:'+t.muted+'">'+L("ed_abr")+'</label>'
    + '<input type="text" id="ed-abr" value="'+esc(f.abr)+'" placeholder="128k" style="background:'+t.surf2+';border-color:'+t.bord+';color:'+t.text+'" /></div>'
    + '</div>'
    + '<div class="ed-row"><label style="color:'+t.muted+'">'+L("ed_extra")+'</label>'
    + '<input type="text" id="ed-extra" value="'+esc(f.extra)+'" style="background:'+t.surf2+';border-color:'+t.bord+';color:'+t.text+';font-family:Consolas,monospace" /></div>'
    + '<div class="ed-row"><label style="color:'+t.muted+'">'+L("ed_inargs")+'</label>'
    + '<input type="text" id="ed-inargs" value="'+esc(inArgs)+'" style="background:'+t.surf2+';border-color:'+t.bord+';color:'+t.text+';font-family:Consolas,monospace" /></div>'
    + '</div>';

  var ov = document.getElementById("editor-overlay");
  var fields = document.getElementById("editor-fields");
  var box    = document.getElementById("editor-box");
  if (fields) fields.innerHTML = html;
  // Style the static elements with current theme
  if (box) { box.style.background = t.surf; box.style.borderColor = t.bordHi; box.style.color = t.text; }
  var btnSave   = document.getElementById("ed-save");
  var btnCancel = document.getElementById("ed-cancel");
  if (btnSave)   { btnSave.innerText = L("ed_save"); btnSave.style.borderColor = t.ac; btnSave.style.color = t.ac; }
  if (btnCancel) { btnCancel.innerText = L("cancel"); btnCancel.style.borderColor = t.bord; btnCancel.style.color = t.muted; }
  popIn(ov, document.getElementById("editor-box"));
}

function closeEditor() {
  var ov     = document.getElementById("editor-overlay");
  var box    = document.getElementById("editor-box");
  var fields = document.getElementById("editor-fields");
  editingId = null;
  popOut(ov, box, function() { if (fields) fields.innerHTML = ""; });
}

function val(id) { var e = document.getElementById(id); return e ? ("" + e.value).replace(/^\s+|\s+$/g, "") : ""; }

// Warn about codec/container combos ffmpeg will reject. Returns a message
// string if there's a problem, or "" if the combination is fine.
function checkContainerCodecs(ext, vcodec, acodec) {
  ext = ("" + ext).toLowerCase();
  var allowV = {
    webm: {libvpx:1, "libvpx-vp9":1, vp8:1, vp9:1, "libaom-av1":1, av1:1},
    mp4:  {libx264:1, libx265:1, h264:1, hevc:1, mpeg4:1, "":1},
    mov:  {libx264:1, libx265:1, prores_ks:1, prores:1, dnxhd:1, mpeg4:1, "":1},
    wmv:  {msmpeg4:1, wmv2:1, "":1},
    gif:  {gif:1, "":1},
    mp3:  {"":1}, m4a:{"":1}, flac:{"":1}, wav:{"":1}, ogg:{"":1}, opus:{"":1}
  };
  var allowA = {
    webm: {libopus:1, opus:1, libvorbis:1, vorbis:1, "":1, copy:1},
    mp4:  {aac:1, libmp3lame:1, mp3:1, ac3:1, "":1, copy:1},
    mov:  {aac:1, pcm_s16le:1, pcm_s24le:1, "":1, copy:1},
    wmv:  {wmav2:1, "":1, copy:1},
    mp3:  {libmp3lame:1, "":1}, m4a:{aac:1, "":1}, flac:{flac:1, "":1},
    wav:  {pcm_s16le:1, pcm_s24le:1, "":1}, ogg:{libvorbis:1, "":1}, opus:{libopus:1, "":1}
  };
  var problems = [];
  var av = allowV[ext];
  if (av && vcodec && !av[vcodec] && ext !== "mp3" && ext !== "m4a" && ext !== "flac" && ext !== "wav" && ext !== "ogg" && ext !== "opus") {
    problems.push("- The " + ext.toUpperCase() + " container does not support the video codec \"" + vcodec + "\".");
  }
  var aa = allowA[ext];
  if (aa && acodec && acodec !== "copy" && !aa[acodec]) {
    problems.push("- The " + ext.toUpperCase() + " container does not support the audio codec \"" + acodec + "\".");
  }
  // Audio-only outputs shouldn't carry a video codec
  if ((ext === "mp3" || ext === "m4a" || ext === "flac" || ext === "wav" || ext === "ogg" || ext === "opus") && vcodec) {
    problems.push("- " + ext.toUpperCase() + " is an audio-only format - set Video codec to (auto/keep) or it will fail.");
  }
  if (!problems.length) return "";
  var hint = "";
  if (ext === "webm") hint = "\n\nFor WebM use video codec VP9 (libvpx-vp9) and audio Opus.";
  else if (ext === "mp4") hint = "\n\nFor MP4 use H.264/H.265 video and AAC audio.";
  return "This combination won't work:\n" + problems.join("\n") + hint;
}

function saveEditor() {
  var name = val("ed-name");
  if (!name) { alert("Please enter a template name."); return; }
  var f = {
    vcodec: val("ed-vcodec"),
    speed:  val("ed-speed"),
    crf:    val("ed-crf"),
    acodec: val("ed-acodec"),
    abr:    val("ed-abr"),
    scale:  val("ed-scale").replace(/x/i, ":").replace(/\s+/g, ""),
    extra:  val("ed-extra")
  };
  var outExt = val("ed-output") || "mp4";
  var inSel  = val("ed-input") || "*";
  var inExts = (inSel === "*") ? ["*"] : [inSel];

  // Guard against codec/container combinations ffmpeg will reject outright,
  // which is the usual reason a custom template "won't start".
  var warn = checkContainerCodecs(outExt, f.vcodec, f.acodec);
  if (warn) {
    if (!confirm(warn + "\n\nSave anyway? (Cancel to go back and fix it)")) return;
  }

  var args = buildArgs(f);
  // FPS is stored as an input arg (-r N before -i). Combine it with any
  // other input args the user typed, without duplicating -r.
  var fps = val("ed-fps").replace(/\s+/g, "");
  var inArgs = val("ed-inargs").replace(/(^|\s)-r\s+[\d.]+/g, " ").replace(/\s+/g, " ").replace(/^\s+|\s+$/g, "");
  if (fps) inArgs = ("-r " + fps + " " + inArgs).replace(/\s+$/g, "");
  // Build a short human description
  var descBits = [];
  if (f.vcodec) descBits.push(f.vcodec);
  if (f.speed)  descBits.push(f.speed);
  if (f.crf !== "") descBits.push("CRF " + f.crf);
  if (f.scale)  descBits.push(f.scale.replace(":", "x"));
  if (fps)      descBits.push(fps + "fps");
  if (f.abr)    descBits.push("audio " + f.abr);
  var desc = descBits.join(", ") || "Custom conversion";

  var tpl = {
    id: newId(),
    name: name,
    group: "Custom",
    description: desc,
    outputExt: outExt,
    inputExts: inExts,
    inputArgs: inArgs,
    args: args
  };
  // Preserve the transparency-flatten setting from the template being edited.
  var srcPreset = editingId ? findPreset(editingId) : null;
  if (srcPreset && srcPreset.flatten) tpl.flatten = srcPreset.flatten;
  customPresets.push(tpl);
  saveCustomPresets();
  closeEditor();
  selectPreset(tpl);     // auto-select the new template
  renderPresets();
}



function selectPreset(p) {
  selectedPreset = p; renderPresets(); updateRunButton();
}

// ── Drop zone ────────────────────────────────────────────
function dzEnter(e) { return cancelEvt(e); }
function dzOver(e) {
  e = e || window.event;
  cancelEvt(e);
  try { if (e.dataTransfer) e.dataTransfer.dropEffect = "copy"; } catch(_) {}
  try {
    var t=getT();
    var dz=document.getElementById("dropzone");
    if (dz) { dz.style.borderColor=t.ac; dz.style.background=t.surf; }
  } catch(_) {}
  return false;
}
function dzLeave(e) {
  try {
    var t=getT();
    var dz=document.getElementById("dropzone");
    if (dz) { dz.style.borderColor=t.bordHi; dz.style.background=t.surf2; }
  } catch(_) {}
}
// IE9 standards mode (forced by the X-UA-Compatible meta) uses the W3C
// drag-drop model: a drop is only ALLOWED if dragover calls preventDefault().
// The old "returnValue=false" alone does not register a drop target here,
// which is why the cursor showed "no drop". We call both for safety.
function cancelEvt(e) {
  e = e || window.event;
  if (e.preventDefault) e.preventDefault();
  e.returnValue = false;
  return false;
}

function dzDrop(e) {
  e = e || window.event;
  cancelEvt(e);
  dzLeave(e);

  // Collect only paths contained in the actual drop payload. The old fallback
  // enumerated selections from every open Explorer window; a browser drag
  // often contains no DOM-visible path, so that fallback could add unrelated
  // selected files. It is deliberately gone.
  var found = {}, order = [];
  function collect(fp) {
    fp = normaliseDroppedPath(fp);
    if (!fp) return;
    var key = fp.toLowerCase();
    if (!found[key]) { found[key] = 1; order.push(fp); }
  }

  var dt = e.dataTransfer;
  try {
    if (dt && dt.files) {
      for (var fi=0; fi<dt.files.length; fi++) {
        var fo = dt.files[fi];
        try { if (fo.path) collect(fo.path); } catch(_) {}
      }
    }
  } catch(_) {}

  // Different MSHTML builds expose different formats, and unsupported format
  // names throw "Invalid argument", so every read is isolated.
  var formats = ["FileNameW","FileName","URL","text/uri-list","text/x-moz-url","Text"];
  for (var i=0; i<formats.length; i++) {
    try {
      if (!dt) break;
      var raw = dt.getData(formats[i]);
      if (!raw) continue;
      var parts = ("" + raw).replace(/\r/g, "").split(/[\u0000\n]/);
      for (var j=0; j<parts.length; j++) {
        var part = parts[j].replace(/^\s+|\s+$/g, "");
        if (!part || part.charAt(0) === "#") continue;
        collect(part);
      }
    } catch(_) {
      // Try the next format.
    }
  }

  var added = 0;
  for (var k=0; k<order.length; k++) {
    if (addInputFile(order[k])) added++;
  }

  if (added > 0) { renderJobs(); updateRunButton(); renderPresets(); }
  else {
    alert("Could not read a local file from this drop.\n\nCompleted Chrome and Firefox downloads are supported while the drag helper is running. Wait for the download to finish, or use Browse.");
  }
  return false;
}

function fileUriToPath(value) {
  var s = ("" + value).replace(/\u0000/g, "").replace(/^\s+|\s+$/g, "").replace(/^["']|["']$/g, "");
  if (!/^file:/i.test(s)) return "";

  var rest = s.substring(5).replace(/\\/g, "/");
  var unc = false;
  if (rest.substring(0,3) === "///") {
    rest = rest.substring(2);                  // /C:/path
  } else if (rest.substring(0,2) === "//") {
    rest = rest.substring(2);
    if (/^localhost\//i.test(rest)) {
      rest = rest.substring(10);
    } else if (!/^[A-Za-z][:\|]\//.test(rest)) {
      unc = true;                              // server/share/path
    }
  }

  try { rest = decodeURIComponent(rest); } catch(_) { return ""; }
  if (unc) return "\\\\" + rest.replace(/^\/+/, "").replace(/\//g, "\\");

  rest = rest.replace(/^\/+([A-Za-z][:\|]\/)/, "$1");
  if (rest.length >= 3 && rest.charAt(1) === "|" && rest.charAt(2) === "/") {
    rest = rest.charAt(0) + ":" + rest.substring(2);
  }
  rest = rest.replace(/\//g, "\\");
  return /^[A-Za-z]:\\/.test(rest) ? rest : "";
}

function normaliseDroppedPath(value) {
  var path = ("" + value).replace(/\u0000/g, "").replace(/^\s+|\s+$/g, "").replace(/^["']|["']$/g, "");
  if (!path) return "";
  if (/^file:/i.test(path)) path = fileUriToPath(path);
  else if (/^[A-Za-z]:\//.test(path)) path = path.replace(/\//g, "\\");
  if (!path || (!/^[A-Za-z]:\\/.test(path) && !/^\\\\/.test(path))) return "";
  try {
    if (!fso.FileExists(path)) return "";
    return fso.GetAbsolutePathName(path);
  } catch(_) { return ""; }
}
function addFile(fileObj) {
  var fp=fileObj.path||fileObj.name;
  if(!fp||(fp===fileObj.name&&fp.indexOf("\\")<0))return;
  jobs.push({id:++jobCounter,inputPath:fp,filename:fileObj.name,preset:selectedPreset,selected:true,status:"pending",log:"",outputPath:""});
}
function browseFiles() {
  // Use the PowerShell picker: true multi-select, proper filter, and no
  // stuck-state (the hidden HTML file input only returns one file and won't
  // re-fire when the same path is chosen again).
  dropBridgeSuspend(true);
  try { browseWithPowerShell(); }
  finally { dropBridgeSuspend(false); }
}

function browseWithPowerShell() {
  var tmp = wsh.ExpandEnvironmentStrings("%TEMP%") + "\\ffbatch_pick.txt";
  var bat = wsh.ExpandEnvironmentStrings("%TEMP%") + "\\ffbatch_pick.bat";
  var ps  = appFolder() + "\\pick_files.ps1";

  try {
    var bf = fso.CreateTextFile(bat, true, false);
    bf.Write('@powershell.exe -NoProfile -ExecutionPolicy Bypass -File ' + batQuote(ps) + ' -OutFile ' + batQuote(tmp) + '\r\n');
    bf.Close();
    wsh.Run('"' + bat + '"', 0, true);
  } catch(e) { alert("Browse error: " + e.message); return; }

  try {
    if (!fso.FileExists(tmp)) return;
    var sz = 0;
    try { sz = fso.GetFile(tmp).Size; } catch(_) {}
    var raw = "";
    if (sz > 0) {
      var rf = fso.OpenTextFile(tmp, 1, false);
      raw = rf.ReadAll(); rf.Close();
    }
    try { fso.DeleteFile(tmp); } catch(ex) {}
    try { fso.DeleteFile(bat); } catch(ex) {}
    if (!raw) return;
    // Strip a UTF-8 BOM whether it arrived as one char (\uFEFF) or as the raw
    // 3 bytes read in ASCII mode (EF BB BF -> \u00EF\u00BB\u00BF).
    raw = raw.replace(/^\uFEFF/, "").replace(/^\u00EF\u00BB\u00BF/, "");
    var lines = raw.replace(/\r/g,"").split("\n");
    var added = 0;
    for (var i=0; i<lines.length; i++) {
      var fp = lines[i].replace(/^\uFEFF/,"").replace(/^\u00EF\u00BB\u00BF/,"").replace(/^\s+|\s+$/g,"").replace(/^"|"$/g,"");
      if (!fp) continue;
      try { if (addInputFile(fp)) added++; } catch(ex) {}
    }
    if (added > 0) { renderJobs(); updateRunButton(); renderPresets(); }
    else if (raw.replace(/\s/g,"")) {
      // We got output but nothing resolved to a real file — show why.
      var first = lines[0] ? lines[0].replace(/^\uFEFF/,"").replace(/^\u00EF\u00BB\u00BF/,"").replace(/^\s+|\s+$/g,"").replace(/^"|"$/g,"") : "";
      alert("Could not add the selected file(s).\n\nFirst path read:\n" + first + "\n\nIf this looks wrong, the file may have been moved or the path contains unsupported characters.");
    }
  } catch(e) {}
}


function fileInputChanged() {
  var inp = document.getElementById("file-input");
  if (!inp || !inp.value) return;
  // In HTA, input.value gives the full path of the FIRST file only
  var fp = inp.value.replace(/^"|"$/g,"");
  if (fp && addInputFile(fp)) {
    renderJobs(); updateRunButton(); renderPresets();
  }
  inp.value = "";
}


// ── Output folder ──────────────────────────────────────────
function pickOutputFolder() {
  dropBridgeSuspend(true);
  try { pickOutputFolderCore(); }
  finally { dropBridgeSuspend(false); }
}
function pickOutputFolderCore() {
  var tmp = wsh.ExpandEnvironmentStrings("%TEMP%") + "\\ffbatch_folder.txt";
  var bat = wsh.ExpandEnvironmentStrings("%TEMP%") + "\\ffbatch_folder.bat";
  var ps  = appFolder() + "\\pick_folder.ps1";
  try {
    var bf = fso.CreateTextFile(bat, true, false);
    bf.Write('@powershell.exe -NoProfile -ExecutionPolicy Bypass -File ' + batQuote(ps) + ' -OutFile ' + batQuote(tmp) + '\r\n');
    bf.Close();
    wsh.Run('"' + bat + '"', 0, true);
  } catch(e) { alert("Browse error: " + e.message); return; }
  try {
    if (!fso.FileExists(tmp)) return;
    // On cancel the helper writes a 0-byte file; ReadAll() on an empty file
    // throws "Input past end of file", so only read when there's content.
    var sz = 0;
    try { sz = fso.GetFile(tmp).Size; } catch(_) {}
    var raw = "";
    if (sz > 0) {
      var rf = fso.OpenTextFile(tmp, 1, false);
      raw = rf.ReadAll(); rf.Close();
    }
    try { fso.DeleteFile(tmp); } catch(ex) {}
    try { fso.DeleteFile(bat); } catch(ex) {}
    if (!raw) return;   // cancelled — nothing selected
    // Strip BOM, all whitespace, quotes — ps1 output can have any of these
    var folder = raw.replace(/[\r\n]/g,"").replace(/^\uFEFF/,"").replace(/^[\s"]+|[\s"]+$/g,"");
    if (folder) {
      outputFolder = folder;
      document.getElementById("out-path").innerHTML = esc(outputFolder);
      document.getElementById("btn-resetout").style.display = "";
    }
  } catch(e) {}
}
function resetOutput() {
  outputFolder="";
  document.getElementById("out-path").innerHTML="&mdash; "+L("output_default")+" &mdash;";
  document.getElementById("btn-resetout").style.display="none";
}
function buildOutputPath(job) {
  var ext=job.preset.outputExt||"mp4";
  if (job.isSequence) {
    var base = (job.seqBase || "sequence").replace(/[_\-.]+$/,"") || "sequence";
    var sfolder = outputFolder || (job.seqFolder + "\\output");
    try { if(!fso.FolderExists(sfolder)) fso.CreateFolder(sfolder); } catch(e){}
    return uniqueOutPath(sfolder+"\\"+base+"."+ext, "");
  }
  var parts=job.inputPath.split("\\");
  var nameNoExt=parts[parts.length-1].replace(/\.[^.]+$/,"");
  var folder=outputFolder||(parts.slice(0,parts.length-1).join("\\")+"\\output");
  try { if(!fso.FolderExists(folder)) fso.CreateFolder(folder); } catch(e){}
  return uniqueOutPath(folder+"\\"+nameNoExt+"."+ext, job.inputPath);
}
// Never return a path equal to the input (that would make ffmpeg's -y
// truncate the source before reading it -> "moov atom not found"). Also
// avoid clobbering an existing file by appending _converted / _1 / _2 ...
function uniqueOutPath(path, inputPath) {
  function eqi(a, b) { return a.toLowerCase() === b.toLowerCase(); }
  var collides = (inputPath && eqi(path, inputPath));
  var dot = path.lastIndexOf(".");
  var stem = dot >= 0 ? path.substring(0, dot) : path;
  var ext  = dot >= 0 ? path.substring(dot) : "";
  if (collides) path = stem + "_converted" + ext;   // same name as source
  // make sure we don't equal the input after that either
  if (inputPath && eqi(path, inputPath)) path = stem + "_converted_1" + ext;
  return path;
}


// ── Queue ────────────────────────────────────────────────
function startQueue() {
  if (running || updateInstalling) return;
  var pending=[];
  for (var i=0;i<jobs.length;i++) { if(jobs[i].status==="pending") pending.push(jobs[i]); }
  if (!pending.length||!selectedPreset) return;
  running=true; stopRequested=false;
  document.getElementById("btn-run").disabled=true;
  document.getElementById("btn-stop").style.display="";
  runNext(pending,0);
}
// ── Image-sequence detection ────────────────────────────
var SEQ_EXTS = {png:1,jpg:1,jpeg:1,bmp:1,tga:1,tif:1,tiff:1,dpx:1,exr:1,webp:1};

function fileExtLower(path) {
  var nm = path.split("\\").pop();
  var dot = nm.lastIndexOf(".");
  return dot >= 0 ? nm.substring(dot + 1).toLowerCase() : "";
}
function isImageFile(path) { return !!SEQ_EXTS[fileExtLower(path)]; }

// Inspect an image path and, if it belongs to a numbered sequence, return
// {folder, pattern, start, count, display, prefix, ext, padded, width}; else null.
function detectSequence(path) {
  var slash = path.lastIndexOf("\\");
  var folder = path.substring(0, slash);
  var name = path.substring(slash + 1);
  var dot = name.lastIndexOf(".");
  if (dot < 0) return null;
  var ext = name.substring(dot + 1);
  var base = name.substring(0, dot);                 // filename without extension
  // trailing run of digits
  var m = base.match(/^(.*?)(\d+)$/);
  if (!m) return null;                               // no number → not a sequence
  var prefix = m[1];
  var digits = m[2];
  var width = digits.length;

  // Scan the folder for sibling files: prefix + digits + . + ext (same ext)
  var nums = [], widths = {};
  try {
    var f = fso.GetFolder(folder);
    var files = new Enumerator(f.Files);
    var reEsc = prefix.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    var re = new RegExp("^" + reEsc + "(\\d+)\\." + ext.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "$", "i");
    for (; !files.atEnd(); files.moveNext()) {
      var fn = files.item().Name;
      var mm = fn.match(re);
      if (mm) { nums.push(parseInt(mm[1], 10)); widths[mm[1].length] = 1; }
    }
  } catch(e) { return null; }

  if (nums.length < 2) return null;                  // not really a sequence

  // sort ascending, take a consecutive run starting at the lowest number
  nums.sort(function(a, b){ return a - b; });
  var start = nums[0], count = 1, prev = start;
  for (var i = 1; i < nums.length; i++) {
    if (nums[i] === prev + 1) { count++; prev = nums[i]; }
    else if (nums[i] === prev) { /* dup, ignore */ }
    else break;                                      // gap → stop the run
  }

  // padded if every matching file has the same digit width
  var wkeys = []; for (var w in widths) wkeys.push(w);
  var padded = (wkeys.length === 1);
  var patNum = padded ? ("%0" + width + "d") : "%d";
  var pattern = prefix + patNum + "." + ext;

  return {
    folder: folder,
    pattern: folder + "\\" + pattern,
    patternName: pattern,
    start: start,
    count: count,
    prefix: prefix,
    ext: ext,
    display: prefix + (padded ? repeatChar("#", width) : "#") + "." + ext + "  (" + count + " frames from " + start + ")"
  };
}
function repeatChar(c, n) { var s = ""; for (var i = 0; i < n; i++) s += c; return s; }

function sequenceAlreadyQueued(seq) {
  for (var i = 0; i < jobs.length; i++) {
    if (jobs[i].isSequence && jobs[i].inputPath === seq.pattern) return true;
  }
  return false;
}

// Unified entry point for adding any input. Returns true if something was
// added (or already present), false if it should be skipped.
function addInputFile(path) {
  if (!path) return false;
  try { if (!fso.FileExists(path)) return false; } catch(e) { return false; }

  if (isImageFile(path)) {
    var seq = detectSequence(path);
    if (seq) {
      if (sequenceAlreadyQueued(seq)) return true;   // already added from another frame
      var seqJob = {
        id: ++jobCounter,
        inputPath: seq.pattern,                      // ffmpeg pattern path
        filename: seq.display,
        isSequence: true,
        seqStart: seq.start,
        seqCount: seq.count,
        seqFolder: seq.folder,
        seqBase: seq.prefix || "sequence",
        ext: seq.ext,
        preset: selectedPreset, selected: true, status: "pending", log: "", outputPath: ""
      };
      jobs.push(seqJob);
      scheduleProbe(seqJob);
      return true;
    }
  }
  var newJob = { id: ++jobCounter, inputPath: path, filename: fso.GetFileName(path),
              preset: selectedPreset, selected: true, status: "pending", log: "", outputPath: "" };
  jobs.push(newJob);
  scheduleProbe(newJob);
  return true;
}


function runNext(pending,idx) {
  if (stopRequested||idx>=pending.length) {
    running=false; stopRequested=false;
    document.getElementById("btn-run").disabled=false;
    document.getElementById("btn-stop").style.display="none";
    updateRunButton(); return;
  }
  var job=pending[idx];
  // Each job runs with its OWN assigned preset (set at import / via the preset
  // list). Only fall back to the active preset if a job somehow has none.
  if (!job.preset) job.preset=selectedPreset;
  job.outputPath=buildOutputPath(job);
  job.status="running"; job.log="";
  renderJobs(); updateTally();
  var tmp=wsh.ExpandEnvironmentStrings("%TEMP%");
  var bat=tmp+"\\ffbatch_"+job.id+".bat";
  var log=tmp+"\\ffbatch_"+job.id+".log";
  var ffmpeg=ffmpegPath();
  var inArgs = job.preset.inputArgs ? (job.preset.inputArgs + " ") : "";
  var presetArgs = job.preset.args || "";
  var cmd;
  if (job.isSequence) {
    // Image sequence: pattern input, with start number and frame count.
    // Ensure an input framerate is present (default 30) so timing is sane.
    var seqIn = inArgs;
    if (seqIn.indexOf("-r ") < 0 && seqIn.indexOf("-framerate ") < 0) seqIn = "-framerate 30 " + seqIn;
    seqIn = "-start_number " + job.seqStart + " " + seqIn;
    var flat = job.preset.flatten;   // e.g. "white" / "black" — composite away transparency
    if (flat) {
      // PNG/TGA transparency carries arbitrary RGB under alpha (often black),
      // which turns into a dark video under yuv420p. Composite each frame onto
      // a solid colour first. scale2ref sizes the background to the frames.
      var fc = "color=c=" + flat + "[bg];[bg][0:v]scale2ref[bg2][fg];[bg2][fg]overlay=shortest=1,format=yuv420p[v]";
      cmd='@echo off\n'+ffmpeg+' -y '+seqIn+'-i '+batQuote(job.inputPath)+' -filter_complex "'+fc+'" -map "[v]" -frames:v '+job.seqCount+' '+presetArgs+' '+batQuote(job.outputPath)+' > '+batQuote(log)+' 2>&1\necho EXIT_CODE=%ERRORLEVEL% >> '+batQuote(log)+'\n';
    } else {
      cmd='@echo off\n'+ffmpeg+' -y '+seqIn+'-i '+batQuote(job.inputPath)+' -frames:v '+job.seqCount+' '+presetArgs+' '+batQuote(job.outputPath)+' > '+batQuote(log)+' 2>&1\necho EXIT_CODE=%ERRORLEVEL% >> '+batQuote(log)+'\n';
    }
  } else {
    cmd='@echo off\n'+ffmpeg+' -y '+inArgs+'-i '+batQuote(job.inputPath)+' '+presetArgs+' '+batQuote(job.outputPath)+' > '+batQuote(log)+' 2>&1\necho EXIT_CODE=%ERRORLEVEL% >> '+batQuote(log)+'\n';
  }
  try { var bf=fso.CreateTextFile(bat,true,false); bf.Write(cmd); bf.Close(); }
  catch(e) { job.status="error"; job.log="Failed: "+e.message; renderJobs(); runNext(pending,idx+1); return; }
  wsh.Run('"'+bat+'"',0,false);
  pollJob(job,bat,log,pending,idx);
}
function parseTimeSec(s) {
  if (!s) return 0;
  var p=s.split(":"); if(p.length<3) return 0;
  return parseFloat(p[0])*3600+parseFloat(p[1])*60+parseFloat(p[2]);
}
function fmtSec(sec) {
  if (isNaN(sec)||sec<0) return "--:--";
  sec=Math.round(sec);
  var h=Math.floor(sec/3600),m=Math.floor((sec%3600)/60),s=sec%60;
  if(h>0) return h+":"+(m<10?"0"+m:m)+":"+(s<10?"0"+s:s);
  return (m<10?"0"+m:m)+":"+(s<10?"0"+s:s);
}
function fmtBytes(b) {
  if(!b||b<0) return "0 B";
  if(b<1024) return b+" B";
  if(b<1048576) return (b/1024).toFixed(1)+" KB";
  if(b<1073741824) return (b/1048576).toFixed(1)+" MB";
  return (b/1073741824).toFixed(2)+" GB";
}

function pollJob(job,bat,log,pending,idx) {
  if (stopRequested) { job.status="cancelled"; cleanup(bat,log); renderJobs(); runNext(pending,idx+1); return; }
  if (job.aborted) { job.status="cancelled"; try{ if(job.outputPath && fso.FileExists(job.outputPath)) fso.DeleteFile(job.outputPath); }catch(_){} cleanup(bat,log); renderJobs(); updateTally(); runNext(pending,idx+1); return; }
  var done=false, code=-1;
  try {
    if (fso.FileExists(log)) {
      var lf=fso.OpenTextFile(log,1,false); var txt=lf.ReadAll(); lf.Close();
      job.log=txt;
      var logEl=document.getElementById("jlog-"+job.id);
      if (logEl && logEl.style.display !== "none") {
        // Only touch the DOM when the log is actually open, and only
        // auto-scroll if the user is already near the bottom — otherwise we
        // fight their manual scrolling and cause repaint trails in IE.
        var nearBottom = (logEl.scrollTop + logEl.clientHeight >= logEl.scrollHeight - 20);
        if (logEl.innerText !== txt) logEl.innerText = txt;
        if (nearBottom) logEl.scrollTop = logEl.scrollHeight;
      }

      // Parse total duration once from header
      if (!job.totalSec) {
        var dm=txt.match(/Duration:\s*(\d+):(\d+):([\d.]+)/);
        if (dm) job.totalSec=parseFloat(dm[1])*3600+parseFloat(dm[2])*60+parseFloat(dm[3]);
      }

      // Parse the most recent ffmpeg progress data. ffmpeg rewrites a
      // status line repeatedly using carriage returns, e.g.:
      //   frame= 419 fps= 30 q=28.0 size=  21504kB time=00:04:57.12 bitrate= 592.2kbits/s speed=6.99x
      // Field order and spacing vary between builds, and early lines can
      // read "size=N/A"/"bitrate=N/A", so we grab each field independently
      // from the tail of the log rather than requiring one rigid match.
      var tail = txt.length > 4000 ? txt.substring(txt.length - 4000) : txt;
      // isolate the text after the last "frame=" so we read the newest values
      var lastFrameIdx = tail.lastIndexOf("frame=");
      var chunk = lastFrameIdx >= 0 ? tail.substring(lastFrameIdx) : tail;
      // the status line ends at the next CR/LF after this frame token
      var nl = chunk.search(/[\r\n]/);
      if (nl > 0) {
        var after = chunk.substring(nl);
        // keep scanning while later "frame=" tokens exist in the buffer
        var nextFrame = after.indexOf("frame=");
        while (nextFrame >= 0) {
          chunk = after.substring(nextFrame);
          var nl2 = chunk.search(/[\r\n]/);
          if (nl2 <= 0) break;
          after = chunk.substring(nl2);
          nextFrame = after.indexOf("frame=");
        }
      }
      var mFrame = chunk.match(/frame=\s*(\d+)/);
      var mFps   = chunk.match(/fps=\s*([\d.]+)/);
      var mSize  = chunk.match(/L?size=\s*(\d+)\s*kB/i);
      var mTime  = chunk.match(/time=\s*(\d+:\d+:[\d.]+)/);
      var mBr    = chunk.match(/bitrate=\s*([\d.]+\s*\S+)/);
      var mSpeed = chunk.match(/speed=\s*([\d.]+)\s*x/);
      if (mTime) {
        if (!job.prog) job.prog = {};
        if (mFrame) job.prog.frame   = parseInt(mFrame[1]);
        if (mFps)   job.prog.fps     = parseFloat(mFps[1]);
        if (mSize)  job.prog.sizeKB  = parseInt(mSize[1]);
        job.prog.timeSec = parseTimeSec(mTime[1]);
        job.prog.bitrate = mBr ? mBr[1].replace(/\s+/g,"") : (job.prog.bitrate||"&mdash;");
        if (mSpeed) job.prog.speed   = parseFloat(mSpeed[1]);
        if (job.prog.fps===undefined)   job.prog.fps = 0;
        if (job.prog.speed===undefined) job.prog.speed = 0;
      }

      // Output file size + write speed
      var now=(new Date()).getTime();
      if (job.outputPath) {
        try { if (fso.FileExists(job.outputPath)) { job.outSizeBytes=fso.GetFile(job.outputPath).Size; } } catch(ex){}
      }
      if (!job.lastSizeTime) { job.lastSizeTime=now; job.lastSizeBytes=0; }
      var dt=(now-job.lastSizeTime)/1000;
      if (dt>=0.8 && job.outSizeBytes) {
        job.writeBps=(job.outSizeBytes-(job.lastSizeBytes||0))/dt;
        job.lastSizeBytes=job.outSizeBytes; job.lastSizeTime=now;
      }

      var exitM=txt.match(/EXIT_CODE=(\d+)/);
      if (exitM) { done=true; code=parseInt(exitM[1]); }

      liveUpdateJob(job);
    }
  } catch(e){}
  if (done) {
    job.status=code===0?"done":"error";
    cleanup(bat,log); renderJobs(); updateTally(); runNext(pending,idx+1);
  } else {
    window.setTimeout(function(){pollJob(job,bat,log,pending,idx);},800);
  }
}

function liveUpdateJob(job) {
  var t=getT();
  var p=job.prog;
  var pct=0;
  if (p && job.totalSec>0) pct=Math.min(100,(p.timeSec/job.totalSec)*100);

  var progWrap=document.getElementById("jprog-"+job.id);
  var barEl=document.getElementById("jpbar-"+job.id);
  if (progWrap) { progWrap.style.display="block"; progWrap.style.background=t.bord; }
  if (barEl)    { barEl.style.width=pct+"%"; barEl.style.background=t.ac; }

  var tlWrap=document.getElementById("jtl-"+job.id);
  var tlFill=document.getElementById("jtlfill-"+job.id);
  var tlLabel=document.getElementById("jtllabel-"+job.id);
  if (tlWrap)  { tlWrap.style.display="block"; tlWrap.style.borderColor=t.bord; }
  if (tlFill)  { tlFill.style.width=pct+"%"; tlFill.style.background=t.ac; }
  if (tlLabel) {
    tlLabel.style.color=t.text;
    if (p && job.totalSec) {
      var etaStr="";
      if (p.speed>0) etaStr="  ETA "+fmtSec((job.totalSec-p.timeSec)/p.speed);
      tlLabel.innerText=fmtSec(p.timeSec)+" / "+fmtSec(job.totalSec)+"  "+Math.round(pct)+"%"+etaStr;
    } else {
      tlLabel.innerText=L("converting");
    }
  }

  var statsEl=document.getElementById("jstats-"+job.id);
  if (statsEl && p) {
    statsEl.style.display="block";
    var ws=job.writeBps?fmtBytes(job.writeBps)+"/s":"&mdash;";
    var sz=job.outSizeBytes?fmtBytes(job.outSizeBytes):"&mdash;";
    statsEl.innerHTML=
      '<span style="color:'+t.muted+'">FPS&nbsp;</span><b style="color:'+t.text+'">'+p.fps+'</b>'
      +'<span style="color:'+t.bord+'">&nbsp;|&nbsp;</span>'
      +'<span style="color:'+t.muted+'">Speed&nbsp;</span><b style="color:'+t.ac+'">'+p.speed+'x</b>'
      +'<span style="color:'+t.bord+'">&nbsp;|&nbsp;</span>'
      +'<span style="color:'+t.muted+'">Bitrate&nbsp;</span><b style="color:'+t.text+'">'+p.bitrate+'</b>'
      +'<span style="color:'+t.bord+'">&nbsp;|&nbsp;</span>'
      +'<span style="color:'+t.muted+'">Written&nbsp;</span><b style="color:'+t.text+'">'+sz+'</b>'
      +'<span style="color:'+t.bord+'">&nbsp;|&nbsp;</span>'
      +'<span style="color:'+t.muted+'">Write&nbsp;</span><b style="color:'+t.text+'">'+ws+'</b>';
  }
}
function cleanup(bat,log) {
  try{if(fso.FileExists(bat))fso.DeleteFile(bat);}catch(e){}
  try{if(fso.FileExists(log))fso.DeleteFile(log);}catch(e){}
}
// Kill ONLY the ffmpeg process belonging to this job, and do it synchronously
// so the process is actually gone before we advance the queue or delete the
// partial output. The old code fired "taskkill /IM ffmpeg.exe" async and did
// not wait — so the queue would move on (and even launch the next job) while
// the killed ffmpeg was still winding down, which is why an aborted job could
// appear to keep converting. We match on the job's unique output path in the
// process command line via WMI, so sibling jobs are never touched. If WMI is
// unavailable (locked-down box), fall back to a synchronous broad kill.
function killJobProcess(job) {
  var killed = false;
  try {
    var wmi = GetObject("winmgmts:\\\\.\\root\\cimv2");
    var procs = wmi.ExecQuery("SELECT ProcessId,CommandLine FROM Win32_Process WHERE Name='ffmpeg.exe'");
    var e = new Enumerator(procs);
    for (; !e.atEnd(); e.moveNext()) {
      var pr = e.item();
      var cl = pr.CommandLine || "";
      if (job.outputPath && cl.indexOf(job.outputPath) >= 0) {
        try { pr.Terminate(); killed = true; } catch(_){}
      }
    }
  } catch(wmiErr) { /* WMI blocked — use fallback below */ }
  if (!killed) {
    // Last resort: broad kill, but WAIT for it so we don't race the queue.
    try { wsh.Run("taskkill /F /IM ffmpeg.exe",0,true); killed = true; } catch(_){}
  }
  return killed;
}
function stopAll() {
  stopRequested=true;
  // "Stop all" -> broad kill is intended; wait so everything is down before
  // the poll loop tears the queue down.
  try{wsh.Run("taskkill /F /IM ffmpeg.exe",0,true);}catch(e){}
}
function abortJob(id) {
  // Abort just this running job, then carry on with the rest of the queue.
  for(var i=0;i<jobs.length;i++){
    if(jobs[i].id===id && jobs[i].status==="running"){
      jobs[i].aborted=true;
      // Synchronous, scoped kill: the job's ffmpeg is dead on return, so the
      // running pollJob loop will see .aborted on its next tick and cleanly
      // cancel this job + advance, with no orphaned process left running.
      killJobProcess(jobs[i]);
      return;
    }
  }
}
function restartJob(id) {
  // Reset an errored / cancelled / done job back to pending and kick off the
  // queue so it runs again. Clears all per-run progress state.
  for(var i=0;i<jobs.length;i++){
    var j=jobs[i];
    if(j.id===id){
      if(j.status==="running") return;   // can't restart a running job
      j.status="pending"; j.aborted=false; j.log="";
      j.prog=null; j.totalSec=0; j.outputPath="";
      j.outSizeBytes=0; j.lastSizeBytes=0; j.lastSizeTime=0; j.writeBps=0;
      renderJobs(); updateTally(); updateRunButton();
      if(!running) {
        if(selectedPreset) startQueue();
        else alert("Select a preset first, then the job will run.");
      }
      return;
    }
  }
}
function clearDone() {
  var kept=[];
  for(var i=0;i<jobs.length;i++){var s=jobs[i].status;if(s!=="done"&&s!=="error"&&s!=="cancelled")kept.push(jobs[i]);}
  jobs=kept; renderJobs(); updateTally(); updateRunButton(); renderPresets();
}
function removeJob(id) {
  var kept=[];
  for(var i=0;i<jobs.length;i++){if(jobs[i].id!==id)kept.push(jobs[i]);}
  jobs=kept; renderJobs(); updateTally(); updateRunButton();
}
function revealFile(path) { try{wsh.Run('explorer /select,"'+path+'"');}catch(e){} }
function toggleLog(id) {
  var el=document.getElementById("jlog-"+id);
  var btn=document.getElementById("jlogtoggle-"+id);
  if(!el)return;
  if(el.style.display==="block"){el.style.display="none";btn.innerText=L("show_log");}
  else{el.style.display="block";btn.innerText=L("hide_log");}
}

// ── Render jobs ──────────────────────────────────────────
// Pull a concise, human-useful error line out of an ffmpeg log.
function ffmpegErrorReason(log) {
  if (!log) return "";
  var lines = log.replace(/\r/g, "\n").split("\n");
  var patterns = [
    /Only VP8.*permitted.*WebM/i,
    /Could not find tag for codec\s+\S+/i,
    /Unable to find a suitable output format/i,
    /Unknown encoder\s+\S+/i,
    /Encoder .* not found/i,
    /Requested output format .* is not (a suitable|known)/i,
    /Width and height .* not.*allowed/i,
    /does not contain any stream/i,
    /No such file or directory/i,
    /Invalid argument/i,
    /Conversion failed/i
  ];
  for (var pi = 0; pi < patterns.length; pi++) {
    for (var i = lines.length - 1; i >= 0; i--) {
      if (patterns[pi].test(lines[i])) {
        var s = lines[i].replace(/^\s+|\s+$/g, "");
        if (s.length > 140) s = s.substring(0, 137) + "...";
        return s;
      }
    }
  }
  for (var j = lines.length - 1; j >= 0; j--) {
    var tt = lines[j].replace(/^\s+|\s+$/g, "");
    if (tt && tt.indexOf("EXIT_CODE=") < 0 && /error|fail|invalid|cannot|could not|no such/i.test(tt)) {
      if (tt.length > 140) tt = tt.substring(0, 137) + "...";
      return tt;
    }
  }
  return "Conversion failed - see log for details.";
}

// Mouse-wheel scrolling for the queue. Wheel-over-nested-overflow can be
// unreliable in HTAs, so drive scrollTop directly and cancel the default so it
// never double-scrolls. wheelDelta is +120 per notch up / -120 down.
function queueWheel() {
  var e = window.event;
  var q = document.getElementById("queue-wrap");
  if (!q || !e) return true;
  q.scrollTop -= (e.wheelDelta / 120) * 40;
  e.returnValue = false;
  return false;
}

function renderJobs() {
  var t=getT();
  var list=document.getElementById("job-list");
  var empty=document.getElementById("queue-empty");
  if(!jobs.length){list.innerHTML="";empty.style.display="";return;}
  empty.style.display="none";

  // Refresh suggestion scores based on the first probed job
  refreshMatchScores(jobs);

  var html="";
  for(var i=0;i<jobs.length;i++){
    var job=jobs[i];
    var pname=job.preset?job.preset.name:"\u2014";
    var outname=job.outputPath?job.outputPath.split("\\").pop():"";
    var meta=esc(pname)+(outname?" &rarr; "+esc(outname):"");
    // For failed jobs, surface ffmpeg's actual error line so the cause is clear.
    if (job.status==="error") {
      var reason = ffmpegErrorReason(job.log);
      if (reason) meta += '<div style="color:'+t.err+';margin-top:3px;font-size:11px;">'+esc(reason)+'</div>';
    }
    var bordCol = job.status==="running"?t.ac : job.status==="done"?t.ok : job.status==="error"?t.err : t.bord;
    var statusCol = job.status==="running"?t.ac : job.status==="done"?t.ok : job.status==="error"?t.err : t.muted;
    var actions="";
    if(job.status==="running") actions+='<button onclick="abortJob('+job.id+')" style="border-color:'+t.err+';color:'+t.err+'">&#9632; '+L("abort")+'</button>';
    if(job.status==="error"||job.status==="cancelled") actions+='<button onclick="restartJob('+job.id+')" style="border-color:'+t.ac+';color:'+t.ac+'">&#8635; '+L("restart")+'</button>';
    if(job.status==="done") actions+='<button onclick="restartJob('+job.id+')" style="border-color:'+t.bord+';color:'+t.muted+'">&#8635; '+L("rerun")+'</button>';
    if(job.status==="done") actions+='<button onclick="revealFile(\''+escJs(job.outputPath)+'\')  " style="border-color:'+t.bord+';color:'+t.muted+'">'+L("show_file")+'</button>';
    if(job.status==="pending"||job.status==="error"||job.status==="cancelled") actions+='<button onclick="removeJob('+job.id+')" style="border-color:'+t.bord+';color:'+t.muted+'">'+L("remove")+'</button>';
    // Inspect button — always shown; dimmed if probe not yet available
    var inspectCol = (job.probe && job.probe.ok) ? t.ac : t.muted;
    actions += '<button onclick="openInspect('+job.id+')" style="border-color:'+t.bord+';color:'+inspectCol+'" title="'+L("inspect")+'">\u2139</button>';

    var logToggle=job.log?'<button class="job-log-btn" id="jlogtoggle-'+job.id+'" onclick="toggleLog('+job.id+')" style="color:'+t.muted+'">'+L("show_log")+'</button>':"";

    var pct=0;
    if (job.prog && job.totalSec>0) pct=Math.min(100,(job.prog.timeSec/job.totalSec)*100);
    if (job.status==="done") pct=100;
    var showProg=(job.status==="running"||(job.status==="done"&&pct>0));
    var barColor=job.status==="done"?t.ok:t.ac;

    // ── Probe info strip ──
    var probeHtml = "";
    if (job.probe && job.probe.ok) {
      var p = job.probe;
      var bits = [];
      if (p.hasVideo) {
        if (p.width && p.height) bits.push(p.width + "\xd7" + p.height);
        if (p.vcodec) bits.push(p.vcodec);
        if (p.fps)    bits.push(p.fps + "fps");
        if (p.colorSpace) bits.push(p.colorSpace);
      }
      if (p.hasAudio) {
        bits.push(p.acodec + (p.channels ? " " + p.channels + "ch" : ""));
      }
      if (p.duration) bits.push(fmtSec(p.duration));
      if (p.bitrate)  bits.push(Math.round(p.bitrate/1000) + "kbps");
      if (bits.length) {
        probeHtml = '<div class="job-probe" style="color:'+t.muted+'">'
          + bits.join('<span style="color:'+t.bord+'"> &nbsp;&#183;&nbsp; </span>')
          + '</div>';
      }
    } else if (job.probe && !job.probe.ok) {
      // Probe ran but failed (ffprobe not found or unreadable file)
      probeHtml = '<div class="job-probe" style="color:'+t.muted+'">probe unavailable</div>';
    }
    // probing in progress — show a placeholder only if still pending
    if (!job.probe && job.status === "pending") {
      probeHtml = '<div class="job-probe" style="color:'+t.muted+'">probing\u2026</div>';
    }

    // ── Warning strip ──
    var warnHtml = "";
    var warnTxt = probeWarning(job, job.preset);
    if (warnTxt) {
      warnHtml = '<div class="job-warn" style="background:'+t.surf2+';color:#e0a000;border:1px solid #a07000;">'
        + '\u26a0 ' + esc(warnTxt) + '</div>';
    }

    // ── FPS hint for sequences ──
    var fpsHintHtml = "";
    var fpsHint = seqFpsHint(job, job.preset);
    if (fpsHint) {
      fpsHintHtml = '<div class="job-probe" style="color:'+t.muted+';font-style:italic;">\u2139 '+esc(fpsHint)+'</div>';
    }

    // ── Size estimate ──
    var estimateHtml = "";
    if (job.status === "pending" || job.status === "error" || job.status === "cancelled") {
      var est = estimateOutputSize(job, job.preset);
      if (est) {
        estimateHtml = '<div class="job-estimate" style="color:'+t.muted+'">'
          + '<span style="color:'+t.bord+'">src&nbsp;</span>'
          + (job.probe && job.probe.bitrate ? Math.round(job.probe.bitrate/1000)+'kbps' : '?')
          + '&nbsp;&rarr;&nbsp;'
          + esc(est)
          + '</div>';
      }
    }
    // After done: show actual output size
    if (job.status === "done" && job.outputPath) {
      try {
        if (fso.FileExists(job.outputPath)) {
          var outSz = fso.GetFile(job.outputPath).Size;
          var inSz = 0;
          if (!job.isSequence) { try { inSz = fso.GetFile(job.inputPath).Size; } catch(_){} }
          var sizeNote = fmtBytes(outSz);
          if (inSz > 0) {
            var ratio = (outSz / inSz * 100).toFixed(0);
            sizeNote += "  (" + ratio + "% of source)";
          }
          estimateHtml = '<div class="job-estimate" style="color:'+t.muted+'">Output: <b style="color:'+t.ok+'">'+esc(sizeNote)+'</b></div>';
        }
      } catch(_) {}
    }

    // ── Selection checkbox (pending jobs only; others get an aligned spacer) ──
    var checkCell;
    if (job.status==="pending") {
      var on = !!job.selected;
      checkCell = '<td class="job-check-cell">'
        + '<span class="job-check" onclick="toggleJobSelected('+job.id+');event.cancelBubble=true" '
        + 'title="'+(on?"Selected \u2014 in scope for \u2018only selected\u2019":"Not selected \u2014 click to include")+'" '
        + 'style="border-color:'+(on?t.ac:t.bord)+';background:'+(on?t.ac:"none")+';color:'+(on?t.acText:t.muted)+';">'
        + (on?"\u2713":"")
        + '</span></td>';
    } else {
      checkCell = '<td class="job-check-cell"></td>';
    }

    html+='<div class="job-row" style="background:'+t.surf+';border-color:'+bordCol+'">'
        +'<div class="job-top"><table width="100%"><tr>'
        +checkCell
        +'<td class="job-name-cell"><div class="job-filename" title="'+esc(job.inputPath)+'" style="color:'+t.text+'">'+esc(job.filename)+'</div>'
        +'<div class="job-meta" style="color:'+t.muted+'">'+meta+'</div></td>'
        +'<td class="job-right"><span class="job-status" style="color:'+statusCol+';border-color:'+statusCol+'">'+L("st_"+job.status)+'</span>'
        +'<span class="job-btns">'+actions+'</span></td>'
        +'</tr></table></div>'
        + probeHtml
        + warnHtml
        + fpsHintHtml
        + estimateHtml
        +'<div class="job-progress" id="jprog-'+job.id+'" style="display:'+(showProg?"block":"none")+';background:'+t.bord+'">'
        +'<div class="job-progress-bar" id="jpbar-'+job.id+'" style="width:'+pct+'%;background:'+barColor+'"></div>'
        +'</div>'
        +'<div class="job-timeline" id="jtl-'+job.id+'" style="display:'+(showProg?"block":"none")+';border-color:'+t.bord+'">'
        +'<div class="job-timeline-fill" id="jtlfill-'+job.id+'" style="width:'+pct+'%;background:'+barColor+'"></div>'
        +'<div class="job-timeline-label" id="jtllabel-'+job.id+'" style="color:'+t.text+'">'
        +(job.status==="done"?'&#10003; '+L("done")+' &mdash; '+fmtSec(job.totalSec||0)
          :job.status==="running"&&job.prog&&job.totalSec?fmtSec(job.prog.timeSec)+" / "+fmtSec(job.totalSec)+"   "+Math.round(pct)+"%"
          :job.status==="running"?L("converting"):"")
        +'</div>'
        +'</div>'
        +'<div class="job-stats" id="jstats-'+job.id+'" style="display:'+(job.status==="running"&&job.prog?"block":"none")+';color:'+t.muted+'">'
        +(job.prog&&job.status==="running"?
          '<span>FPS&nbsp;</span><b style="color:'+t.text+'">'+job.prog.fps+'</b>'
          +'<span style="color:'+t.bord+'">' +' &nbsp;|&nbsp; </span>'
          +'<span>Speed&nbsp;</span><b style="color:'+t.ac+'">'+job.prog.speed+'x</b>'
          +'<span style="color:'+t.bord+'">&nbsp;|&nbsp;</span>'
          +'<span>Bitrate&nbsp;</span><b style="color:'+t.text+'">'+job.prog.bitrate+'</b>'
          :'')
        +'</div>'
        +logToggle
        +'<div class="job-log" id="jlog-'+job.id+'" style="background:'+t.logBg+';border-color:'+t.bord+';color:'+t.muted+'">'+esc(job.log)+'</div>'
        +'</div>';
  }
  list.innerHTML=html;
}

function updateTally() {
  var t=getT();
  var done=0,err=0,pend=0,run=0;
  for(var i=0;i<jobs.length;i++){var s=jobs[i].status;if(s==="done")done++;else if(s==="error")err++;else if(s==="pending")pend++;else if(s==="running")run++;}
  if(!jobs.length){document.getElementById("tally").innerHTML=L("no_jobs");document.getElementById("tally").style.color=t.muted;return;}
  var p=[];
  if(run) p.push(run+" "+L("t_converting"));
  if(pend)p.push(pend+" "+L("t_pending"));
  if(done)p.push(done+" "+L("t_done"));
  if(err) p.push(err+" "+L("t_failed"));
  document.getElementById("tally").innerHTML=p.join(" &middot; ");
  document.getElementById("tally").style.color=t.muted;
}
function updateRunButton() {
  var t=getT();
  var hasPending=false;
  for(var i=0;i<jobs.length;i++){if(jobs[i].status==="pending"){hasPending=true;break;}}
  var ok=hasPending&&selectedPreset&&!running&&!updateInstalling;
  document.getElementById("btn-run").disabled=!ok;
  document.getElementById("btn-run").style.opacity=ok?"1":"0.35";
}

// -- Play while waiting: VOIDBREAKER -----------------------------------------
// A dependency-free Invaders/Arkanoid hybrid for the IE9 engine used by HTAs.
// The game owns only its own timer and event listeners; conversion keeps running.
var waitingGame = (function () {
  var W = 720, H = 430, STEP = 1 / 60;
  var overlay = null, box = null, canvas = null, ctx = null;
  var timer = null, hudTimer = null, active = false, paused = false, gameOver = false;
  var initialised = false, controlsAttached = false, bridgeHeld = false;
  var previousFocus = null;
  var lastTick = 0, accumulator = 0, lastHud = 0;
  var keys = {};
  var stars = [], aliens = [], bricks = [], playerShots = [], enemyShots = [], particles = [], pickups = [], balls = [];
  var paddle = null;
  var level = 1, score = 0, lives = 3, highScore = 0;
  // Easy-to-edit power-up settings. Durations stack when the same timed power
  // is collected again; multiplication doubles every ball up to MAX_BALLS.
  var COMBO_TARGET = 3;
  var LASER_DURATION = 10;
  var SPEED_DURATION = 5;
  var FIREBALL_DURATION = 5;
  var SPEED_MULTIPLIER = 2;
  var BALL_MULTIPLIER = 2;
  var MAX_BALLS = 64;
  var MAX_FALLING_PICKUPS = 64;
  var PICKUP_FALL_MIN = 78, PICKUP_FALL_MAX = 108, PICKUP_DRIFT = 38;
  var FIRE_TRAIL_INTERVAL = 0.035;
  var FIRE_TRAIL_PARTICLES = 2;
  var MAX_PARTICLES = 320;
  var PICKUP_TYPES = ["laser", "multiply", "speed", "fire"];
  var PICKUP_COLORS = { laser:"#20d9ff", multiply:"#8b7bff", speed:"#36e6b4", fire:"#ff7657" };
  var PICKUP_LABELS = { laser:"L", multiply:"x" + BALL_MULTIPLIER, speed:"S", fire:"F" };
  var comboHits = 0, weaponTime = 0, speedTime = 0, fireTime = 0;
  var alienDir = 1, alienSpeed = 28, alienDrop = 12;
  var enemyCooldown = 0, enemyInterval = 1.5, fireCooldown = 0;
  var transitionEnd = 0, messageUntil = 0, messageText = "", showRules = false;

  function el(id) { return document.getElementById(id); }
  function nowMs() { return (new Date()).getTime(); }
  function clamp(v, lo, hi) { return v < lo ? lo : (v > hi ? hi : v); }
  function randomRange(lo, hi) { return lo + Math.random() * (hi - lo); }

  function hook(obj, name, fn, on) {
    if (!obj) return;
    if (on) {
      if (obj.addEventListener) obj.addEventListener(name, fn, false);
      else if (obj.attachEvent) obj.attachEvent("on" + name, fn);
    } else {
      if (obj.removeEventListener) obj.removeEventListener(name, fn, false);
      else if (obj.detachEvent) obj.detachEvent("on" + name, fn);
    }
  }

  function initialise() {
    if (initialised) return;
    initialised = true;
    overlay = el("game-overlay");
    box = el("game-box");
    canvas = el("game-canvas");
    try { ctx = canvas && canvas.getContext ? canvas.getContext("2d") : null; }
    catch (_) { ctx = null; }

    if (!ctx) {
      if (canvas) canvas.style.display = "none";
      if (box) { box.style.height = "150px"; box.style.marginTop = "-75px"; }
      var help = el("game-help");
      if (help) help.innerHTML = "<b>Game unavailable</b><br />Canvas could not start, but the converter is unaffected.";
      if (el("game-pause")) el("game-pause").style.display = "none";
      if (el("game-new")) el("game-new").style.display = "none";
      return;
    }

    for (var i = 0; i < 55; i++) {
      stars.push({
        x: Math.random() * W,
        y: Math.random() * H,
        s: Math.random() < 0.78 ? 1 : 2,
        v: randomRange(5, 18)
      });
    }
    resetGame();
  }

  function attachControls(on) {
    if (on === controlsAttached) return;
    controlsAttached = on;
    hook(document, "keydown", keyDown, on);
    hook(document, "keyup", keyUp, on);
    hook(window, "blur", lostFocus, on);
    hook(canvas, "mousemove", mouseMove, on);
    hook(canvas, "click", mouseClick, on);
  }

  function clearKeys() { keys = {}; }
  function clearPlayKeys() {
    keys[32] = false; keys[37] = false; keys[39] = false;
    keys[65] = false; keys[68] = false;
  }

  function eventTargetIsButton(e) {
    var target = e ? (e.target || e.srcElement) : null;
    return target && ("" + target.tagName).toUpperCase() === "BUTTON";
  }

  function focusableGameControls() {
    var candidates = [ctx ? canvas : null, el("game-close"), el("game-pause"), el("game-new")];
    var result = [];
    for (var i = 0; i < candidates.length; i++) {
      var item = candidates[i];
      if (!item || !item.focus) continue;
      var display = item.currentStyle ? item.currentStyle.display : item.style.display;
      if (display !== "none") result.push(item);
    }
    return result;
  }

  function focusGameControl(direction) {
    var items = focusableGameControls();
    if (!items.length) return;
    var current = null;
    try { current = document.activeElement; } catch (_) {}
    var index = -1;
    for (var i = 0; i < items.length; i++) if (items[i] === current) { index = i; break; }
    if (index < 0) index = direction < 0 ? 0 : -1;
    index = (index + direction + items.length) % items.length;
    try { items[index].focus(); } catch (_) {}
  }

  function suppress(e) {
    if (!e) return;
    e.returnValue = false;
    e.cancelBubble = true;
    if (e.preventDefault) e.preventDefault();
    if (e.stopPropagation) e.stopPropagation();
  }

  function keyDown(ev) {
    if (!active) return;
    var e = ev || window.event;
    var k = e.keyCode || e.which;
    if ((k === 13 || k === 32) && eventTargetIsButton(e)) return;
    if (k === 9) {
      focusGameControl(e.shiftKey ? -1 : 1);
      suppress(e);
      return;
    }
    var handled = (k === 27 || k === 32 || k === 37 || k === 39 ||
                   k === 65 || k === 68 || k === 78 || k === 80 || k === 13);
    if (!handled) return;
    var first = !keys[k];
    keys[k] = true;

    if (first && k === 27) close();
    else if (first && k === 80) togglePause();
    else if (first && k === 78) newGame();
    else if (first && k === 13 && gameOver) newGame();
    else if (first && k === 32) playerAction();
    suppress(e);
  }

  function keyUp(ev) {
    if (!active) return;
    var e = ev || window.event;
    var k = e.keyCode || e.which;
    if (k === 9 || k === 13 || k === 27 || k === 32 || k === 37 || k === 39 ||
        k === 65 || k === 68 || k === 78 || k === 80) {
      var wasDown = !!keys[k];
      keys[k] = false;
      if ((k === 13 || k === 32) && eventTargetIsButton(e) && !wasDown) return;
      suppress(e);
    }
  }

  function lostFocus() {
    clearKeys();
    if (active && !paused && !gameOver) {
      paused = true;
      stopLoop();
      updatePauseButton();
      draw();
    }
  }

  function mouseMove(ev) {
    if (!active || paused || gameOver || transitionEnd || !canvas || !paddle) return;
    var e = ev || window.event;
    var r = canvas.getBoundingClientRect();
    var rw = r.right - r.left;
    if (rw <= 0) return;
    var mx = (e.clientX - r.left) * canvas.width / rw;
    paddle.x = clamp(mx - paddle.w / 2, 8, W - 8 - paddle.w);
    positionStuckBalls();
    if (paused) draw();
  }

  function mouseClick(ev) {
    if (!active) return;
    playerAction();
    suppress(ev || window.event);
  }

  function open() {
    initialise();
    if (!overlay || active) return;
    if (dropBridgeElementVisible("editor-overlay") ||
        dropBridgeElementVisible("inspect-overlay") ||
        dropBridgeElementVisible("apply-overlay")) return;
    try { previousFocus = document.activeElement; } catch (_) { previousFocus = null; }
    active = true;
    clearKeys();
    attachControls(true);
    startHudWatch();
    if (!bridgeHeld) {
      dropBridgeSuspend(true);
      bridgeHeld = true;
    }
    if (typeof bgAnim !== "undefined") bgAnim.setEnabled(false);
    popIn(overlay, box);
    try {
      window.focus();
      var firstControl = ctx ? canvas : el("game-close");
      if (firstControl && firstControl.focus) firstControl.focus();
    } catch (_) {}
    updateHud(true);
    updatePauseButton();
    if (ctx) {
      draw();
      if (!paused && !gameOver) startLoop();
    }
  }

  function close() {
    if (!active) return;
    active = false;
    clearKeys();
    stopLoop();
    stopHudWatch();
    attachControls(false);
    popOut(overlay, box, function () {
      if (typeof bgAnim !== "undefined") bgAnim.setEnabled(fancyEnabled);
      if (bridgeHeld) {
        bridgeHeld = false;
        dropBridgeSuspend(false);
      }
      try { if (previousFocus && previousFocus.focus) previousFocus.focus(); } catch (_) {}
      previousFocus = null;
    });
  }

  function destroy() {
    active = false;
    clearKeys();
    stopLoop();
    stopHudWatch();
    attachControls(false);
    if (bridgeHeld) {
      bridgeHeld = false;
      try { dropBridgeSuspend(false); } catch (_) {}
    }
  }

  function startLoop() {
    if (!active || paused || gameOver || !ctx || timer) return;
    lastTick = nowMs();
    accumulator = 0;
    timer = window.setInterval(tick, 33);
  }

  function stopLoop() {
    if (timer) {
      window.clearInterval(timer);
      timer = null;
    }
  }

  function startHudWatch() {
    if (!hudTimer) {
      hudTimer = window.setInterval(function () { if (active) updateHud(true); }, 500);
    }
  }

  function stopHudWatch() {
    if (hudTimer) {
      window.clearInterval(hudTimer);
      hudTimer = null;
    }
  }

  function tick() {
    var n = nowMs();
    var elapsed = Math.min(0.05, (n - lastTick) / 1000);
    var steps = 0;
    lastTick = n;
    accumulator += elapsed;
    while (accumulator >= STEP && steps < 3) {
      update(STEP);
      accumulator -= STEP;
      steps++;
    }
    if (steps === 3) accumulator = 0;
    updateHud(false);
    draw();
  }

  function resetGame() {
    level = 1;
    score = 0;
    lives = 3;
    paused = false;
    gameOver = false;
    transitionEnd = 0;
    particles = [];
    pickups = [];
    comboHits = 0;
    weaponTime = 0;
    speedTime = 0;
    fireTime = 0;
    showRules = true;
    setupLevel();
    updatePauseButton();
    updateHud(true);
  }

  function newGame() {
    initialise();
    if (!ctx) return;
    stopLoop();
    resetGame();
    draw();
    if (active) startLoop();
  }

  function setupLevel() {
    aliens = [];
    bricks = [];
    playerShots = [];
    enemyShots = [];
    resetPowers();
    transitionEnd = 0;

    var difficulty = level - 1;
    // Asymptotic curves make every level a little harder without allowing
    // armour or speed to grow into a mathematically unwinnable state.
    var paddleW = 54 + 50 / (1 + difficulty * 0.055);
    paddle = { x:(W - paddleW) / 2, y:H - 29, w:paddleW, h:11, speed:390 };
    resetBalls();

    var rows = Math.min(6, 3 + Math.floor((level - 1) / 3));
    var cols = Math.min(11, 7 + Math.floor((level - 1) / 4));
    var alienW = 34, alienH = 20, gapX = 12, gapY = 11;
    var totalW = cols * alienW + (cols - 1) * gapX;
    var startX = (W - totalW) / 2;
    for (var row = 0; row < rows; row++) {
      for (var col = 0; col < cols; col++) {
        aliens.push({
          x:startX + col * (alienW + gapX),
          y:34 + row * (alienH + gapY),
          w:alienW, h:alienH, hp:1, maxHp:1, row:row
        });
      }
    }

    var brickRows = Math.min(4, 2 + Math.floor((level - 1) / 10));
    var brickCols = 10, brickW = 54, brickH = 13, brickGap = 8;
    var brickTotal = brickCols * brickW + (brickCols - 1) * brickGap;
    var brickStart = (W - brickTotal) / 2;
    var maxBrickTier = Math.min(4, 1 + Math.floor(difficulty / 3));
    var brickPalette = ["#36e6b4", "#ffc857", "#ff7657", "#ff4d8d"];
    // The formation always starts with at least one more alien than brick.
    for (row = 0; row < brickRows && bricks.length < aliens.length - 1; row++) {
      for (col = 0; col < brickCols && bricks.length < aliens.length - 1; col++) {
        var tier = 1 + ((row * 3 + col + difficulty) % maxBrickTier);
        var brickHp = tier + 1; // weakest: two bullets, or one two-point ball hit
        bricks.push({
          x:brickStart + col * (brickW + brickGap),
          y:244 + row * (brickH + 6),
          w:brickW, h:brickH, hp:brickHp, maxHp:brickHp, tier:tier,
          color:brickPalette[tier - 1]
        });
      }
    }

    alienDir = Math.random() < 0.5 ? -1 : 1;
    alienSpeed = 28 + 118 * difficulty / (difficulty + 24);
    alienDrop = 12 + 18 * difficulty / (difficulty + 35);
    enemyInterval = 0.30 + 1.25 / (1 + difficulty * 0.06);
    enemyCooldown = 0.8;
    fireCooldown = 0;
    messageText = "LEVEL " + level;
    messageUntil = nowMs() + 950;
  }

  function createBall() {
    var difficulty = level - 1;
    var speed = 230 + 190 * difficulty / (difficulty + 30);
    return {
      x:paddle ? paddle.x + paddle.w / 2 : W / 2,
      y:paddle ? paddle.y - 8 : H - 40,
      r:5, vx:randomRange(-0.55, 0.55) * speed,
      vy:-speed, speed:speed, stuck:true, trailCooldown:0
    };
  }

  function resetBalls() {
    balls = [createBall()];
  }

  function positionStuckBalls() {
    if (!paddle) return;
    for (var i = 0; i < balls.length; i++) {
      if (balls[i].stuck) {
        balls[i].x = paddle.x + paddle.w / 2;
        balls[i].y = paddle.y - balls[i].r - 2;
      }
    }
  }

  function ballsWaitingToLaunch() {
    return balls.length === 1 && balls[0].stuck;
  }

  function launchBalls() {
    if (!ballsWaitingToLaunch() || paused || gameOver || transitionEnd) return;
    var ball = balls[0];
    ball.stuck = false;
    showRules = false;
    messageUntil = 0;
    var angle = randomRange(-0.72, 0.72);
    ball.vx = Math.sin(angle) * ball.speed;
    ball.vy = -Math.cos(angle) * ball.speed;
    if (Math.abs(ball.vx) < 65) ball.vx = ball.vx < 0 ? -65 : 65;
  }

  function playerAction() {
    if (!active || paused || gameOver || transitionEnd || !ctx) return;
    launchBalls();
    firePlayerShot();
  }

  function firePlayerShot() {
    if (weaponTime <= 0 || fireCooldown > 0 || playerShots.length >= 7 || !paddle) return;
    playerShots.push({ x:paddle.x + paddle.w / 2 - 2, y:paddle.y - 9, w:4, h:10, vy:-410 });
    fireCooldown = 0.17;
  }

  function togglePause() {
    if (!active || gameOver || !ctx) return;
    paused = !paused;
    clearPlayKeys();
    if (paused) {
      stopLoop();
      draw();
    } else {
      startLoop();
    }
    updatePauseButton();
  }

  function updatePauseButton() {
    var b = el("game-pause");
    if (b) b.innerText = paused ? "RESUME" : "PAUSE";
  }

  function updateHud(force) {
    var n = nowMs();
    if (!force && n - lastHud < 140) return;
    lastHud = n;
    if (score > highScore) highScore = score;
    if (el("game-level")) el("game-level").innerText = level;
    if (el("game-score")) el("game-score").innerText = score;
    if (el("game-lives")) el("game-lives").innerText = lives;
    if (el("game-high")) el("game-high").innerText = highScore;
    var converterActive = (typeof running !== "undefined" && running);
    if (el("game-subtitle")) {
      el("game-subtitle").innerText = converterActive ?
        "CONVERSION RUNNING \u00b7 INVADERS + ARKANOID" : "INVADERS + ARKANOID";
    }
  }

  function update(dt) {
    updateStars(dt);
    updateParticles(dt);

    if (transitionEnd) {
      if (nowMs() >= transitionEnd) {
        level++;
        setupLevel();
      }
      return;
    }

    fireCooldown = Math.max(0, fireCooldown - dt);
    movePaddle(dt);
    updatePickups(dt);
    // READY is a safe serve: the player can position the paddle without the
    // formation descending or firing before Space/click launches the ball.
    if (ballsWaitingToLaunch()) return;
    weaponTime = Math.max(0, weaponTime - dt);
    speedTime = Math.max(0, speedTime - dt);
    fireTime = Math.max(0, fireTime - dt);
    enemyCooldown -= dt;
    moveAliens(dt);
    if (gameOver) return;

    if (keys[32]) firePlayerShot();
    updatePlayerShots(dt);
    updateEnemyShots(dt);
    if (gameOver) return;
    if (updateBalls(dt) || gameOver) return;

    if (!aliens.length) completeLevel();
  }

  function updateStars(dt) {
    for (var i = 0; i < stars.length; i++) {
      stars[i].y += stars[i].v * dt;
      if (stars[i].y >= H) {
        stars[i].y -= H;
        stars[i].x = Math.random() * W;
      }
    }
  }

  function updateParticles(dt) {
    for (var i = particles.length - 1; i >= 0; i--) {
      var p = particles[i];
      p.x += p.vx * dt;
      p.y += p.vy * dt;
      p.vy += 35 * dt;
      p.life -= dt;
      if (p.life <= 0) particles.splice(i, 1);
    }
  }

  function registerComboHit(x, y) {
    comboHits++;
    if (comboHits < COMBO_TARGET) return;
    comboHits = 0;
    spawnRandomPickup(x, y);
  }

  function spawnRandomPickup(x, y) {
    var type = PICKUP_TYPES[Math.floor(Math.random() * PICKUP_TYPES.length)];
    if (pickups.length >= MAX_FALLING_PICKUPS) pickups.shift();
    pickups.push({
      x:clamp(x - 9, 8, W - 26), y:clamp(y - 9, 20, H - 100),
      w:18, h:18, vx:randomRange(-PICKUP_DRIFT, PICKUP_DRIFT),
      vy:randomRange(PICKUP_FALL_MIN, PICKUP_FALL_MAX),
      type:type, color:PICKUP_COLORS[type], label:PICKUP_LABELS[type],
      phase:Math.random() * Math.PI * 2
    });
    spawnBurst(x, y, PICKUP_COLORS[type], 8);
  }

  function collectPickup(type) {
    if (type === "laser") weaponTime += LASER_DURATION;
    else if (type === "speed") speedTime += SPEED_DURATION;
    else if (type === "fire") fireTime += FIREBALL_DURATION;
    else if (type === "multiply") multiplyBalls();
  }

  function multiplyBalls() {
    var originalCount = balls.length;
    var targetCount = Math.min(MAX_BALLS, originalCount * BALL_MULTIPLIER);
    for (var i = originalCount; i < targetCount; i++) {
      var source = balls[(i - originalCount) % originalCount];
      var copyNumber = Math.floor(i / originalCount);
      var turn = ((i + copyNumber) % 2 ? -1 : 1) * randomRange(0.20, 0.34) * copyNumber;
      var cos = Math.cos(turn), sin = Math.sin(turn);
      balls.push({
        x:source.x, y:source.y, r:source.r,
        vx:source.vx * cos - source.vy * sin,
        vy:source.vx * sin + source.vy * cos,
        speed:source.speed, stuck:false, trailCooldown:0
      });
    }
  }

  function updatePickups(dt) {
    for (var i = pickups.length - 1; i >= 0; i--) {
      var p = pickups[i];
      p.phase += dt * 5;
      p.x += p.vx * dt;
      p.y += p.vy * dt;
      if (p.x < 6) { p.x = 6; p.vx = Math.abs(p.vx); }
      else if (p.x + p.w > W - 6) { p.x = W - 6 - p.w; p.vx = -Math.abs(p.vx); }
      if (rectHit(p.x, p.y, p.w, p.h, paddle.x, paddle.y, paddle.w, paddle.h)) {
        collectPickup(p.type);
        score += 120 * level;
        spawnBurst(p.x + p.w / 2, p.y + p.h / 2, p.color, 16);
        pickups.splice(i, 1);
      } else if (p.y > H) {
        pickups.splice(i, 1);
      }
    }
  }

  function movePaddle(dt) {
    var dir = 0;
    if (keys[37] || keys[65]) dir--;
    if (keys[39] || keys[68]) dir++;
    if (dir) paddle.x += dir * paddle.speed * dt;
    paddle.x = clamp(paddle.x, 8, W - 8 - paddle.w);
    positionStuckBalls();
  }

  function moveAliens(dt) {
    if (!aliens.length) return;
    var dx = alienDir * alienSpeed * dt;
    var minX = W, maxX = 0, maxY = 0;
    var i;
    for (i = 0; i < aliens.length; i++) {
      aliens[i].x += dx;
      if (aliens[i].x < minX) minX = aliens[i].x;
      if (aliens[i].x + aliens[i].w > maxX) maxX = aliens[i].x + aliens[i].w;
      if (aliens[i].y + aliens[i].h > maxY) maxY = aliens[i].y + aliens[i].h;
    }

    var correction = 0;
    if (maxX > W - 14) {
      correction = W - 14 - maxX;
      alienDir = -1;
    } else if (minX < 14) {
      correction = 14 - minX;
      alienDir = 1;
    }
    if (correction) {
      maxY = 0;
      for (i = 0; i < aliens.length; i++) {
        aliens[i].x += correction;
        aliens[i].y += alienDrop;
        if (aliens[i].y + aliens[i].h > maxY) maxY = aliens[i].y + aliens[i].h;
      }
    }

    // Kamikaze rule: touching pairs are removed one-for-one. Recompute the
    // lowest survivor so a destroyed alien cannot also cost the player a life.
    if (maxY >= 244 && bricks.length && resolveAlienBrickImpacts()) {
      maxY = 0;
      for (i = 0; i < aliens.length; i++) {
        if (aliens[i].y + aliens[i].h > maxY) maxY = aliens[i].y + aliens[i].h;
      }
    }

    if (maxY >= paddle.y - 8) {
      loseLife(paddle.x + paddle.w / 2, paddle.y, "#ff4d67");
      for (i = 0; i < aliens.length; i++) aliens[i].y -= 38;
      return;
    }

    if (enemyCooldown <= 0 && enemyShots.length < 14) {
      fireEnemyShot();
      enemyCooldown = enemyInterval * randomRange(0.72, 1.18);
    }
  }

  function resolveAlienBrickImpacts() {
    var impacted = false;
    for (var ai = aliens.length - 1; ai >= 0; ai--) {
      var a = aliens[ai];
      for (var bi = bricks.length - 1; bi >= 0; bi--) {
        var b = bricks[bi];
        if (rectTouch(a.x, a.y, a.w, a.h, b.x, b.y, b.w, b.h)) {
          spawnBurst(a.x + a.w / 2, a.y + a.h / 2, alienColor(a.row), 10);
          spawnBurst(b.x + b.w / 2, b.y + b.h / 2, b.color, 10);
          aliens.splice(ai, 1);
          bricks.splice(bi, 1);
          impacted = true;
          break; // this alien dies with its first brick and cannot break another
        }
      }
    }
    return impacted;
  }

  function fireEnemyShot() {
    if (!aliens.length) return;
    var a = aliens[Math.floor(Math.random() * aliens.length)];
    var difficulty = level - 1;
    var speed = 145 + 235 * difficulty / (difficulty + 35);
    enemyShots.push({ x:a.x + a.w / 2 - 2, y:a.y + a.h, w:4, h:11, vy:speed });
  }

  function updatePlayerShots(dt) {
    for (var i = playerShots.length - 1; i >= 0; i--) {
      var s = playerShots[i];
      s.y += s.vy * dt;
      if (s.y + s.h < 0) {
        playerShots.splice(i, 1);
        continue;
      }
      var hit = false;
      var j;
      for (j = bricks.length - 1; j >= 0; j--) {
        if (rectHit(s.x, s.y, s.w, s.h, bricks[j].x, bricks[j].y, bricks[j].w, bricks[j].h)) {
          damageBrick(j, s.x, s.y, "playerShot");
          hit = true;
          break;
        }
      }
      if (!hit) {
        for (j = aliens.length - 1; j >= 0; j--) {
          if (rectHit(s.x, s.y, s.w, s.h, aliens[j].x, aliens[j].y, aliens[j].w, aliens[j].h)) {
            damageAlien(j, s.x, s.y, "playerShot");
            hit = true;
            break;
          }
        }
      }
      if (hit) playerShots.splice(i, 1);
    }
  }

  function updateEnemyShots(dt) {
    for (var i = enemyShots.length - 1; i >= 0; i--) {
      var s = enemyShots[i];
      s.y += s.vy * dt;
      var hit = false;
      for (var j = bricks.length - 1; j >= 0; j--) {
        if (rectHit(s.x, s.y, s.w, s.h, bricks[j].x, bricks[j].y, bricks[j].w, bricks[j].h)) {
          damageBrick(j, s.x, s.y, "enemyShot");
          hit = true;
          break;
        }
      }
      if (hit) {
        enemyShots.splice(i, 1);
        continue;
      }
      if (rectHit(s.x, s.y, s.w, s.h, paddle.x, paddle.y, paddle.w, paddle.h)) {
        enemyShots.splice(i, 1);
        loseLife(s.x, paddle.y, "#ff4d67");
        return;
      }
      if (s.y > H) enemyShots.splice(i, 1);
    }
  }

  function updateBalls(dt) {
    var motionScale = speedTime > 0 ? SPEED_MULTIPLIER : 1;
    var substeps = Math.max(1, Math.ceil(motionScale));
    var slice = dt * motionScale / substeps;
    for (var step = 0; step < substeps; step++) {
      for (var i = balls.length - 1; i >= 0; i--) {
        if (updateOneBall(balls[i], slice)) return true;
      }
    }
    return false;
  }

  function updateOneBall(ball, dt) {
    if (!ball || ball.stuck) return false;
    var oldX = ball.x, oldY = ball.y;
    ball.x += ball.vx * dt;
    ball.y += ball.vy * dt;
    if (fireTime > 0) addFireTrail(ball, dt);
    else ball.trailCooldown = 0;

    if (ball.x - ball.r < 4) {
      ball.x = 4 + ball.r;
      ball.vx = Math.abs(ball.vx);
    } else if (ball.x + ball.r > W - 4) {
      ball.x = W - 4 - ball.r;
      ball.vx = -Math.abs(ball.vx);
    }
    if (ball.y - ball.r < 4) {
      ball.y = 4 + ball.r;
      ball.vy = Math.abs(ball.vy);
    }
    if (ball.y - ball.r > H) {
      comboHits = 0;
      if (balls.length > 1) {
        for (var lost = balls.length - 1; lost >= 0; lost--) {
          if (balls[lost] === ball) { balls.splice(lost, 1); break; }
        }
        spawnBurst(ball.x, H - 5, "#20d9ff", 8);
        return false;
      }
      loseLife(ball.x, H - 5, "#20d9ff");
      return true;
    }

    if (ball.vy > 0 &&
        circleRect(ball.x, ball.y, ball.r, paddle.x, paddle.y, paddle.w, paddle.h)) {
      ball.y = paddle.y - ball.r - 1;
      var offset = (ball.x - (paddle.x + paddle.w / 2)) / (paddle.w / 2);
      var speed = ball.speed;
      ball.vx = clamp(offset * speed * 0.90, -speed * 0.90, speed * 0.90);
      if (Math.abs(ball.vx) < 52) ball.vx = ball.vx < 0 ? -52 : 52;
      ball.vy = -Math.sqrt(Math.max(1, speed * speed - ball.vx * ball.vx));
      comboHits = 0;
      spawnBurst(ball.x, ball.y, fireTime > 0 ? "#ff7657" : "#20d9ff", 4);
    }

    var i, hitSurface = false;
    if (fireTime > 0) {
      // Fireballs destroy every touched target and continue without bouncing.
      for (i = bricks.length - 1; i >= 0; i--) {
        if (circleRect(ball.x, ball.y, ball.r, bricks[i].x, bricks[i].y, bricks[i].w, bricks[i].h)) {
          damageBrick(i, ball.x, ball.y, "fireBall");
        }
      }
      for (i = aliens.length - 1; i >= 0; i--) {
        if (circleRect(ball.x, ball.y, ball.r, aliens[i].x, aliens[i].y, aliens[i].w, aliens[i].h)) {
          damageAlien(i, ball.x, ball.y, "fireBall");
        }
      }
      return false;
    }

    for (i = bricks.length - 1; i >= 0; i--) {
      if (circleRect(ball.x, ball.y, ball.r, bricks[i].x, bricks[i].y, bricks[i].w, bricks[i].h)) {
        bounceFromRect(ball, oldX, oldY, bricks[i]);
        damageBrick(i, ball.x, ball.y, "ball");
        hitSurface = true;
        break;
      }
    }
    if (!hitSurface) {
      for (i = aliens.length - 1; i >= 0; i--) {
        if (circleRect(ball.x, ball.y, ball.r, aliens[i].x, aliens[i].y, aliens[i].w, aliens[i].h)) {
          bounceFromRect(ball, oldX, oldY, aliens[i]);
          damageAlien(i, ball.x, ball.y, "ball");
          break;
        }
      }
    }
    return false;
  }

  function bounceFromRect(ball, oldX, oldY, r) {
    var gap = 0.25;
    if (oldY + ball.r <= r.y) {
      ball.y = r.y - ball.r - gap;
      ball.vy = -Math.abs(ball.vy);
      return;
    }
    if (oldY - ball.r >= r.y + r.h) {
      ball.y = r.y + r.h + ball.r + gap;
      ball.vy = Math.abs(ball.vy);
      return;
    }
    if (oldX + ball.r <= r.x) {
      ball.x = r.x - ball.r - gap;
      ball.vx = -Math.abs(ball.vx);
      return;
    }
    if (oldX - ball.r >= r.x + r.w) {
      ball.x = r.x + r.w + ball.r + gap;
      ball.vx = Math.abs(ball.vx);
      return;
    }

    // If a fast frame began already intersecting, choose the shallowest exit.
    var penTop = ball.y + ball.r - r.y;
    var penBottom = r.y + r.h - (ball.y - ball.r);
    var penLeft = ball.x + ball.r - r.x;
    var penRight = r.x + r.w - (ball.x - ball.r);
    var minPen = Math.min(penTop, penBottom, penLeft, penRight);
    if (minPen === penTop) {
      ball.y = r.y - ball.r - gap; ball.vy = -Math.abs(ball.vy);
    } else if (minPen === penBottom) {
      ball.y = r.y + r.h + ball.r + gap; ball.vy = Math.abs(ball.vy);
    } else if (minPen === penLeft) {
      ball.x = r.x - ball.r - gap; ball.vx = -Math.abs(ball.vx);
    } else {
      ball.x = r.x + r.w + ball.r + gap; ball.vx = Math.abs(ball.vx);
    }
  }

  function rectHit(x, y, w, h, rx, ry, rw, rh) {
    return x < rx + rw && x + w > rx && y < ry + rh && y + h > ry;
  }

  function rectTouch(x, y, w, h, rx, ry, rw, rh) {
    return x <= rx + rw && x + w >= rx && y <= ry + rh && y + h >= ry;
  }

  function circleRect(cx, cy, radius, rx, ry, rw, rh) {
    var nx = clamp(cx, rx, rx + rw);
    var ny = clamp(cy, ry, ry + rh);
    var dx = cx - nx, dy = cy - ny;
    return dx * dx + dy * dy <= radius * radius;
  }

  function damageBrick(index, x, y, source) {
    var b = bricks[index];
    if (!b) return;
    var playerHit = source !== "enemyShot";
    var comboHit = source === "ball" || source === "fireBall";
    var damage = source === "fireBall" ? b.hp : (source === "ball" ? 2 : 1);
    b.hp -= damage;
    if (playerHit) {
      score += 8 * level;
      if (comboHit) registerComboHit(x, y);
    }
    spawnBurst(x, y, b.color, b.hp <= 0 ? 8 : 3);
    if (b.hp <= 0) {
      if (playerHit) score += 28 * level;
      bricks.splice(index, 1);
    }
  }

  function damageAlien(index, x, y, source) {
    var a = aliens[index];
    if (!a) return;
    a.hp = 0;
    score += 12 * level;
    if (source === "ball" || source === "fireBall") registerComboHit(x, y);
    var color = alienColor(a.row);
    spawnBurst(x, y, color, 10);
    score += 90 * level;
    aliens.splice(index, 1);
    alienSpeed += 0.75;
  }

  function alienColor(row) {
    var colors = ["#20d9ff", "#8b7bff", "#ff4d8d", "#36e6b4", "#ffc857", "#ff7657"];
    return colors[(row + level - 1) % colors.length];
  }

  function spawnBurst(x, y, color, count) {
    for (var i = 0; i < count && particles.length < MAX_PARTICLES; i++) {
      particles.push({
        x:x, y:y, vx:randomRange(-95, 95), vy:randomRange(-115, 55),
        life:randomRange(0.25, 0.58), max:0.58, color:color, size:Math.random() < 0.7 ? 2 : 3
      });
    }
  }

  function addFireTrail(ball, dt) {
    ball.trailCooldown = (ball.trailCooldown || 0) - dt;
    if (ball.trailCooldown > 0) return;
    ball.trailCooldown = FIRE_TRAIL_INTERVAL;
    var colors = ["#ff3b30", "#ff7657", "#ffc857", "#fff2a8"];
    var magnitude = Math.sqrt(ball.vx * ball.vx + ball.vy * ball.vy) || 1;
    var tailX = ball.x - ball.vx / magnitude * (ball.r + 2);
    var tailY = ball.y - ball.vy / magnitude * (ball.r + 2);
    for (var i = 0; i < FIRE_TRAIL_PARTICLES && particles.length < MAX_PARTICLES; i++) {
      var life = randomRange(0.18, 0.38);
      particles.push({
        x:tailX + randomRange(-2, 2), y:tailY + randomRange(-2, 2),
        vx:-ball.vx * 0.06 + randomRange(-24, 24),
        vy:-ball.vy * 0.06 + randomRange(-30, 12),
        life:life, max:life, color:colors[Math.floor(Math.random() * colors.length)],
        size:Math.random() < 0.55 ? 2 : 3
      });
    }
  }

  function resetPowers() {
    pickups = [];
    comboHits = 0;
    weaponTime = 0;
    speedTime = 0;
    fireTime = 0;
  }

  function loseLife(x, y, color) {
    if (gameOver || transitionEnd) return;
    spawnBurst(x, y, color, 18);
    lives--;
    playerShots = [];
    enemyShots = [];
    resetPowers();
    if (lives <= 0) {
      lives = 0;
      gameOver = true;
      paused = false;
      messageText = "GAME OVER";
      stopLoop();
      updatePauseButton();
      updateHud(true);
      draw();
      return;
    }
    resetBalls();
    enemyCooldown = Math.max(enemyCooldown, 0.7);
    messageText = "SHIP LOST";
    messageUntil = nowMs() + 900;
    updateHud(true);
  }

  function completeLevel() {
    if (transitionEnd) return;
    score += 500 * level;
    transitionEnd = nowMs() + 1200;
    playerShots = [];
    enemyShots = [];
    resetPowers();
    resetBalls();
    spawnBurst(W / 2, H / 2, "#ffc857", 24);
    updateHud(true);
  }

  function draw() {
    if (!ctx) return;
    ctx.save();
    ctx.fillStyle = "#02040c";
    ctx.fillRect(0, 0, W, H);
    drawBackdrop();
    drawBricks();
    drawAliens();
    drawShots();
    drawPickups();
    drawPaddle();
    drawBalls();
    drawParticles();
    drawPowerStatus();
    drawOverlayMessage();
    drawRulesPopup();
    ctx.restore();
  }

  function drawBackdrop() {
    var i;
    for (i = 0; i < stars.length; i++) {
      ctx.globalAlpha = stars[i].s === 1 ? 0.42 : 0.72;
      ctx.fillStyle = stars[i].s === 1 ? "#6e8aad" : "#c7f6ff";
      ctx.fillRect(Math.round(stars[i].x), Math.round(stars[i].y), stars[i].s, stars[i].s);
    }
    ctx.globalAlpha = 0.10;
    ctx.strokeStyle = "#20d9ff";
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (i = 0; i <= W; i += 60) { ctx.moveTo(i, 0); ctx.lineTo(i, H); }
    for (i = 0; i <= H; i += 50) { ctx.moveTo(0, i); ctx.lineTo(W, i); }
    ctx.stroke();
    ctx.globalAlpha = 1;
  }

  function drawBricks() {
    for (var i = 0; i < bricks.length; i++) {
      var b = bricks[i];
      var alpha = 0.46 + 0.54 * (b.hp / b.maxHp);
      ctx.globalAlpha = alpha;
      ctx.fillStyle = b.color;
      ctx.fillRect(Math.round(b.x), Math.round(b.y), b.w, b.h);
      ctx.globalAlpha = 0.34;
      ctx.fillStyle = "#ffffff";
      ctx.fillRect(Math.round(b.x) + 2, Math.round(b.y) + 2, b.w - 4, 2);
      ctx.globalAlpha = 1;
      ctx.strokeStyle = "#08111f";
      ctx.strokeRect(Math.round(b.x) + 0.5, Math.round(b.y) + 0.5, b.w - 1, b.h - 1);
      var damage = b.maxHp - b.hp;
      if (damage > 0) {
        var bx = Math.round(b.x), by = Math.round(b.y);
        var cx = bx + Math.round(b.w / 2), cy = by + Math.round(b.h / 2);
        ctx.globalAlpha = 0.88;
        ctx.strokeStyle = "#07101e";
        ctx.beginPath();
        ctx.moveTo(cx - 13, by + 1); ctx.lineTo(cx - 4, cy); ctx.lineTo(cx - 10, by + b.h - 1);
        ctx.moveTo(cx - 4, cy); ctx.lineTo(cx + 6, cy - 3); ctx.lineTo(cx + 14, by + b.h - 1);
        if (damage > 1) {
          ctx.moveTo(cx + 6, cy - 3); ctx.lineTo(cx + 17, by + 1);
          ctx.moveTo(cx + 4, cy - 2); ctx.lineTo(cx + 2, by + b.h - 1);
        }
        if (damage > 2) {
          ctx.moveTo(cx - 4, cy); ctx.lineTo(bx + 3, cy + 2);
        }
        ctx.stroke();
        ctx.globalAlpha = 1;
      }
    }
  }

  function drawAliens() {
    for (var i = 0; i < aliens.length; i++) {
      var a = aliens[i], x = Math.round(a.x), y = Math.round(a.y);
      var color = alienColor(a.row);
      ctx.globalAlpha = 0.60 + 0.40 * (a.hp / a.maxHp);
      ctx.fillStyle = color;
      ctx.fillRect(x + 7, y, a.w - 14, 4);
      ctx.fillRect(x + 3, y + 4, a.w - 6, 4);
      ctx.fillRect(x, y + 8, a.w, 8);
      ctx.fillRect(x + 4, y + 16, 7, 4);
      ctx.fillRect(x + a.w - 11, y + 16, 7, 4);
      ctx.fillStyle = "#02040c";
      ctx.fillRect(x + 8, y + 9, 4, 4);
      ctx.fillRect(x + a.w - 12, y + 9, 4, 4);
      ctx.globalAlpha = 1;
      if (a.maxHp > 1) {
        ctx.fillStyle = "#17263b";
        ctx.fillRect(x, y - 4, a.w, 2);
        ctx.fillStyle = color;
        ctx.fillRect(x, y - 4, Math.round(a.w * a.hp / a.maxHp), 2);
      }
    }
  }

  function drawShots() {
    var i, s;
    ctx.fillStyle = "#c7f6ff";
    for (i = 0; i < playerShots.length; i++) {
      s = playerShots[i];
      ctx.fillRect(Math.round(s.x), Math.round(s.y), s.w, s.h);
      ctx.fillStyle = "#20d9ff";
      ctx.fillRect(Math.round(s.x) - 1, Math.round(s.y + 3), s.w + 2, 4);
      ctx.fillStyle = "#c7f6ff";
    }
    ctx.fillStyle = "#ff4d67";
    for (i = 0; i < enemyShots.length; i++) {
      s = enemyShots[i];
      ctx.fillRect(Math.round(s.x), Math.round(s.y), s.w, s.h);
    }
  }

  function drawPickups() {
    for (var i = 0; i < pickups.length; i++) {
      var p = pickups[i];
      var cx = Math.round(p.x + p.w / 2);
      var cy = Math.round(p.y + p.h / 2 + Math.sin(p.phase) * 2);
      ctx.globalAlpha = 0.92;
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.moveTo(cx, cy - 11);
      ctx.lineTo(cx + 11, cy);
      ctx.lineTo(cx, cy + 11);
      ctx.lineTo(cx - 11, cy);
      ctx.closePath();
      ctx.fill();
      ctx.globalAlpha = 1;
      ctx.strokeStyle = "#ffffff";
      ctx.stroke();
      ctx.fillStyle = "#02040c";
      ctx.font = p.label === "x2" ? "bold 8px Consolas" : "bold 11px Consolas";
      ctx.textAlign = "center";
      ctx.fillText(p.label, cx, cy + 4);
      ctx.textAlign = "left";
    }
  }

  function drawPowerStatus() {
    ctx.font = "bold 11px Consolas";
    ctx.textAlign = "left";
    ctx.fillStyle = comboHits ? "#ffc857" : "#6e8aad";
    ctx.fillText("COMBO " + comboHits + "/" + COMBO_TARGET, 12, 18);
    ctx.textAlign = "right";
    var status = [];
    if (balls.length > 1) status.push("BALLS x" + balls.length);
    if (weaponTime > 0) status.push("LASER " + shortTime(weaponTime));
    if (speedTime > 0) status.push("SPEED " + shortTime(speedTime));
    if (fireTime > 0) status.push("FIRE " + shortTime(fireTime));
    ctx.fillStyle = status.length ? "#ffc857" : "#6e8aad";
    ctx.fillText(status.length ? status.join("  |  ") : "NO POWER", W - 12, 18);
    ctx.textAlign = "left";
  }

  function shortTime(value) {
    return (Math.ceil(value * 10) / 10) + "s";
  }

  function drawPaddle() {
    if (!paddle) return;
    var x = Math.round(paddle.x), y = Math.round(paddle.y);
    ctx.fillStyle = weaponTime > 0 ? "#ffc857" : "#20d9ff";
    ctx.fillRect(x, y, paddle.w, paddle.h);
    ctx.fillStyle = "#c7f6ff";
    ctx.fillRect(x + 4, y + 2, paddle.w - 8, 3);
    ctx.fillStyle = "#8b7bff";
    ctx.beginPath();
    ctx.moveTo(x + paddle.w / 2, y - 11);
    ctx.lineTo(x + paddle.w / 2 - 10, y + 2);
    ctx.lineTo(x + paddle.w / 2 + 10, y + 2);
    ctx.closePath();
    ctx.fill();
  }

  function drawBalls() {
    for (var i = 0; i < balls.length; i++) {
      var ball = balls[i];
      ctx.fillStyle = fireTime > 0 ? "#ff7657" : (speedTime > 0 ? "#36e6b4" : "#20d9ff");
      ctx.beginPath();
      ctx.arc(ball.x, ball.y, ball.r + (fireTime > 0 ? 3 : 2), 0, Math.PI * 2, false);
      ctx.fill();
      ctx.fillStyle = "#ffffff";
      ctx.beginPath();
      ctx.arc(ball.x - 1, ball.y - 1, ball.r - 1, 0, Math.PI * 2, false);
      ctx.fill();
    }
  }

  function drawParticles() {
    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];
      ctx.globalAlpha = clamp(p.life / p.max, 0, 1);
      ctx.fillStyle = p.color;
      ctx.fillRect(Math.round(p.x), Math.round(p.y), p.size, p.size);
    }
    ctx.globalAlpha = 1;
  }

  function drawRulesPopup() {
    if (!showRules || paused || gameOver || transitionEnd) return;
    ctx.globalAlpha = 0.94;
    ctx.fillStyle = "#07101e";
    ctx.fillRect(116, 92, 488, 246);
    ctx.globalAlpha = 1;
    ctx.strokeStyle = "#20d9ff";
    ctx.strokeRect(116.5, 92.5, 487, 245);
    ctx.textAlign = "center";
    ctx.fillStyle = "#20d9ff";
    ctx.font = "bold 22px Consolas";
    ctx.fillText("HOW TO PLAY", W / 2, 124);
    ctx.fillStyle = "#c7f6ff";
    ctx.font = "12px Segoe UI";
    ctx.fillText("Destroy every alien to clear the level.", W / 2, 153);
    ctx.fillText("Bricks protect you and award points, but breaking them is optional.", W / 2, 174);
    ctx.fillText("Three ball hits before a paddle return drop a random power-up.", W / 2, 195);
    ctx.fillStyle = "#ffc857";
    ctx.fillText("L laser   |   x2 multiball   |   S double speed   |   F fireball", W / 2, 219);
    ctx.fillStyle = "#8ea4bd";
    ctx.fillText("Move: mouse, Left / Right, or A / D", W / 2, 247);
    ctx.fillText("Space or click: launch / fire   |   P pause   |   N restart   |   Esc close", W / 2, 268);
    ctx.fillStyle = "#ffffff";
    ctx.font = "bold 12px Segoe UI";
    ctx.fillText("Press SPACE or click to begin", W / 2, 307);
    ctx.textAlign = "left";
  }

  function drawOverlayMessage() {
    if (showRules && !paused && !gameOver && !transitionEnd) return;
    var n = nowMs();
    var title = "", sub = "";
    if (gameOver) {
      title = "GAME OVER";
      sub = "Press Enter or NEW GAME to try again";
    } else if (paused) {
      title = "PAUSED";
      sub = "Press P or RESUME";
    } else if (transitionEnd) {
      title = "SECTOR CLEARED";
      sub = "Level " + (level + 1) + " incoming";
    } else if (n < messageUntil) {
      title = messageText;
      sub = "Space or click to launch";
    } else if (ballsWaitingToLaunch()) {
      title = "READY";
      sub = "Space or click to launch";
    }
    if (!title) return;

    ctx.globalAlpha = 0.72;
    ctx.fillStyle = "#02040c";
    ctx.fillRect(185, 174, 350, 82);
    ctx.globalAlpha = 1;
    ctx.strokeStyle = gameOver ? "#ff4d67" : "#20d9ff";
    ctx.strokeRect(185.5, 174.5, 349, 81);
    ctx.textAlign = "center";
    ctx.fillStyle = gameOver ? "#ff4d67" : "#c7f6ff";
    ctx.font = "bold 22px Consolas";
    ctx.fillText(title, W / 2, 207);
    ctx.fillStyle = "#8ea4bd";
    ctx.font = "11px Segoe UI";
    ctx.fillText(sub, W / 2, 231);
    ctx.textAlign = "left";
  }

  return {
    open:open,
    close:close,
    newGame:newGame,
    togglePause:togglePause,
    destroy:destroy
  };
})();

function ffmpegPath() {
  var local=appFolder()+"\\ffmpeg.exe";
  if(fso.FileExists(local)) return batQuote(local);
  return "ffmpeg";
}
function esc(s){if(!s)return"";return(""+s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");}
function escJs(s){return(""+s).replace(/\\/g,"\\\\").replace(/'/g,"\\'");}
</script>
</body>
</html>
