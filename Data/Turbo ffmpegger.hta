var stopRequested  = false;
var showFavsOnly   = false;
var compatOnly     = true;
var editingId      = null;
var searchTerm     = "";
var currentTheme   = "amber";
var currentScale = 1;
var fancyEnabled = true;      // animated background on/off
var bgPattern    = "ambient"; // which background pattern is active
var currentLang  = "en";      // en | nl | ja | zh | ko
var APP_VERSION_FALLBACK = "v0.5-alpha";
var APP_VERSION  = APP_VERSION_FALLBACK;
var updateCheckTimer   = null;
var updateCheckStarted = 0;
var updateStatusPath   = "";
var updateChecking     = false;
var updateStatusKind   = "installed";
var updateStatusValue  = "";
var updateStatusDetail = "";
var updateWorkerPath   = "";
var updateInstalling   = false;

