<html>
<head>
<title>Turbo ffmpegger</title>
<HTA:APPLICATION
  ID="FFmpegBatch"
  APPLICATIONNAME="Turbo ffmpegger"
  CAPTION="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  WINDOWSTATE="normal"
  SCROLL="no"
  INNERBORDER="no"
  SELECTION="no"
  CONTEXTMENU="no"
  DROPENABLED="yes"
/>
<meta http-equiv="X-UA-Compatible" content="IE=9" />
<style>
* { margin:0; padding:0; box-sizing:border-box; }
body {
  font-family: Segoe UI, sans-serif;
  font-size: 12px;
  overflow: hidden;
}

/* Fixed-size root that gets zoomed for the UI-scale feature. All regions
   are positioned relative to THIS box (980x700), so zoom scales the whole
   layout uniformly without the viewport double-counting that broke 2x. */
#app-root {
  position: absolute;
  top: 0; left: 0;
  width: 980px; height: 700px;
  overflow: hidden;
}

/* ── Header ── */
#header {
  position: absolute;
  top: 0; left: 0;
  width: 980px; height: 42px;
  display: table;
}
#header-inner { display:table-row; width:100%; }
#app-title {
  display: table-cell;
  font-size: 13px; font-weight: 700;
  letter-spacing: .03em;
  vertical-align: middle;
  padding: 0 14px;
  white-space: nowrap; width: 1px;
}
#header-mid { display: table-cell; vertical-align: middle; }
#header-btns {
  display: table-cell; text-align: right;
  vertical-align: middle; padding-right: 10px;
  white-space: nowrap; width: 1px;
}
#header-btns button {
  background: none; font-size: 11px; padding: 3px 10px;
  cursor: pointer; font-family: Segoe UI, sans-serif; margin-left: 6px;
}

/* ── Toolbar pinned to bottom ── */
#toolbar {
  position: absolute;
  bottom: 0; left: 0;
  width: 980px; height: 46px;
}

/* ── Body layout (between header and toolbar: 700-42-46 = 612) ── */
#body-wrap {
  position: absolute;
  top: 42px; left: 0;
  width: 980px; height: 612px;
}

/* ── Sidebar ── */
#sidebar {
  position: absolute;
  top: 0; left: 0;
  width: 240px; height: 612px;
  overflow: hidden;
  border-right-width: 1px; border-right-style: solid;
}
#sidebar-top {
  position: absolute; top: 0; left: 0;
  width: 240px; height: 84px;
  padding: 8px 8px 6px;
  border-bottom-width:1px; border-bottom-style:solid;
}
#search-box {
  width: 100%; font-size: 11px;
  font-family: Segoe UI, sans-serif;
  padding: 4px 8px; outline: none;
  border-width: 1px; border-style: solid;
}
#fav-filter, #compat-filter {
  margin-top: 5px; font-size: 10px; cursor: pointer;
  padding: 1px 0; display: block;
}
#preset-list {
  position: absolute;
  top: 84px; bottom: 40px; left: 0;
  width: 240px;
  overflow-y: scroll;
}
.group-header {
  font-size: 9px; font-weight: 700; letter-spacing: .12em;
  text-transform: uppercase; padding: 8px 10px 4px;
}
.preset-item {
  padding: 7px 8px 7px 10px;
  cursor: pointer;
  border-left: 3px solid transparent;
  display: table; width: 100%;
}
.pi-left  { display: table-cell; vertical-align: middle; }
.pi-right { display: table-cell; vertical-align: middle; text-align: right; width: 22px; }
.preset-name { font-size: 11.5px; font-weight: 600; }
.preset-desc { font-size: 10px; margin-top: 1px; line-height: 1.3; }
.star-btn {
  background: none; border: none; cursor: pointer;
  font-size: 14px; padding: 0 1px;
  font-family: Segoe UI, sans-serif; line-height: 1;
}
.row-btn {
  background: none; border: none; cursor: pointer;
  font-size: 12px; padding: 0 3px;
  font-family: Segoe UI, sans-serif; line-height: 1;
}
.pi-right { width: 58px; }
.new-tpl-row { padding: 8px 10px 14px; }
#btn-newtpl {
  width: 100%; font-size: 11px; font-weight: 700;
  padding: 6px 8px; cursor: pointer;
  font-family: Segoe UI, sans-serif;
  border-width: 1px; border-style: dashed;
}
/* Template editor modal */
#editor-overlay {
  display: none; position: absolute;
  top: 0; left: 0; width: 980px; height: 700px;
  z-index: 200;
  background: rgba(0,0,0,0.55);
}
#editor-box {
  position: absolute; top: 50%; left: 50%;
  width: 520px; margin-left: -260px; margin-top: -235px;
  border-width: 1px; border-style: solid;
  padding: 18px 20px;
}
#editor-title { font-size: 14px; font-weight: 700; margin-bottom: 14px; }
.ed-row { margin-bottom: 10px; }
.ed-cols { display: table; width: 100%; margin-bottom: 10px; }
.ed-col { display: table-cell; width: 50%; vertical-align: top; padding-right: 10px; }
.ed-col:last-child { padding-right: 0; }
#editor-box label { display: block; font-size: 10px; margin-bottom: 3px; }
#editor-box input, #editor-box select {
  width: 100%; font-size: 12px; padding: 5px 7px;
  font-family: Segoe UI, sans-serif; outline: none;
  border-width: 1px; border-style: solid;
}
#editor-btns { margin-top: 16px; text-align: right; }
#editor-btns button {
  font-size: 12px; font-weight: 700; padding: 6px 16px;
  cursor: pointer; font-family: Segoe UI, sans-serif;
  border-width: 1px; border-style: solid; margin-left: 8px;
  background: none;
}
#sidebar-footer {
  position: absolute; bottom: 0; left: 0;
  width: 240px; height: 40px;
  border-top-width: 1px; border-top-style: solid; padding: 6px 8px;
}
#sidebar-footer button {
  width: 100%; background: none; font-size: 11px; padding: 5px;
  cursor: pointer; font-family: Segoe UI, sans-serif;
  border-width: 1px; border-style: solid;
}

/* ── Main panel ── */
#main-panel {
  position: absolute;
  top: 0; left: 240px;
  width: 740px; height: 612px;
  overflow: hidden;
}
#dropzone {
  margin: 12px 12px 0;
  border-width: 2px; border-style: dashed;
  padding: 18px 20px; text-align: center;
}
#dz-title { font-size: 13px; font-weight: 600; margin-bottom: 4px; }
#dz-sub   { font-size: 11px; }
#dz-browse {
  margin-top: 8px; background: none; font-size: 11px; padding: 3px 14px;
  cursor: pointer; font-family: Segoe UI, sans-serif; display: inline-block;
  border-width: 1px; border-style: solid;
}

/* Output row */
#output-row { padding: 8px 12px 0; display: table; width: 100%; }
#output-row label { font-size: 10px; display: block; margin-bottom: 3px; }
#out-inner { display: table; width: 100%; }
#out-path-cell { display: table-cell; }
#out-path {
  display: block; width: 100%; font-size: 11px;
  font-family: Consolas, monospace; padding: 4px 8px;
  border-width: 1px; border-style: solid;
  white-space: nowrap; overflow: hidden;
}
#out-btn-cell { display: table-cell; width: 1px; white-space: nowrap; padding-left: 6px; }
#out-btn-cell button {
  background: none; font-size: 11px; padding: 4px 10px;
  cursor: pointer; font-family: Segoe UI, sans-serif;
  white-space: nowrap; margin-left: 4px;
  border-width: 1px; border-style: solid;
}

/* Queue */
#queue-wrap {
  position: absolute;
  /* Explicit height (not top+bottom) so the container is bounded in quirks
     mode — otherwise it grows to fit its content, overflows the panel and gets
     clipped with no scrollbar. 612 (panel) - 174 (top) = 438. */
  top: 174px; left: 0;
  width: 740px; height: 438px;
  margin: 0; padding: 0 12px;
  overflow-y: auto;
}
#queue-empty { text-align: center; padding: 30px 20px; font-size: 12px; }
#queue-empty div:first-child { font-size: 30px; margin-bottom: 6px; opacity: .4; }

.job-row {
  border-width: 1px; border-style: solid;
  margin-bottom: 5px; padding: 8px 10px;
}
.job-top { display:table; width:100%; }
.job-name-cell { display:table-cell; vertical-align:middle; overflow:hidden; }
.job-filename {
  font-size:12px; font-weight:600;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:360px;
}
.job-meta { font-size:10px; margin-top:2px; }
.job-right { display:table-cell; vertical-align:middle; text-align:right; white-space:nowrap; width:1px; }
.job-status {
  font-size:10px; font-weight:700; letter-spacing:.06em;
  text-transform:uppercase; padding:2px 7px;
  border-width:1px; border-style:solid;
}
.job-btns button {
  background:none; font-size:10px; padding:2px 8px; cursor:pointer;
  font-family:Segoe UI,sans-serif; margin-left:4px;
  border-width:1px; border-style:solid;
}
.job-progress { height:4px; margin-top:8px; display:none; overflow:hidden; }
.job-progress-bar { height:4px; width:0%; }
.job-timeline {
  display:none; margin-top:5px; height:18px; position:relative;
  border-width:1px; border-style:solid; overflow:hidden;
}
.job-timeline-fill { position:absolute; top:0; left:0; height:100%; width:0%; opacity:0.2; }
.job-timeline-label {
  position:absolute; top:0; left:0; right:0; bottom:0;
  font-family:Consolas,monospace; font-size:9px; font-weight:700;
  letter-spacing:.05em; text-align:center; line-height:18px;
}
.job-stats {
  display:none; margin-top:4px; font-family:Consolas,monospace; font-size:10px;
}
.job-log-btn {
  background:none; border:none; font-size:10px; cursor:pointer;
  font-family:Segoe UI,sans-serif; padding:0;
  text-decoration:underline; margin-top:4px; display:block;
}
.job-log {
  display:none; margin-top:6px; padding:6px 8px;
  font-family:Consolas,monospace; font-size:10px;
  max-height:90px; overflow-y:auto;
  white-space:pre-wrap; word-break:break-all;
  border-width:1px; border-style:solid;
}

/* Toolbar */
#toolbar {
  border-top-width:1px; border-top-style:solid;
  padding: 0 12px; display: table; width: 100%;
}
#toolbar-inner { display:table-row; }
#tally { display:table-cell; vertical-align:middle; font-size:11px; }
#toolbar-btns { display:table-cell; text-align:right; vertical-align:middle; white-space:nowrap; }
#toolbar-btns button {
  background:none; font-size:11px; padding:5px 12px; cursor:pointer;
  font-family:Segoe UI,sans-serif; margin-left:6px;
  border-width:1px; border-style:solid;
}
#btn-run { font-weight:700 !important; padding:5px 20px !important; }
#btn-run:disabled { cursor:default !important; opacity:0.38 !important; }
#btn-stop { display:none; }

/* Settings overlay */
#settings-panel {
  display: none; position: absolute;
  top: 42px; right: 0; width: 260px;
  max-height: 640px; overflow-y: auto;
  z-index: 100; padding: 14px;
  border-width: 1px; border-style: solid; border-top: none;
}
#settings-panel.open { display: block; }
#settings-panel h3 {
  font-size: 10px; font-weight: 700; letter-spacing: .1em;
  text-transform: uppercase; margin-bottom: 10px;
}
.theme-row { display:table; width:100%; margin-bottom:4px; border-collapse:separate; }
.theme-row td { display:table-cell; }
.theme-swatch {
  display: block; width: 100%; padding: 5px 4px;
  font-size: 10px; font-weight: 700; text-align: center;
  cursor: pointer; font-family: Segoe UI, sans-serif;
  border-width: 2px; border-style: solid; margin: 2px;
}
.settings-sep { border-top-width:1px; border-top-style:solid; margin: 10px 0 8px; }
.settings-panel-btn {
  display:block; width:100%; background:none; font-size:11px;
  padding:5px 8px; cursor:pointer; font-family:Segoe UI,sans-serif;
  text-align:left; margin-bottom:4px;
  border-width:1px; border-style:solid;
}
#ui-scale-row { display:table; width:100%; margin-top:2px; }
#ui-scale-row td { display:table-cell; vertical-align:middle; }
#ui-scale-label { font-size:10px; white-space:nowrap; padding-right:8px; }
.scale-btn {
  background:none; font-size:11px; font-weight:700; padding:3px 10px;
  cursor:pointer; font-family:Segoe UI,sans-serif;
  border-width:1px; border-style:solid; margin-left:4px;
}
.scale-btn.active { font-weight:900; }

/* ── ffprobe info strip ── */
.job-probe {
  font-family: Consolas, monospace; font-size: 10px;
  margin-top: 4px; white-space: nowrap; overflow: hidden;
  text-overflow: ellipsis;
}
.job-warn {
  font-size: 10px; font-weight: 700; margin-top: 4px;
  padding: 2px 6px; display: inline-block;
}
.job-estimate {
  font-family: Consolas, monospace; font-size: 10px;
  margin-top: 2px;
}

/* ── Inspect modal ── */
#inspect-overlay {
  display: none; position: absolute;
  top: 0; left: 0; width: 980px; height: 700px;
  z-index: 300;
  background: rgba(0,0,0,0.6);
}
#inspect-box {
  position: absolute; top: 50%; left: 50%;
  width: 580px; margin-left: -290px; margin-top: -260px;
  border-width: 1px; border-style: solid;
  padding: 16px 18px;
}
#inspect-title { font-size: 13px; font-weight: 700; margin-bottom: 10px; }
#inspect-body {
  font-family: Consolas, monospace; font-size: 10px;
  height: 400px; overflow-y: auto; white-space: pre-wrap;
  word-break: break-all; padding: 8px;
  border-width: 1px; border-style: solid;
}
#inspect-close {
  margin-top: 12px; float: right; font-size: 11px; font-weight: 700;
  padding: 5px 16px; cursor: pointer; font-family: Segoe UI, sans-serif;
  border-width: 1px; border-style: solid; background: none;
}

/* ── Preset suggestion badge ── */
.preset-match {
  display: inline-block; font-size: 9px; font-weight: 700;
  padding: 1px 5px; margin-left: 4px;
  vertical-align: middle; letter-spacing: .04em;
}

/* ── Per-job selection checkbox ── */
.job-check-cell { display:table-cell; vertical-align:middle; width:1px; white-space:nowrap; padding-right:8px; }
.job-check {
  display:inline-block; width:15px; height:15px; line-height:13px;
  text-align:center; font-size:11px; font-weight:700;
  border-width:1px; border-style:solid; cursor:pointer; box-sizing:border-box;
}

/* ── Apply-preset scope modal ── */
#apply-overlay {
  display: none; position: absolute;
  top: 0; left: 0; width: 980px; height: 700px;
  z-index: 320; background: rgba(0,0,0,0.6);
}
#apply-box {
  position: absolute; top: 50%; left: 50%;
  width: 420px; margin-left: -210px; margin-top: -90px;
  border-width: 1px; border-style: solid; padding: 16px 18px;
}
#apply-title { font-size: 13px; font-weight: 700; margin-bottom: 10px; }
#apply-body  { font-size: 12px; line-height: 1.5; }
#apply-btns  { margin-top: 16px; text-align: right; white-space: nowrap; }
#apply-btns button {
  font-size: 11px; font-weight: 700; padding: 5px 14px; margin-left: 8px;
  cursor: pointer; font-family: Segoe UI, sans-serif;
  border-width: 1px; border-style: solid; background: none;
}
#apply-btns button[disabled] { cursor: default; }
</style>
</head>
<body id="body">
<div id="app-root">

<div id="header">
  <table id="header-inner" width="100%"><tr>
    <td id="app-title"><span id="title-ff">Turbo </span><span id="title-batch">ffmpegger</span></td>
    <td id="header-mid"></td>
    <td id="header-btns">
      <button onclick="editPresets()" id="btn-editpresets">Edit presets.json</button>
      <button onclick="toggleSettings()" id="btn-settings">&#9881; Settings</button>
    </td>
  </tr></table>
</div>

<div id="settings-panel">
  <h3 id="settings-title">Colour Theme</h3>
  <table width="100%">
    <tr>
      <td><div class="theme-swatch" id="sw-amber"    onclick="applyTheme('amber')">Amber</div></td>
      <td><div class="theme-swatch" id="sw-blue"     onclick="applyTheme('blue')">Blue</div></td>
      <td><div class="theme-swatch" id="sw-green"    onclick="applyTheme('green')">Green</div></td>
    </tr>
    <tr>
      <td><div class="theme-swatch" id="sw-purple"   onclick="applyTheme('purple')">Purple</div></td>
      <td><div class="theme-swatch" id="sw-red"      onclick="applyTheme('red')">Red</div></td>
      <td><div class="theme-swatch" id="sw-light"    onclick="applyTheme('light')">Light</div></td>
    </tr>
    <tr>
      <td><div class="theme-swatch" id="sw-cyan"     onclick="applyTheme('cyan')">Cyan</div></td>
      <td><div class="theme-swatch" id="sw-rose"     onclick="applyTheme('rose')">Rose</div></td>
      <td><div class="theme-swatch" id="sw-slate"    onclick="applyTheme('slate')">Slate</div></td>
    </tr>
    <tr>
      <td><div class="theme-swatch" id="sw-sand"     onclick="applyTheme('sand')">Sand</div></td>
      <td><div class="theme-swatch" id="sw-mint"     onclick="applyTheme('mint')">Mint</div></td>
      <td><div class="theme-swatch" id="sw-midnight" onclick="applyTheme('midnight')">Night</div></td>
    </tr>
    <tr>
      <td><div class="theme-swatch" id="sw-paper"    onclick="applyTheme('paper')">Paper</div></td>
      <td><div class="theme-swatch" id="sw-sky"      onclick="applyTheme('sky')">Sky</div></td>
      <td><div class="theme-swatch" id="sw-sage"     onclick="applyTheme('sage')">Sage</div></td>
    </tr>
    <tr>
      <td><div class="theme-swatch" id="sw-hcdark"   onclick="applyTheme('hcdark')">HC Dark</div></td>
      <td><div class="theme-swatch" id="sw-hclight"  onclick="applyTheme('hclight')">HC Light</div></td>
      <td><div class="theme-swatch" id="sw-hcamber"  onclick="applyTheme('hcamber')">HC Amber</div></td>
    </tr>
  </table>
  <div class="settings-sep" id="settings-sep"></div>
  <h3 id="settings-scale-title">UI Scale</h3>
  <table id="ui-scale-row" width="100%"><tr>
    <td id="ui-scale-label">Zoom</td>
    <td style="text-align:right">
      <button class="scale-btn" id="scale-1x" onclick="applyScale(1)">1x</button>
      <button class="scale-btn" id="scale-1.5x" onclick="applyScale(1.5)">1.5x</button>
      <button class="scale-btn" id="scale-2x" onclick="applyScale(2)">2x</button>
    </td>
  </tr></table>
  <div class="settings-sep" id="settings-sep2"></div>
  <button class="settings-panel-btn" id="sp-editbtn"   onclick="editPresets()">Open presets.json</button>
  <button class="settings-panel-btn" id="sp-reloadbtn" onclick="reloadPresets()">&#8635; Reload presets</button>
</div>

<div id="body-wrap">
  <div id="sidebar">
    <div id="sidebar-top">
      <input type="text" id="search-box" placeholder="Filter presets (name, format, quality)..." onkeyup="filterPresets()" />
      <span id="fav-filter" onclick="toggleFavFilter()">&#9733; Favourites only</span>
      <span id="compat-filter" onclick="toggleCompatFilter()">&#10003; Compatible only</span>
    </div>
    <div id="preset-list"></div>
    <div id="sidebar-footer">
      <button id="btn-reload" onclick="reloadPresets()">&#8635; Reload presets</button>
    </div>
  </div>
  <div id="main-panel">
    <div id="dropzone"
      ondragenter="return dzEnter(event)" ondragover="return dzOver(event)"
      ondragleave="dzLeave(event)" ondrop="return dzDrop(event)">
      <div id="dz-title">&#8659; Drop files here</div>
      <div id="dz-sub">video &amp; audio files &mdash; or click Browse</div>
      <button id="dz-browse" onclick="browseFiles()">Browse files&hellip;</button>
      <input type="file" id="file-input" multiple
        style="position:absolute;left:-9999px;top:-9999px;opacity:0;"
        onchange="fileInputChanged()" />
    </div>
    <div id="output-row">
      <label id="out-label">Output folder</label>
      <div id="out-inner">
        <div id="out-path-cell">
          <div id="out-path">&mdash; output subfolder next to each input file &mdash;</div>
        </div>
        <div id="out-btn-cell">
          <button id="btn-pickout" onclick="pickOutputFolder()">Browse&hellip;</button>
          <button id="btn-resetout" style="display:none" onclick="resetOutput()">&times; Reset</button>
        </div>
      </div>
    </div>
    <div id="queue-wrap" onmousewheel="return queueWheel()">
      <div id="queue-empty">
        <div>&#127916;</div>
        <div id="empty-text">Drop files and pick a preset to get started</div>
      </div>
      <div id="job-list"></div>
    </div>
  </div>
</div>

<div id="toolbar">
  <table id="toolbar-inner" width="100%"><tr>
    <td id="tally">No jobs</td>
    <td id="toolbar-btns">
      <button id="btn-clear" onclick="clearDone()">Clear done</button>
      <button id="btn-stop"  onclick="stopAll()">&#9632; Stop all</button>
      <button id="btn-run"   disabled onclick="startQueue()">&#9654; Convert</button>
    </td>
  </tr></table>
</div>

<div id="editor-overlay">
  <div id="editor-box">
    <div id="editor-fields"></div>
    <div id="editor-btns">
      <button id="ed-cancel" onclick="closeEditor()">Cancel</button>
      <button id="ed-save"   onclick="saveEditor()">Save as custom template</button>
    </div>
  </div>
</div>
<div id="inspect-overlay">
  <div id="inspect-box">
    <div id="inspect-title"></div>
    <div id="inspect-body"></div>
    <button id="inspect-close" onclick="closeInspect()">Close</button>
    <div style="clear:both"></div>
  </div>
</div>
<div id="apply-overlay">
  <div id="apply-box">
    <div id="apply-title"></div>
    <div id="apply-body"></div>
    <div id="apply-btns">
      <button id="apply-cancel"   onclick="closeApplyModal()">Cancel</button>
      <button id="apply-selected" onclick="confirmApplySelected()">Only selected</button>
      <button id="apply-all"      onclick="confirmApplyAll()">Apply to all</button>
    </div>
    <div style="clear:both"></div>
  </div>
</div>

</div><!-- /app-root -->

<script language="JScript">
var fso    = new ActiveXObject("Scripting.FileSystemObject");
var wsh    = new ActiveXObject("WScript.Shell");
var wshell = new ActiveXObject("Shell.Application");

var presets        = [];
var customPresets  = [];
var selectedPreset = null;
var favourites     = {};
var jobs           = [];
var jobCounter     = 0;
var outputFolder   = "";
var running        = false;
var stopRequested  = false;
var showFavsOnly   = false;
var compatOnly     = true;
var editingId      = null;
var searchTerm     = "";
var currentTheme   = "amber";
var currentScale = 1;
var probeQueue = [];   // paths queued for probing
var probing    = false; // is a probe bat currently running?

// ── ffprobe integration ──────────────────────────────────

// Return the path to ffprobe.exe (same folder as ffmpeg.exe, or PATH).
function ffprobePath() {
  var local = appFolder() + "\\ffprobe.exe";
  if (fso.FileExists(local)) return '"' + local + '"';
  return "ffprobe";
}

// Queue a probe for a job.  Probes run one at a time to avoid
// spawning a flood of processes when many files are dropped at once.
function scheduleProbe(job) {
  probeQueue.push(job);
  if (!probing) runNextProbe();
}

function runNextProbe() {
  if (!probeQueue.length) { probing = false; return; }
  probing = true;
  var job = probeQueue.shift();
  // sequences: probe the first frame file so we at least get resolution/codec
  var probePath = job.isSequence ? probeSequenceFirstFrame(job) : job.inputPath;
  if (!probePath) { job.probe = { ok: false }; probing = false; runNextProbe(); return; }

  var tmp = wsh.ExpandEnvironmentStrings("%TEMP%") + "\\ffbatch_probe_" + job.id + ".txt";
  var bat = wsh.ExpandEnvironmentStrings("%TEMP%") + "\\ffbatch_probe_" + job.id + ".bat";
  var fp  = ffprobePath();
  // -v quiet -print_format json -show_streams -show_format
  var cmd = '@echo off\n' + fp + ' -v quiet -print_format json -show_streams -show_format -i "' + probePath + '" > "' + tmp + '" 2>&1\n';
  try {
    var bf = fso.CreateTextFile(bat, true, false);
    bf.Write(cmd); bf.Close();
    wsh.Run('"' + bat + '"', 0, false);
  } catch(e) {
    job.probe = { ok: false };
    try { fso.DeleteFile(bat); } catch(_) {}
    probing = false; runNextProbe(); return;
  }
  pollProbe(job, bat, tmp, 0);
}

function probeSequenceFirstFrame(job) {
  // job.inputPath is a pattern like C:\foo\frame_%04d.png
  // Reconstruct the actual first-frame filename from seqStart.
  try {
    var pat = job.inputPath;          // e.g.  C:\foo\frame_%04d.png
    var slash = pat.lastIndexOf("\\");
    var folder = pat.substring(0, slash);
    var namePat = pat.substring(slash + 1);
    // replace printf-style %0Nd or %d with the start number
    var start = job.seqStart || 0;
    var first = namePat.replace(/%0(\d+)d/, function(_, w) {
      var s = "" + start;
      while (s.length < parseInt(w)) s = "0" + s;
      return s;
    }).replace(/%d/, "" + start);
    var fp = folder + "\\" + first;
    if (fso.FileExists(fp)) return fp;
  } catch(_) {}
  return null;
}

function pollProbe(job, bat, tmp, ticks) {
  // wait up to 8 seconds (40 × 200 ms)
  if (ticks > 40) {
    job.probe = { ok: false };
    try { fso.DeleteFile(bat); } catch(_) {}
    try { fso.DeleteFile(tmp); } catch(_) {}
    probing = false; runNextProbe(); return;
  }
  var done = false;
  try {
    if (fso.FileExists(tmp)) {
      var sz = 0;
      try { sz = fso.GetFile(tmp).Size; } catch(_) {}
      if (sz > 0) {
        // ffprobe writes its full JSON then exits, so once the file has
        // content and is no longer growing we can read it.
        done = true;
        var rf = fso.OpenTextFile(tmp, 1, false);
        var raw = rf.ReadAll(); rf.Close();
        job.probe = parseProbeJson(raw, job);
        // Pre-populate duration for the progress bar
        if (job.probe.duration > 0 && !job.totalSec) {
          job.totalSec = job.probe.duration;
        }
        renderJobs(); updateRunButton();
        try { fso.DeleteFile(tmp); } catch(_) {}
        try { fso.DeleteFile(bat); } catch(_) {}
      }
    }
  } catch(e) {
    job.probe = { ok: false };
    done = true;
  }
  if (done) {
    probing = false; runNextProbe();
  } else {
    window.setTimeout(function(){ pollProbe(job, bat, tmp, ticks + 1); }, 200);
  }
}

// Parse ffprobe's JSON output into a simple object.
// We do not use JSON.parse (not available in IE/JScript) — we use the same
// Function() trick as everywhere else in the app.
function parseProbeJson(raw, job) {
  var info = { ok: false, width: 0, height: 0, fps: 0, duration: 0,
               vcodec: "", acodec: "", bitrate: 0, channels: 0,
               sampleRate: 0, colorSpace: "", pixFmt: "",
               hasVideo: false, hasAudio: false, rawJson: raw };
  try {
    // IE JScript doesn't have JSON.parse; use Function() eval
    var data = (new Function("return " + raw.replace(/\btrue\b/g,"true").replace(/\bfalse\b/g,"false").replace(/\bnull\b/g,"null")))();
    if (!data) return info;
    info.ok = true;
    // format-level info
    if (data.format) {
      if (data.format.duration) info.duration = parseFloat(data.format.duration) || 0;
      if (data.format.bit_rate) info.bitrate   = parseInt(data.format.bit_rate, 10) || 0;
    }
    // streams
    var streams = data.streams || [];
    for (var i = 0; i < streams.length; i++) {
      var s = streams[i];
      if (s.codec_type === "video" && !info.hasVideo) {
        info.hasVideo    = true;
        info.vcodec      = s.codec_name || "";
        info.width       = s.width  || 0;
        info.height      = s.height || 0;
        info.colorSpace  = s.color_space || "";
        info.pixFmt      = s.pix_fmt || "";
        // fps: try avg_frame_rate first, then r_frame_rate
        var fpsStr = s.avg_frame_rate || s.r_frame_rate || "";
        if (fpsStr && fpsStr.indexOf("/") >= 0) {
          var parts = fpsStr.split("/");
          var n = parseFloat(parts[0]), d = parseFloat(parts[1]);
          if (d > 0) info.fps = Math.round((n / d) * 100) / 100;
        } else if (fpsStr) {
          info.fps = parseFloat(fpsStr) || 0;
        }
        // duration fallback from stream if format didn't have it
        if (!info.duration && s.duration) info.duration = parseFloat(s.duration) || 0;
        // bitrate fallback
        if (!info.bitrate && s.bit_rate) info.bitrate = parseInt(s.bit_rate, 10) || 0;
      }
      if (s.codec_type === "audio" && !info.hasAudio) {
        info.hasAudio    = true;
        info.acodec      = s.codec_name || "";
        info.channels    = s.channels   || 0;
        info.sampleRate  = parseInt(s.sample_rate, 10) || 0;
      }
    }
  } catch(e) { info.ok = false; info.rawJson = raw + "\n\nPARSE ERROR: " + e.message; }
  return info;
}

// ── Pre-flight warnings ──────────────────────────────────
// Return a warning string (or "") for a job+preset combination.
function probeWarning(job, preset) {
  if (!job.probe || !job.probe.ok) return "";
  var p = job.probe;
  var warnings = [];
  // Video preset applied to audio-only file
  if (!p.hasVideo && preset && preset.args && !/^-vn/i.test(preset.args)) {
    var hasVCodec = /-c:v|libx264|libx265|prores|dnxhd|libvpx/i.test(preset.args);
    if (hasVCodec) warnings.push("No video stream — video preset may fail");
  }
  // Audio-only preset applied to video file (usually fine, just flag)
  // Mismatch: target preset has a fixed scale but source is already smaller
  if (p.hasVideo && preset) {
    var scaleM = preset.args.match(/-vf\s+scale=(\d+):(\d+)/);
    if (scaleM) {
      var tw = parseInt(scaleM[1]), th = parseInt(scaleM[2]);
      if (tw > 0 && th > 0 && p.width > 0 && p.height > 0) {
        if (tw > p.width * 1.5 || th > p.height * 1.5) {
          warnings.push("Upscaling " + p.width + "\xd7" + p.height + " \u2192 " + tw + "\xd7" + th);
        }
      }
    }
  }
  // Very high fps source being forced to a low-fps preset
  if (p.fps > 60 && preset && /fps=\d+|r\s+\d+|-r\s+\d+/.test(preset.args)) {
    warnings.push("High-fps source (" + p.fps + "fps) with fps-capped preset");
  }
  return warnings.join("  \u25aa  ");
}

// ── Output size estimator ────────────────────────────────
// Estimate output file size from preset args + probed duration.
// Returns a human-readable string, or "" if we can't estimate.
function estimateOutputSize(job, preset) {
  if (!job.probe || !job.probe.ok || !job.probe.duration) return "";
  if (!preset || !preset.args) return "";
  var dur = job.probe.duration;   // seconds
  var kbps = 0;

  // Audio-only presets: sum audio bitrate
  if (/^-vn/.test(preset.args) || /\bfla c\b/.test(preset.args)) {
    var abrM = preset.args.match(/-b:a\s+([\d.]+)\s*([kKmM]?)/);
    if (abrM) {
      kbps = parseFloat(abrM[1]);
      var u = abrM[2].toLowerCase();
      if (u === "m") kbps *= 1000;
      // default unit is kbits/s
    }
  } else {
    // CRF encoding: estimate from codec + CRF value
    var crfM = preset.args.match(/-crf\s+(\d+)/);
    var abrM2 = preset.args.match(/-b:a\s+([\d.]+)\s*([kKmM]?)/);
    var aBitrateKbps = 128; // default audio
    if (abrM2) {
      aBitrateKbps = parseFloat(abrM2[1]);
      if ((abrM2[2]||"").toLowerCase() === "m") aBitrateKbps *= 1000;
    }
    // Very rough CRF→bitrate heuristic based on codec and resolution
    if (crfM) {
      var crf = parseInt(crfM[1]);
      var pixels = (job.probe.width || 1920) * (job.probe.height || 1080);
      var isH265 = /libx265|hevc/i.test(preset.args);
      var isVP9  = /libvpx-vp9/i.test(preset.args);
      // Base kbps at CRF 20 for 1080p H.264 ≈ 4000 kbps
      // Scale by resolution and CRF offset
      var basePx = 1920 * 1080;
      var baseKbps = isH265 ? 2000 : (isVP9 ? 1800 : 4000);
      var resScale = pixels / basePx;
      // Each CRF unit ≈ 12% bitrate change (empirical)
      var crfOffset = Math.pow(1.12, 20 - crf);
      kbps = baseKbps * resScale * crfOffset + aBitrateKbps;
    }
    // Fixed bitrate (-b:v): use that directly
    var bvM = preset.args.match(/-b:v\s+([\d.]+)\s*([kKmMgG]?)/);
    if (bvM) {
      kbps = parseFloat(bvM[1]);
      var bvU = (bvM[2]||"").toLowerCase();
      if (bvU === "m") kbps *= 1000;
      else if (bvU === "g") kbps *= 1000000;
      var aBr2M = preset.args.match(/-b:a\s+([\d.]+)\s*([kKmM]?)/);
      var abr2 = 128;
      if (aBr2M) { abr2 = parseFloat(aBr2M[1]); if ((aBr2M[2]||"").toLowerCase()==="m") abr2*=1000; }
      kbps += abr2;
    }
    // ProRes / DNxHD / lossless: use known typical bitrates
    if (/prores_ks.*profile.*3|prores.*hq/i.test(preset.args) || /-profile:v\s+3/.test(preset.args)) kbps = 220000;
    else if (/prores_ks.*profile.*2|prores_ks/i.test(preset.args)) kbps = 120000;
    else if (/prores_ks.*profile.*0/i.test(preset.args)) kbps = 45000;
    else if (/dnxhd/i.test(preset.args)) kbps = 120000;
    else if (/pcm_s16le|pcm_s24le|flac/i.test(preset.args) && !job.probe.hasVideo) kbps = (job.probe.sampleRate||48000) * (job.probe.channels||2) * 16 / 1000;
  }

  if (kbps <= 0) return "";
  var bytes = (kbps * 1000 / 8) * dur;
  return "\u2248 " + fmtBytes(bytes) + " estimated output";
}

// ── Preset suggestion scoring ────────────────────────────
// Returns a score 0-100 for how well a preset matches probed info.
// Higher = better match.  Used to show "match" badges on top presets.
var probeMatchScores = {};   // presetId -> score; refreshed when probe completes

function scorePresetForProbe(preset, probe) {
  if (!probe || !probe.ok) return 0;
  var score = 0;
  // Resolution match: exact or very close
  if (probe.hasVideo && probe.width > 0 && probe.height > 0) {
    var scaleM = preset.args ? preset.args.match(/-vf\s+scale=(\d+):(\d+)/) : null;
    if (scaleM) {
      var pw = parseInt(scaleM[1]), ph = parseInt(scaleM[2]);
      var diffW = Math.abs(pw - probe.width), diffH = Math.abs(ph - probe.height);
      if (diffW === 0 && diffH === 0) score += 40;
      else if (diffW <= 4 && diffH <= 4) score += 35;
      else if (diffW < probe.width * 0.1) score += 15;
      // Slight bonus for downscaling (common workflow)
      if (pw <= probe.width && ph <= probe.height) score += 5;
    } else {
      // "keep size" preset — good match if source doesn't need resizing
      score += 20;
    }
  }
  // Codec affinity
  if (probe.hasVideo) {
    var vc = probe.vcodec ? probe.vcodec.toLowerCase() : "";
    var pa = (preset.args || "").toLowerCase();
    // H.264 source → H.264 or H.265 output are natural choices
    if ((vc === "h264" || vc === "avc") && /libx264|libx265/.test(pa)) score += 15;
    // ProRes source → ProRes output
    if (vc === "prores" && /prores_ks/.test(pa)) score += 25;
    // Already compressed → "keep size" is a natural option
    if ((vc === "h264" || vc === "hevc") && !/-vf\s+scale/.test(pa)) score += 8;
  }
  // Audio-only preset for audio-only file
  if (!probe.hasVideo && /^-vn/.test(preset.args || "")) score += 50;
  // Image sequence file → Image Sequence presets
  return score;
}

function refreshMatchScores(jobs) {
  // Find the dominant probe (first probed job with ok=true)
  var probe = null;
  for (var i = 0; i < jobs.length; i++) {
    if (jobs[i].probe && jobs[i].probe.ok) { probe = jobs[i].probe; break; }
  }
  probeMatchScores = {};
  if (!probe) return;
  var src = allPresets();
  // Score every preset and keep only the top 3 non-zero
  var scored = [];
  for (var j = 0; j < src.length; j++) {
    var sc = scorePresetForProbe(src[j], probe);
    if (sc > 0) scored.push({ id: src[j].id, score: sc });
  }
  scored.sort(function(a,b){ return b.score - a.score; });
  var topN = Math.min(3, scored.length);
  for (var k = 0; k < topN; k++) {
    if (scored[k].score >= 20) probeMatchScores[scored[k].id] = scored[k].score;
  }
}

// ── Inspect modal ────────────────────────────────────────
function openInspect(jobId) {
  var job = null;
  for (var i = 0; i < jobs.length; i++) { if (jobs[i].id === jobId) { job = jobs[i]; break; } }
  if (!job) return;
  var t = getT();
  var ov = document.getElementById("inspect-overlay");
  var box = document.getElementById("inspect-box");
  var title = document.getElementById("inspect-title");
  var body  = document.getElementById("inspect-body");
  if (!ov) return;

  var displayTitle = job.filename + (job.probe && job.probe.ok ? "" : " — probe unavailable");
  title.innerText = displayTitle;
  title.style.color = t.ac;
  box.style.background   = t.surf;
  box.style.borderColor  = t.bordHi;
  box.style.color        = t.text;
  body.style.background  = t.logBg;
  body.style.borderColor = t.bord;
  body.style.color       = t.muted;

  var closeBtn = document.getElementById("inspect-close");
  if (closeBtn) {
    closeBtn.style.borderColor = t.bord;
    closeBtn.style.color       = t.muted;
  }

  if (!job.probe) {
    body.innerText = "Probe has not run yet. ffprobe.exe must be in the same folder as ffmpeg.exe.";
  } else if (!job.probe.ok) {
    body.innerText = job.probe.rawJson || "ffprobe could not read this file.\n\nMake sure ffprobe.exe is present next to ffmpeg.exe.";
  } else {
    // Pretty-print: summary block first, then full JSON
    var p = job.probe;
    var lines = [];
    lines.push("=== SUMMARY ===");
    if (p.hasVideo) {
      lines.push("Video : " + p.vcodec + "  " + p.width + "\xd7" + p.height
        + "  " + p.fps + " fps"
        + (p.colorSpace ? "  " + p.colorSpace : "")
        + (p.pixFmt     ? "  (" + p.pixFmt + ")" : ""));
    }
    if (p.hasAudio) {
      lines.push("Audio : " + p.acodec
        + (p.sampleRate ? "  " + Math.round(p.sampleRate/1000) + " kHz" : "")
        + (p.channels   ? "  " + p.channels + "ch" : ""));
    }
    if (p.duration) lines.push("Duration : " + fmtSec(p.duration));
    if (p.bitrate)  lines.push("Bitrate  : " + fmtBytes(p.bitrate / 8) + "/s  (" + Math.round(p.bitrate / 1000) + " kbps)");
    var srcSize = 0;
    try { if (fso.FileExists(job.inputPath) || job.isSequence) {
      if (!job.isSequence) srcSize = fso.GetFile(job.inputPath).Size;
    } } catch(_) {}
    if (srcSize) lines.push("File size: " + fmtBytes(srcSize));
    lines.push("");
    lines.push("=== FULL FFPROBE JSON ===");
    lines.push(p.rawJson || "(no data)");
    body.innerText = lines.join("\n");
  }

  ov.style.display = "block";
}

function closeInspect() {
  var ov = document.getElementById("inspect-overlay");
  if (ov) ov.style.display = "none";
}

// ── FPS hint for image sequences ─────────────────────────
// Return a note string if the selected preset lacks explicit fps for a sequence.
function seqFpsHint(job, preset) {
  if (!job.isSequence) return "";
  if (!preset) return "";
  var ia = preset.inputArgs || "";
  var a  = preset.args || "";
  var hasRate = (/-r\s+\d+|-framerate\s+\d+/i.test(ia) || /-r\s+\d+/i.test(a));
  if (hasRate) return "";
  // Count frames if available
  var frameNote = job.seqCount ? "  (" + job.seqCount + " frames)" : "";
  return "Seq preset has no explicit fps \u2014 will default to 30fps" + frameNote;
}


